@page "{id:int}"
@model TINWeb.Pages.Survey.DetailsModel
@{
    ViewData["Title"] = "Survey Details";
}

<div class="container mt-4">
    <h1>Survey Details</h1>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.Record.Id</dd>

        <dt class="col-sm-3">Financial Year</dt>
        <dd class="col-sm-9">@Model.Record.FinancialYear</dd>

        <dt class="col-sm-3">Current Survey</dt>
        <dd class="col-sm-9">@(Model.Record.CurrentSurvey ? "Yes" : "No")</dd>

        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Record.Title) ? "Survey Answers" : Model.Record.Title)</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(Model.Record.Description) ? "Please complete the survey answers for the current survey year." : Model.Record.Description)</dd>
    </dl>

    <a asp-page="./Edit" asp-route-id="@Model.Record.Id" class="btn btn-warning">Edit</a>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
</div>
