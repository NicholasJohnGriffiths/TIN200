@page "{id:int}"
@model TINWeb.Pages.Survey.EditModel
@{
    ViewData["Title"] = "Edit Survey";
}

<div class="container mt-4">
    <h1>Edit Survey</h1>
    <hr />

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-info" role="alert">@Model.StatusMessage</div>
    }

    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Record.Id" />

        <div class="form-group mb-3">
            <label asp-for="Record.FinancialYear" class="form-label"></label>
            <input asp-for="Record.FinancialYear" class="form-control" />
            <span asp-validation-for="Record.FinancialYear" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="Record.CurrentSurvey" class="form-check-input" />
            <label asp-for="Record.CurrentSurvey" class="form-check-label"></label>
            <span asp-validation-for="Record.CurrentSurvey" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Record.Title" class="form-label"></label>
            <input asp-for="Record.Title" class="form-control" />
            <span asp-validation-for="Record.Title" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Record.Description" class="form-label"></label>
            <textarea asp-for="Record.Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Record.Description" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Record.HeaderImageId" class="form-label"></label>
            <select asp-for="Record.HeaderImageId" asp-items="Model.HeaderImageOptions" class="form-select"></select>
            <span asp-validation-for="Record.HeaderImageId" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="HeaderImageFile" class="form-label">Upload New Header Image</label>
            <input asp-for="HeaderImageFile" type="file" class="form-control" accept="image/*" />
            <div class="form-text">If a file is uploaded, it will be saved and selected as the survey header image.</div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.HeaderImageThumbnailUrl))
        {
            <div class="form-group mb-3">
                <label class="form-label">Current Header Image</label>
                <div class="border rounded p-2 bg-light">
                    @if (!string.IsNullOrWhiteSpace(Model.HeaderImageFileName))
                    {
                        <div><strong>Name:</strong> @Model.HeaderImageFileName</div>
                    }
                    <div class="mt-2">
                        <img src="@Model.HeaderImageThumbnailUrl" alt="Survey header image thumbnail" class="img-thumbnail" style="max-width: 270px; max-height: 180px;" />
                    </div>
                </div>
            </div>
        }
        else if (Model.HeaderImageMissing)
        {
            <div class="form-group mb-3">
                <label class="form-label">Current Header Image</label>
                <div class="alert alert-warning mb-0" role="alert">
                    <div class="fw-semibold">Missing file</div>
                    @if (!string.IsNullOrWhiteSpace(Model.HeaderImageFileName))
                    {
                        <div class="small">Name: @Model.HeaderImageFileName</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.HeaderImageMissingMessage))
                    {
                        <div class="small">@Model.HeaderImageMissingMessage</div>
                    }
                </div>
            </div>
        }

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </form>

    <hr class="my-4" />

    <div class="card">
        <div class="card-body">
            <h2 class="h5 mb-3">Missing CompanySurvey Records</h2>

            @if (Model.LatestSurveyYear <= 0)
            {
                <div class="alert alert-warning mb-0" role="alert">
                    No survey year is available yet. Create a survey first.
                </div>
            }
            else
            {
                <p class="mb-2">
                    Latest survey year: <strong>@Model.LatestSurveyYear</strong>.
                    Preview below shows companies that do not have a CompanySurvey row for year <strong>@Model.BatchSurveyYear</strong>.
                </p>

                @if (Model.MissingCompanySurveyRows.Count == 0)
                {
                    <div class="alert alert-success mb-0" role="alert">
                        All companies already have a CompanySurvey record for year @Model.BatchSurveyYear.
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        Found <strong>@Model.MissingCompanySurveyRows.Count</strong> companies missing CompanySurvey for year @Model.BatchSurveyYear (preview limit 250).
                    </div>

                    <form method="post" asp-page-handler="BatchCreateMissingCompanySurveys">
                        <input type="hidden" asp-for="Record.Id" />

                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-sm-4 col-md-3">
                                <label asp-for="BatchSurveyYear" class="form-label">Survey Year</label>
                                <input asp-for="BatchSurveyYear" class="form-control" />
                                <span asp-validation-for="BatchSurveyYear" class="text-danger"></span>
                            </div>
                            <div class="col-sm-8 col-md-9">
                                <button type="submit" class="btn btn-primary">Create CompanySurvey For Selected</button>
                            </div>
                        </div>

                        <div class="mb-2">
                            <button type="button" id="selectAllMissingCompanies" class="btn btn-sm btn-outline-secondary">Select all</button>
                            <button type="button" id="clearAllMissingCompanies" class="btn btn-sm btn-outline-secondary">Clear all</button>
                        </div>

                        <div class="table-responsive" style="max-height: 440px;">
                            <table class="table table-sm table-striped align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 70px;">Select</th>
                                        <th style="width: 100px;">ID</th>
                                        <th>Company</th>
                                        <th style="width: 180px;">External ID</th>
                                        <th>Contact Email</th>
                                        <th>Email</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var company in Model.MissingCompanySurveyRows)
                                    {
                                        <tr>
                                            <td>
                                                <input class="form-check-input missing-company-checkbox" type="checkbox" name="SelectedCompanyIds" value="@company.CompanyId" />
                                            </td>
                                            <td>@company.CompanyId</td>
                                            <td>@(company.CompanyName ?? "(No name)")</td>
                                            <td>@company.ExternalId</td>
                                            <td>@company.ContactEmail</td>
                                            <td>@company.Email</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </form>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        (function () {
            var selectAllButton = document.getElementById('selectAllMissingCompanies');
            var clearAllButton = document.getElementById('clearAllMissingCompanies');

            if (!selectAllButton || !clearAllButton) {
                return;
            }

            function setCheckedState(value) {
                document.querySelectorAll('.missing-company-checkbox').forEach(function (checkbox) {
                    checkbox.checked = value;
                });
            }

            selectAllButton.addEventListener('click', function () {
                setCheckedState(true);
            });

            clearAllButton.addEventListener('click', function () {
                setCheckedState(false);
            });
        })();
    </script>
}
