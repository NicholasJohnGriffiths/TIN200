@page
@model TINWeb.Pages.Survey.EmailEventsModel
@{
    ViewData["Title"] = "Email Events";
}

<div class="container mt-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
        <div>
            <h1 class="mb-1">Email Events</h1>
            <div class="text-muted small">Azure email delivery events for survey communications.</div>
            <div class="text-muted small">Default range is the last month.</div>
        </div>
        <form method="get" class="d-flex align-items-end gap-2 flex-wrap">
            <div>
                <label asp-for="StartDate" class="form-label mb-1">From</label>
                <input asp-for="StartDate" type="date" class="form-control" value="@Model.EffectiveStartDate.ToString("yyyy-MM-dd")" />
            </div>
            <div>
                <label asp-for="EndDate" class="form-label mb-1">To</label>
                <input asp-for="EndDate" type="date" class="form-control" value="@Model.EffectiveEndDate.ToString("yyyy-MM-dd")" />
            </div>
            <div>
                <label asp-for="EventStatus" class="form-label mb-1">Status</label>
                <select asp-for="EventStatus" class="form-select" style="min-width: 180px;">
                    <option value="all" selected="@(Model.EffectiveEventStatus == "all" ? "selected" : null)">All Emails</option>
                    <option value="successful" selected="@(Model.EffectiveEventStatus == "successful" ? "selected" : null)">Successful Emails</option>
                    <option value="unsuccessful" selected="@(Model.EffectiveEventStatus == "unsuccessful" ? "selected" : null)">Unsuccessful Emails</option>
                </select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Apply</button>
                <a asp-page="./EmailEvents" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>

    @if (!Model.IsConfigured)
    {
        <div class="alert alert-warning mb-3">
            Email events query is disabled. Enable and configure the <strong>EmailEvents</strong> section in application settings.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.InfoMessage))
    {
        <div class="alert alert-info">@Model.InfoMessage</div>
    }

    @if (Model.Events.Any())
    {
        <div class="mb-2 text-muted small">
            <span class="badge text-bg-primary me-2">Azure</span>
            Azure delivery telemetry
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>Source</th>
                        <th>Timestamp (UTC)</th>
                        <th>Event Type</th>
                        <th>Recipient</th>
                        <th>Subject</th>
                        <th>Message ID</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Events)
                    {
                        var isBounced = EmailEventsModel.IsAzureBouncedEvent(row);
                        <tr class="@(isBounced ? "table-danger" : string.Empty)">
                            <td><span class="badge text-bg-primary">Azure</span></td>
                            <td>@(row.TimestampUtc?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td>
                            <td>
                                <span class="@(isBounced ? "text-danger fw-semibold" : string.Empty)">@(string.IsNullOrWhiteSpace(row.EventType) ? "-" : row.EventType)</span>
                                @if (isBounced)
                                {
                                    <span class="badge text-bg-danger ms-2">Bounced</span>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(row.Recipient) ? "-" : row.Recipient)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Subject) ? "-" : row.Subject)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.MessageId) ? "-" : row.MessageId)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Details) ? "-" : row.Details)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (!Model.Events.Any() && !Model.LocalEvents.Any() && string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-info">No email events found for the selected period.</div>
    }

    @if (Model.LocalEvents.Any())
    {
        <div class="mt-4 mb-2">
            <h2 class="h5 mb-1">
                Recorded Send History
                <span class="badge text-bg-warning ms-2">Database</span>
            </h2>
            <div class="text-muted small">These rows come from the app's local send notes and appear immediately, even when Azure diagnostics have not arrived yet.</div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-warning">
                    <tr>
                        <th>Source</th>
                        <th>Timestamp (Local)</th>
                        <th>Company</th>
                        <th>Event Type</th>
                        <th>Recipient</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.LocalEvents)
                    {
                        <tr>
                            <td><span class="badge text-bg-warning">Database</span></td>
                            <td>@row.TimestampLocal.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.CompanyName) ? "-" : row.CompanyName)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.EventType) ? "-" : row.EventType)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Recipient) ? "-" : row.Recipient)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Details) ? "-" : row.Details)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>