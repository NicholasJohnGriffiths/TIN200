@page "{id:int}"
@model TINWeb.Pages.Tasks.DeleteModel
@{
    ViewData["Title"] = "Archive Task";
}

<div class="container mt-4">
    <h1>Archive Task</h1>
    <hr />

    <div class="alert alert-warning">
        This will mark the task as <strong>Archived</strong> instead of deleting it.
    </div>

    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Record.Title</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Record.Status</dd>

        <dt class="col-sm-3">Created</dt>
        <dd class="col-sm-9">@Model.Record.CreatedDatetime?.ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Record.Id" />
        <button type="submit" class="btn btn-danger">Archive</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
