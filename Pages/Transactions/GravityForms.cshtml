@page
@model TINWeb.Pages.Transactions.GravityFormsModel
@{
    ViewData["Title"] = "Website Orders";

    static string Truncate(string? value, int max = 50)
    {
        if (string.IsNullOrEmpty(value))
        {
            return string.Empty;
        }

        return value.Length <= max ? value : value[..max] + "...";
    }

    static string FormatDate(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "--";
        }

        if (DateTime.TryParse(
            value,
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.AssumeLocal,
            out var parsed))
        {
            return parsed.ToString("yyyy-MM-dd HH:mm:ss");
        }

        return value;
    }
}

<div class="container mt-4">
    <div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2">
        <h1 class="mb-1">Website Orders</h1>
        <div class="text-muted small">Gravity Forms from <strong>tin100.com</strong> — click a form title to view its entries.</div>
        <div class="d-flex align-items-center gap-2 ms-md-3">
            <span class="small text-muted">Show:</span>
            <div class="btn-group btn-group-sm" role="group" aria-label="Order status filter">
                <a asp-page="./GravityForms"
                   asp-route-statusFilter="all"
                   class="btn @(string.Equals(Model.StatusFilter, "all", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-primary")">All</a>
                <a asp-page="./GravityForms"
                   asp-route-statusFilter="active"
                   class="btn @(string.Equals(Model.StatusFilter, "active", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-primary")">Active</a>
                <a asp-page="./GravityForms"
                   asp-route-statusFilter="inactive"
                   class="btn @(string.Equals(Model.StatusFilter, "inactive", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-primary")">Inactive</a>
            </div>
        </div>
    </div>

    <div class="mb-3 small text-muted">
        Forms found totals: <strong>All @Model.AllFormsCount</strong> | <strong>Active @Model.ActiveFormsCount</strong> | <strong>Inactive @Model.InactiveFormsCount</strong>
    </div>

    <div class="mb-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        <div class="small text-muted">
            Showing @Model.Forms.Count of @Model.FilteredFormsCount forms
            (page @Model.EffectivePageNumber of @Model.TotalPages)
        </div>
        <form method="get" class="d-flex align-items-center gap-2">
            <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
            <label for="pageSize" class="small text-muted m-0">Rows:</label>
            <select id="pageSize" name="PageSize" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="10" selected="@(Model.EffectivePageSize == 10 ? "selected" : null)">10</option>
                <option value="25" selected="@(Model.EffectivePageSize == 25 ? "selected" : null)">25</option>
                <option value="50" selected="@(Model.EffectivePageSize == 50 ? "selected" : null)">50</option>
                <option value="100" selected="@(Model.EffectivePageSize == 100 ? "selected" : null)">100</option>
            </select>
            <input type="hidden" name="PageNumber" value="1" />
        </form>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    else if (!Model.Forms.Any())
    {
        <div class="alert alert-info">No forms found.</div>
    }
    else
    {
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Form Title</th>
                    <th>Status</th>
                    <th>Form Created Date</th>
                    <th class="text-end">Entries</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var form in Model.Forms)
                {
                    var fullTitle = form.Title ?? string.Empty;
                    var fullDate = FormatDate(form.DateCreated);
                    var activeState = form.IsActive == true ? "true" : (form.IsActive == false ? "false" : "unknown");
                    <tr data-is-active="@activeState">
                        <td class="text-muted small">@form.Id</td>
                        <td>
                            <a asp-page="./GravityFormEntries" asp-route-formId="@form.Id" class="fw-semibold text-decoration-none" title="@fullTitle">
                                @Truncate(fullTitle)
                            </a>
                        </td>
                        <td>
                            @if (form.IsActive == true)
                            {
                                <span class="badge text-bg-success">Active</span>
                            }
                            else if (form.IsActive == false)
                            {
                                <span class="badge text-bg-secondary">Inactive</span>
                            }
                            else
                            {
                                <span class="text-muted small">--</span>
                            }
                        </td>
                        <td class="text-muted small js-truncatable" title="@fullDate" data-short="@Truncate(fullDate)" data-full="@fullDate">
                            @Truncate(fullDate)
                        </td>
                        <td class="text-end">
                            @if (form.HasEntryCount)
                            {
                                <span class="badge text-bg-secondary">@form.EntryCount</span>
                            }
                            else
                            {
                                <span class="text-muted small">--</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Website Orders pagination" class="mt-3">
                <ul class="pagination pagination-sm flex-wrap">
                    <li class="page-item @(Model.EffectivePageNumber <= 1 ? "disabled" : null)">
                        <a class="page-link"
                           asp-page="./GravityForms"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-pageSize="@Model.EffectivePageSize"
                           asp-route-pageNumber="@(Model.EffectivePageNumber - 1)">Previous</a>
                    </li>

                    @for (var p = Math.Max(1, Model.EffectivePageNumber - 2); p <= Math.Min(Model.TotalPages, Model.EffectivePageNumber + 2); p++)
                    {
                        <li class="page-item @(p == Model.EffectivePageNumber ? "active" : null)">
                            <a class="page-link"
                               asp-page="./GravityForms"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-pageSize="@Model.EffectivePageSize"
                               asp-route-pageNumber="@p">@p</a>
                        </li>
                    }

                    <li class="page-item @(Model.EffectivePageNumber >= Model.TotalPages ? "disabled" : null)">
                        <a class="page-link"
                           asp-page="./GravityForms"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-pageSize="@Model.EffectivePageSize"
                           asp-route-pageNumber="@(Model.EffectivePageNumber + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
