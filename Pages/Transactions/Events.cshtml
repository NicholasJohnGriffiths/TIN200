@page
@model TINWeb.Pages.Transactions.EventsModel
@{
    ViewData["Title"] = "Transaction Events";
}

<div class="container mt-4">
    <div class="row mb-3 align-items-end">
        <div class="col-md-6">
            <h1 class="mb-0">Transaction Events</h1>
            <div class="text-muted small">Latest Stripe balance transactions (up to 100 records).</div>
        </div>
        <div class="col-md-6">
            <form method="get" class="d-flex justify-content-md-end align-items-end gap-2 flex-wrap">
                <div>
                    <label asp-for="Description" class="form-label mb-1">Description</label>
                    <select asp-for="Description" class="form-select">
                        <option value="">All descriptions</option>
                        @foreach (var option in Model.DescriptionOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>
                <div>
                    <button type="submit" class="btn btn-primary">Apply</button>
                    <a asp-page="./Events" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    else if (Model.Transactions.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Created (UTC)</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th>Amount (minor)</th>
                        <th>Fee (minor)</th>
                        <th>Net (minor)</th>
                        <th>Currency</th>
                        <th>Status</th>
                        <th>Source</th>
                        <th>Stripe ID</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Transactions)
                    {
                        <tr>
                            <td>@row.Created.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@row.Type</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Description) ? "-" : row.Description)</td>
                            <td>@row.Amount</td>
                            <td>@row.Fee</td>
                            <td>@row.Net</td>
                            <td>@(row.Currency?.ToUpperInvariant())</td>
                            <td>@row.Status</td>
                            <td>@(string.IsNullOrWhiteSpace(row.SourceId) ? "-" : row.SourceId)</td>
                            <td><span class="font-monospace">@row.Id</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No Stripe transactions found for the selected filter.</div>
    }
</div>