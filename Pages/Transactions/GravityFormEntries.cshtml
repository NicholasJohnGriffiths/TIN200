@page
@model TINWeb.Pages.Transactions.GravityFormEntriesModel
@{
    ViewData["Title"] = Model.FormDetail != null ? $"Entries: {Model.FormDetail.Title}" : "Form Entries";
    var fields = Model.FormDetail?.Fields ?? new List<TINWeb.Services.GravityFormField>();
    // Build a lookup: field id -> label for display
    var fieldLabels = fields.ToDictionary(f => f.Id, f => f.Label);

    static string Truncate(string? value, int max = 50)
    {
        if (string.IsNullOrEmpty(value))
        {
            return string.Empty;
        }

        return value.Length <= max ? value : value[..max] + "...";
    }
}

<div class="container mt-4">
    <div class="mb-3">
        <a asp-page="./GravityForms" class="btn btn-outline-secondary btn-sm mb-3">← Back to Forms</a>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2">
            <h1 class="mb-1 js-truncatable" title="@(Model.FormDetail?.Title ?? "Form Entries")" data-short="@Truncate(Model.FormDetail?.Title ?? "Form Entries")" data-full="@(Model.FormDetail?.Title ?? "Form Entries")">@Truncate(Model.FormDetail?.Title ?? "Form Entries")</h1>
            <div class="form-check form-switch ms-md-3">
                <input class="form-check-input" type="checkbox" id="showCompleteContent" />
                <label class="form-check-label" for="showCompleteContent">Show complete content</label>
            </div>
        </div>
        @if (Model.Result != null)
        {
            <div class="text-muted small">
                @Model.Result.TotalCount entries &mdash; page @Model.Result.PageNumber of @Model.Result.TotalPages
                @if (Model.FormAmountTotal.HasValue)
                {
                    <span>&mdash; Amount Total: <strong>@Model.FormAmountTotal.Value.ToString("C2")</strong></span>
                }
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    else if (Model.Result == null || !Model.Result.Entries.Any())
    {
        <div class="alert alert-info">No entries found for this form.</div>
    }
    else
    {
        @* Collect all distinct field keys across all entries for column headers *@
        var allFieldKeys = Model.Result.Entries
            .SelectMany(e => e.Fields.Keys)
            .Distinct()
            .OrderBy(k => {
                var parts = k.Split('.');
                var whole = int.TryParse(parts[0], out var w) ? w : 9999;
                var frac = parts.Length > 1 && int.TryParse(parts[1], out var f) ? f : 0;
                return whole * 1000 + frac;
            })
            .ToList();

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle table-sm small">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Date</th>
                        <th>Status</th>
                        @foreach (var key in allFieldKeys)
                        {
                            var label = fieldLabels.TryGetValue(key, out var lbl) ? lbl : $"Field {key}";
                            var hideWhenShort = key.Contains("17.1") || key.Contains("18.1") || key.Contains("18.2") || key.Contains("18.3");
                            <th class="js-truncatable js-field-column" title="@label" data-short="@Truncate(label)" data-full="@label" data-hide-when-short="@(hideWhenShort ? "true" : "false")">@Truncate(label)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Result.Entries)
                    {
                        var idValue = entry.Id ?? string.Empty;
                        var dateValue = entry.DateCreated ?? string.Empty;
                        var statusValue = entry.Status ?? string.Empty;
                        <tr>
                            <td class="text-muted js-truncatable" title="@idValue" data-short="@Truncate(idValue)" data-full="@idValue">@Truncate(idValue)</td>
                            <td class="text-nowrap js-truncatable" title="@dateValue" data-short="@Truncate(dateValue)" data-full="@dateValue">@Truncate(dateValue)</td>
                            <td>
                                @if (entry.Status == "active")
                                {
                                    <span class="badge text-bg-success">active</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(entry.Status))
                                {
                                    <span class="badge text-bg-secondary js-truncatable" title="@statusValue" data-short="@Truncate(statusValue)" data-full="@statusValue">@Truncate(statusValue)</span>
                                }
                            </td>
                            @foreach (var key in allFieldKeys)
                            {
                                var rawValue = entry.Fields.TryGetValue(key, out var v) ? v : string.Empty;
                                var hideWhenShort = key.Contains("17.1") || key.Contains("18.1") || key.Contains("18.2") || key.Contains("18.3");
                                <td class="js-truncatable js-field-column" title="@rawValue" data-short="@Truncate(rawValue)" data-full="@rawValue" data-hide-when-short="@(hideWhenShort ? "true" : "false")">@Truncate(rawValue)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Pagination *@
        @if (Model.Result.TotalPages > 1)
        {
            <nav aria-label="Entries pagination" class="mt-3">
                <ul class="pagination flex-wrap">
                    <li class="page-item @(Model.Result.PageNumber <= 1 ? "disabled" : null)">
                        <a class="page-link" asp-page="./GravityFormEntries"
                           asp-route-formId="@Model.FormId"
                           asp-route-pageNumber="@(Model.Result.PageNumber - 1)">Previous</a>
                    </li>
                    @for (var p = 1; p <= Model.Result.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Result.PageNumber ? "active" : null)">
                            <a class="page-link" asp-page="./GravityFormEntries"
                               asp-route-formId="@Model.FormId"
                               asp-route-pageNumber="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Result.PageNumber >= Model.Result.TotalPages ? "disabled" : null)">
                        <a class="page-link" asp-page="./GravityFormEntries"
                           asp-route-formId="@Model.FormId"
                           asp-route-pageNumber="@(Model.Result.PageNumber + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

<script>
    (function () {
        const toggle = document.getElementById('showCompleteContent');
        if (!toggle) return;

        const items = Array.from(document.querySelectorAll('.js-truncatable'));
        const fieldColumns = Array.from(document.querySelectorAll('.js-field-column'));
        const applyView = () => {
            const showFull = toggle.checked;
            items.forEach((el) => {
                const full = el.getAttribute('data-full') || '';
                const shortVal = el.getAttribute('data-short') || full;
                el.textContent = showFull ? full : shortVal;
                el.setAttribute('title', full);
            });

            fieldColumns.forEach((el) => {
                const hideWhenShort = (el.getAttribute('data-hide-when-short') || '').toLowerCase() === 'true';
                el.style.display = (!showFull && hideWhenShort) ? 'none' : '';
            });
        };

        toggle.checked = false;
        toggle.addEventListener('change', applyView);
        applyView();
    })();
</script>
