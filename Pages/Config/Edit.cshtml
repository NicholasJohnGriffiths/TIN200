@page "{id:int}"
@model TINWeb.Pages.Config.EditModel
@{
    ViewData["Title"] = "Edit Config";
}

<div class="container mt-4">
    <h1>Edit Config</h1>

    <form method="post" class="mt-3">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Record.Id" />

        <div class="mb-3">
            <label class="form-label">Id</label>
            <input asp-for="Record.Id" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label asp-for="Record.AdminEmail" class="form-label">Admin Email</label>
            <input asp-for="Record.AdminEmail" class="form-control" />
            <div class="form-text">Use one or more addresses separated by <code>;</code> or <code>,</code>.</div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
