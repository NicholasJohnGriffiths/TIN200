@page
@model TINWeb.Pages.Config.CreateModel
@{
    ViewData["Title"] = "Create Config";
}

<div class="container mt-4">
    <h1>Create Config</h1>
    <p class="text-muted">This table is designed to have a single row with <code>Id = 1</code>.</p>

    <form method="post" class="mt-3">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label">Id</label>
            <input value="1" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label asp-for="Record.AdminEmail" class="form-label">Admin Email</label>
            <input asp-for="Record.AdminEmail" class="form-control" />
            <div class="form-text">Use one or more addresses separated by <code>;</code> or <code>,</code>.</div>
        </div>

        <div class="mb-3">
            <label asp-for="Record.SurveyEmailSubject" class="form-label">Survey Email Subject</label>
            <input asp-for="Record.SurveyEmailSubject" class="form-control" maxlength="255" />
        </div>

        <div class="mb-3">
            <label asp-for="Record.SurveyEmailTemplate" class="form-label">Survey Email Template</label>
            <textarea asp-for="Record.SurveyEmailTemplate" id="surveyEmailTemplateEditor" class="form-control" rows="12"></textarea>
            <div class="form-text">Rich text/HTML is supported. Use <code>(Company Name)</code> or <code>(Name)</code> for the company name, and add a link with <code>id="surveylink"</code> for the survey URL.</div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.tiny.cloud/1/3kewwfp0mgpaatcm5468igfv49fz4ummxdovtdoxhz00u6gd/tinymce/7/tinymce.min.js"></script>
    <script>
        (function () {
            tinymce.init({
                selector: '#surveyEmailTemplateEditor',
                plugins: 'link lists table code help wordcount',
                toolbar: 'undo redo | blocks | bold italic underline | alignleft aligncenter alignright | bullist numlist | link table | code help',
                menubar: 'file edit view insert format table help',
                height: 360,
                setup: function (editor) {
                    editor.on('change input undo redo', function () {
                        tinymce.triggerSave();
                    });
                }
            });

            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function () {
                    tinymce.triggerSave();
                });
            }
        })();
    </script>
}
