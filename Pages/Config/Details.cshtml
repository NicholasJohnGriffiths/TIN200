@page "{id:int}"
@model TINWeb.Pages.Config.DetailsModel
@{
    ViewData["Title"] = "Config Details";
}

<div class="container mt-4">
    <h1>Config Details</h1>

    <dl class="row mt-3">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@Model.Record.Id</dd>

        <dt class="col-sm-3">Admin Email</dt>
        <dd class="col-sm-9">@Model.Record.AdminEmail</dd>

        <dt class="col-sm-3">Survey Email Subject</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Record.SurveyEmailSubject) ? "Default" : Model.Record.SurveyEmailSubject)</dd>

        <dt class="col-sm-3">Email Header Image</dt>
        <dd class="col-sm-9">@(Model.Record.EmailHeaderImageId.HasValue ? $"Image #{Model.Record.EmailHeaderImageId.Value}" : "Not set")</dd>

        <dt class="col-sm-3">Survey Email Template</dt>
        <dd class="col-sm-9">
            @if (string.IsNullOrWhiteSpace(Model.Record.SurveyEmailTemplate))
            {
                <span class="text-muted">Not set</span>
            }
            else
            {
                <div class="border rounded p-3 bg-light">@Html.Raw(Model.Record.SurveyEmailTemplate)</div>
            }
        </dd>
    </dl>

    <div class="d-flex gap-2">
        <a asp-page="./Edit" asp-route-id="@Model.Record.Id" class="btn btn-warning">Edit</a>
        <a asp-page="./Index" class="btn btn-secondary">Back</a>
    </div>
</div>
