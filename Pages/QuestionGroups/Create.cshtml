@page
@model TINWeb.Pages.QuestionGroups.CreateModel
@{
    ViewData["Title"] = "Create Question Group";
}

<div class="container mt-4">
    <h1>Create Question Group</h1>
    <hr />

    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group mb-3">
            <label asp-for="Record.OrderNumber" class="form-label"></label>
            <input asp-for="Record.OrderNumber" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label asp-for="Record.Title" class="form-label"></label>
            <input asp-for="Record.Title" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label asp-for="Record.Description" class="form-label"></label>
            <textarea asp-for="Record.Description" id="descriptionEditor" class="form-control"></textarea>
        </div>

        <div class="form-group mb-3">
            <div class="form-check">
                <input asp-for="Record.DisplayTitleDesc" class="form-check-input" />
                <label asp-for="Record.DisplayTitleDesc" class="form-check-label">Display title and description on survey pages</label>
            </div>
        </div>

        <div class="form-group mb-3">
            <div class="form-check">
                <input asp-for="Record.TableFormat" class="form-check-input" />
                <label asp-for="Record.TableFormat" class="form-check-label">Table Format (display questions as a compact table)</label>
            </div>
        </div>

        <div class="form-group mb-3">
            <div class="form-check">
                <input asp-for="Record.NewPage" class="form-check-input" />
                <label asp-for="Record.NewPage" class="form-check-label">Start on a new survey page</label>
            </div>
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Image 1</label>
            <input asp-for="Image1File" type="file" class="form-control" accept="image/*" />
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Image 2</label>
            <input asp-for="Image2File" type="file" class="form-control" accept="image/*" />
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Image 3</label>
            <input asp-for="Image3File" type="file" class="form-control" accept="image/*" />
        </div>

        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="https://cdn.tiny.cloud/1/3kewwfp0mgpaatcm5468igfv49fz4ummxdovtdoxhz00u6gd/tinymce/7/tinymce.min.js"></script>
    <script>
        // Initialize TinyMCE for description field
        tinymce.init({
            selector: '#descriptionEditor',
            plugins: 'link image lists table code help wordcount',
            toolbar: 'undo redo | formatselect | bold italic | alignleft aligncenter alignright | bullist numlist | link image | code help',
            menubar: 'file edit view insert format table help',
            height: 400,
            setup: function(editor) {
                // Handle form submission - TinyMCE will automatically save to textarea
                editor.on('change', function() {
                    tinymce.triggerSave();
                });
            }
        });
    </script>
}
