@page "{id:int}"
@model TINWeb.Pages.Questions.EditModel
@{
    ViewData["Title"] = "Edit Question";
}

<div class="container mt-4">
    <h1>Edit Question</h1>
    <hr />

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Record.Id" />

        <div class="form-group mb-3">
            <label asp-for="Record.OrderNumber" class="form-label"></label>
            <input asp-for="Record.OrderNumber" class="form-control" />
            <small class="form-text text-muted">Changing this value moves this question and reorders the others automatically.</small>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Record.Title" class="form-label"></label>
            <input asp-for="Record.Title" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label asp-for="Record.Description" class="form-label"></label>
            <textarea asp-for="Record.Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Record.GroupId" class="form-label">Question Group</label>
            <select asp-for="Record.GroupId" asp-items="Model.QuestionGroupOptions" class="form-select"></select>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Record.QuestionText" class="form-label">Question</label>
            <textarea asp-for="Record.QuestionText" class="form-control" id="questionTextEditor" rows="6"></textarea>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Record.ImportColumnName" class="form-label">Import Column Name</label>
            <input asp-for="Record.ImportColumnName" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label asp-for="Record.ImportColumnNameAlt" class="form-label">Import Column Name Alt</label>
            <input asp-for="Record.ImportColumnNameAlt" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label asp-for="Record.AnswerType" class="form-label"></label>
            <select asp-for="Record.AnswerType" class="form-select" id="answerTypeSelect">
                @foreach (var option in Model.AnswerTypeOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
            <span asp-validation-for="Record.AnswerType" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Record.DecimalPoints" class="form-label">Decimal Points</label>
            <input asp-for="Record.DecimalPoints" class="form-control" type="number" />
            <small class="form-text text-muted">Use `0` for whole numbers, positive values for decimal places, and `-3` to display in thousands.</small>
        </div>

        <div class="form-group mb-3">
            <div class="form-check">
                <input asp-for="Active" type="checkbox" class="form-check-input" />
                <label asp-for="Active" class="form-check-label">Active</label>
            </div>
        </div>

        <div class="row" id="multichoiceFields">
            <div class="col-md-3 mb-3"><input asp-for="Record.Multi1" class="form-control" placeholder="Multi 1" /></div>
            <div class="col-md-3 mb-3"><input asp-for="Record.Multi2" class="form-control" placeholder="Multi 2" /></div>
            <div class="col-md-3 mb-3"><input asp-for="Record.Multi3" class="form-control" placeholder="Multi 3" /></div>
            <div class="col-md-3 mb-3"><input asp-for="Record.Multi4" class="form-control" placeholder="Multi 4" /></div>
            <div class="col-md-3 mb-3"><input asp-for="Record.Multi5" class="form-control" placeholder="Multi 5" /></div>
            <div class="col-md-3 mb-3"><input asp-for="Record.Multi6" class="form-control" placeholder="Multi 6" /></div>
            <div class="col-md-3 mb-3"><input asp-for="Record.Multi7" class="form-control" placeholder="Multi 7" /></div>
            <div class="col-md-3 mb-3"><input asp-for="Record.Multi8" class="form-control" placeholder="Multi 8" /></div>
            <div class="col-md-3 mb-3"><input asp-for="Record.Multi9" class="form-control" placeholder="Multi 9" /></div>
            <div class="col-md-3 mb-3"><input asp-for="Record.Multi10" class="form-control" placeholder="Multi 10" /></div>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-page="./Index" asp-route-focusId="@Model.Record.Id" class="btn btn-secondary">Back to List</a>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="https://cdn.jsdelivr.net/npm/tinymce@7/tinymce.min.js"></script>
    <script>
        (function () {
            tinymce.init({
                license_key: 'gpl',
                selector: '#questionTextEditor',
                plugins: 'link lists table code help wordcount',
                toolbar: 'undo redo | blocks | bold italic underline | alignleft aligncenter alignright | bullist numlist | link | code help',
                menubar: 'file edit view insert format table help',
                height: 320,
                setup: function (editor) {
                    editor.on('change input undo redo', function () {
                        tinymce.triggerSave();
                    });
                }
            });

            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function () {
                    tinymce.triggerSave();
                });
            }

            const answerTypeSelect = document.getElementById('answerTypeSelect');
            const multichoiceFields = document.getElementById('multichoiceFields');

            function toggleMultichoiceFields() {
                const isChoiceType = answerTypeSelect && (answerTypeSelect.value === 'SingleChoice' || answerTypeSelect.value === 'Radio' || answerTypeSelect.value === 'Multichoice');
                if (multichoiceFields) {
                    multichoiceFields.style.display = isChoiceType ? '' : 'none';
                }
            }

            if (answerTypeSelect) {
                answerTypeSelect.addEventListener('change', toggleMultichoiceFields);
            }

            toggleMultichoiceFields();
        })();
    </script>
}
