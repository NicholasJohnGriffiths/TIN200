@page
@model TINWeb.Pages.MailerLite.LabelsModel
@{
    ViewData["Title"] = "MailerLite - Labels";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col">
            <h1>MailerLite - Labels</h1>
            <p class="text-muted mb-0">Select a MailerLite group to view its subscribers.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <form method="get" class="row g-3 align-items-end mb-3">
        <div class="col-md-4">
            <label class="form-label" for="groupId">MailerLite Group</label>
            <select name="groupId" id="groupId" class="form-select" onchange="this.form.submit()">
                <option value="">-- Select a group --</option>
                @foreach (var group in Model.Groups)
                {
                    <option value="@group.Id" selected="@(Model.SelectedGroupId == group.Id ? "selected" : null)">@group.Name (@group.SubscribersCount)</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary">Apply</button>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.SelectedGroupId))
    {
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Subscribers (@Model.Subscribers.Count)</span>
                <a class="btn btn-sm btn-outline-secondary" asp-page="./PrintLabels" asp-route-groupId="@Model.SelectedGroupId" target="_blank">Preview / Print Labels</a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Email</th>
                            <th>First Name</th>
                            <th>Surname</th>
                            <th>Company Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var subscriber in Model.Subscribers)
                        {
                            <tr>
                                <td>@subscriber.Email</td>
                                <td>@subscriber.FirstName</td>
                                <td>@subscriber.LastName</td>
                                <td>@subscriber.CompanyName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
