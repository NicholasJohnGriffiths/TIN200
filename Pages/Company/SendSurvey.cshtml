@page
@model TINWeb.Pages.Company.SendSurveyModel
@{
    ViewData["Title"] = "Send Company Survey";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <h1>Send Company Survey</h1>
            <p class="text-muted mb-1">Send a secure data update survey link to selected companies or all companies.</p>
            <p class="small text-muted">Survey link expiry is controlled by the current application settings.</p>
            <hr />

            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <div class="alert alert-success" role="alert">
                    @Model.StatusMessage
                </div>
            }

            @if (Model.BulkSentCount.HasValue || Model.BulkSkippedCount.HasValue || Model.BulkFailedCount.HasValue)
            {
                <div class="card mb-3">
                    <div class="card-header">Last Bulk Send Summary</div>
                    <div class="card-body py-2">
                        @if (!string.IsNullOrWhiteSpace(Model.BulkLastRunAt))
                        {
                            <div><strong>Last run:</strong> @Model.BulkLastRunAt</div>
                        }
                        <div><strong>Sent:</strong> @(Model.BulkSentCount ?? 0)</div>
                        <div><strong>Skipped (no email):</strong> @(Model.BulkSkippedCount ?? 0)</div>
                        <div><strong>Failed:</strong> @(Model.BulkFailedCount ?? 0)</div>
                    </div>
                </div>
            }

            <div id="bulkSendProgressContainer" class="mb-3" style="display:none;">
                <div class="d-flex justify-content-between small mb-1">
                    <span id="bulkSendProgressLabel">Sending survey emails...</span>
                    <span id="bulkSendProgressPercent">0%</span>
                </div>
                <div class="progress" role="progressbar" aria-label="Bulk send progress" aria-valuemin="0" aria-valuemax="100">
                    <div id="bulkSendProgressBar" class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%"></div>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="card mb-3">
                <div class="card-header">Bulk Send</div>
                <div class="card-body">
                    <form method="get" class="mb-3 d-flex align-items-end gap-3 flex-wrap">
                        <div>
                            <label asp-for="SelectedTinStatus" class="form-label mb-1">TIN Status</label>
                            <select asp-for="SelectedTinStatus" class="form-select" style="min-width: 220px;" onchange="this.form.submit()">
                                @foreach (var option in TINWeb.Models.TinStatusHelper.DropdownOptions)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label asp-for="SelectedEmailContentId" class="form-label mb-1">Email Content</label>
                            <select asp-for="SelectedEmailContentId" asp-items="Model.EmailContentOptions" class="form-select" style="min-width: 260px;">
                                <option value="">Select email content</option>
                            </select>
                        </div>

                        <div class="mb-2">
                            <button type="submit" class="btn btn-outline-primary btn-sm">Apply Filters</button>
                        </div>
                    </form>

                    <span asp-validation-for="SelectedEmailContentId" class="text-danger"></span>

                    @if (Model.EmailPreview != null)
                    {
                        <div class="card mb-3 border-info">
                            <div class="card-header bg-info-subtle">Selected Email Content Preview</div>
                            <div class="card-body">
                                <div class="mb-2"><strong>Subject:</strong> @(string.IsNullOrWhiteSpace(Model.EmailPreview.Subject) ? "(blank - default subject will be used)" : Model.EmailPreview.Subject)</div>
                                <div class="border rounded p-3 bg-white" style="max-height: 320px; overflow-y: auto;">
                                    @Html.Raw(Model.EmailPreview.HtmlBody)
                                </div>
                            </div>
                        </div>
                    }

                    @{
                        var selectedEmailContentLabel = Model.EmailContentOptions
                            .FirstOrDefault(x => string.Equals(x.Value, Model.SelectedEmailContentId?.ToString(), StringComparison.OrdinalIgnoreCase))
                            ?.Text;
                    }

                    @if (!string.IsNullOrWhiteSpace(selectedEmailContentLabel))
                    {
                        <div class="alert alert-warning" role="alert">
                            <strong>Sending with Email Content:</strong> @selectedEmailContentLabel
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger" role="alert">
                            <strong>No Email Content selected.</strong> Choose one before sending.
                        </div>
                    }

                    <form id="bulkSendForm" method="post" asp-page-handler="Bulk">
                        <input type="hidden" asp-for="SelectedTinStatus" />
                        <input type="hidden" asp-for="SelectedEmailContentId" />
                        <div class="form-check mb-3">
                            <input asp-for="SendToAllClients" class="form-check-input" />
                            <label asp-for="SendToAllClients" class="form-check-label">Send to all clients with a contact email address</label>
                        </div>

                        <div class="mb-2">
                            <button type="button" id="selectAllClientsBtn" class="btn btn-outline-secondary btn-sm">Select All Listed</button>
                            <button type="button" id="clearAllClientsBtn" class="btn btn-outline-secondary btn-sm">Clear Selection</button>
                        </div>

                        <div class="form-group mb-3">
                            <label for="clientSearchInput" class="form-label">Search clients</label>
                            <input id="clientSearchInput" class="form-control" type="text" placeholder="Search by ID, company, or contact email" />
                        </div>

                        <div class="mb-3" role="group" aria-label="Client email filters">
                            <button type="button" class="btn btn-outline-secondary btn-sm client-filter-btn active" data-filter="all">All</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm client-filter-btn" data-filter="has-email">Has Contact Email Only</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm client-filter-btn" data-filter="missing-email">Missing Contact Email</button>
                        </div>

                        <div class="mb-3 d-flex align-items-center" role="group" aria-label="Survey email sent filter">
                            <label for="surveyEmailSentFilter" class="form-label me-2 mb-0">Survey Email Sent</label>
                            <select id="surveyEmailSentFilter" class="form-select form-select-sm" style="max-width: 180px;">
                                <option value="all">All</option>
                                <option value="sent">Sent</option>
                                <option value="not-sent">Not sent</option>
                            </select>
                        </div>

                        <div class="mb-2 small text-muted">
                            <strong>Displayed companies:</strong> <span id="displayedCompanyCount">@Model.AvailableClients.Count</span>
                            <span class="mx-2">|</span>
                            <strong>Selected:</strong> <span id="selectedCompanyCount">@(Model.SelectedClientIds.Count)</span>
                        </div>

                        <div id="clientListContainer" class="table-responsive" style="max-height: 420px; overflow-y: auto;">
                            <table class="table table-striped align-middle company-table">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 80px;">Select</th>
                                        <th style="width: 80px;">
                                            <button type="button" class="btn btn-link p-0 sort-header" data-sort-key="id">ID</button>
                                        </th>
                                        <th>
                                            <button type="button" class="btn btn-link p-0 sort-header" data-sort-key="company">Company</button>
                                        </th>
                                        <th>
                                            <button type="button" class="btn btn-link p-0 sort-header" data-sort-key="email">Contact Email</button>
                                        </th>
                                        <th style="min-width: 260px;">Survey Link</th>
                                        <th style="min-width: 170px;">Link Expiry</th>
                                        <th style="width: 120px;">Survey Locked</th>
                                        <th style="width: 120px;">Unsubscribed</th>
                                        <th style="width: 140px;">Survey Email Sent</th>
                                        <th style="width: 170px;">Survey Email Sent Last Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var clientRow in Model.AvailableClients)
                                    {
                                        var hasEmail = !string.IsNullOrWhiteSpace(clientRow.Email);
                                        var canSend = hasEmail && !clientRow.IsLocked && !clientRow.Unsubscribed;
                                        var disableReason = clientRow.Unsubscribed
                                            ? "This company has unsubscribed from surveys."
                                            : clientRow.IsLocked
                                                ? "Survey record is locked. Contact the Technology Investment Network."
                                                : "Cannot send survey email because no contact email address is available.";
                                        var searchText = $"{clientRow.Id} {clientRow.CompanyName} {clientRow.Email}".ToLowerInvariant();
                                        var companySort = (clientRow.CompanyName ?? string.Empty).ToLowerInvariant();
                                        var emailSort = (clientRow.Email ?? string.Empty).ToLowerInvariant();
                                        <tr class="@(Model.SelectedClientIds.Contains(clientRow.Id) ? "preselected-client-row" : string.Empty)" data-search="@searchText" data-has-email="@(hasEmail ? "true" : "false")" data-id="@clientRow.Id" data-company="@companySort" data-email="@emailSort" data-survey-email-sent="@(clientRow.SurveyEmailSent ? "true" : "false")">
                                            <td>
                                                @if (canSend)
                                                {
                                                    <input class="form-check-input client-selector" type="checkbox" name="SelectedClientIds" value="@clientRow.Id" checked="@Model.SelectedClientIds.Contains(clientRow.Id)" />
                                                }
                                                else
                                                {
                                                    <span title="@disableReason">
                                                        <input class="form-check-input client-selector" type="checkbox" name="SelectedClientIds" value="@clientRow.Id" disabled />
                                                    </span>
                                                    <span class="small text-muted ms-1" title="@disableReason">N/A</span>
                                                }
                                            </td>
                                            <td>@clientRow.Id</td>
                                            <td>@clientRow.CompanyName</td>
                                            <td>
                                                @if (hasEmail)
                                                {
                                                    @clientRow.Email
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No contact email</span>
                                                }
                                            </td>
                                            <td style="min-width: 260px; max-width: 360px;">
                                                @if (!string.IsNullOrWhiteSpace(clientRow.SurveyLink))
                                                {
                                                    <a href="@clientRow.SurveyLink" target="_blank" rel="noopener noreferrer" class="small d-inline-block text-break" title="@clientRow.SurveyLink">@clientRow.SurveyLink</a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not created</span>
                                                }
                                            </td>
                                            <td>
                                                @if (clientRow.SurveyLinkExpiryUtc.HasValue)
                                                {
                                                    <span class="badge @(clientRow.IsSurveyLinkExpired ? "bg-danger" : "bg-success")">@(clientRow.IsSurveyLinkExpired ? "Expired" : "Valid")</span>
                                                    <div class="small text-muted mt-1">@clientRow.SurveyLinkExpiryUtc.Value.ToString("dd/MM/yyyy HH:mm 'UTC'")</div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td>
                                                @if (clientRow.IsLocked)
                                                {
                                                    <span class="badge bg-warning text-dark">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No</span>
                                                }
                                            </td>
                                            <td>
                                                @if (clientRow.Unsubscribed)
                                                {
                                                    <span class="badge bg-danger">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No</span>
                                                }
                                            </td>
                                            <td>@(clientRow.SurveyEmailSent ? "Yes" : "No")</td>
                                            <td>@(clientRow.SurveyEmailSentLastDate?.ToString("dd/MM/yyyy") ?? string.Empty)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="form-check mt-3">
                            <input asp-for="EnableScheduleSettings" class="form-check-input" />
                            <label asp-for="EnableScheduleSettings" class="form-check-label">Schedule Settings</label>
                        </div>

                        <div id="scheduleSettingsPanel" class="border rounded p-3 mt-2" style="display:none;">
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label asp-for="SendStartTime" class="form-label">Send Start Time</label>
                                    <input asp-for="SendStartTime" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                                    <span asp-validation-for="SendStartTime" class="text-danger"></span>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label asp-for="SplitBulkIntoBatchesOf" class="form-label">Split bulk into batches of</label>
                                    <input asp-for="SplitBulkIntoBatchesOf" type="number" min="1" class="form-control" />
                                    <span asp-validation-for="SplitBulkIntoBatchesOf" class="text-danger"></span>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label asp-for="BreakBetweenSendingGroupsHours" class="form-label">Break Between sending Groups (hrs)</label>
                                    <input asp-for="BreakBetweenSendingGroupsHours" type="number" min="0" step="0.1" class="form-control" />
                                    <span asp-validation-for="BreakBetweenSendingGroupsHours" class="text-danger"></span>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label asp-for="IntervalBetweenEachEmailSendSeconds" class="form-label">Interval Between Each Email Send (seconds)</label>
                                    <input asp-for="IntervalBetweenEachEmailSendSeconds" type="number" min="0" step="1" class="form-control" />
                                    <span asp-validation-for="IntervalBetweenEachEmailSendSeconds" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-text mt-2">Times are interpreted in local server time.</div>
                        </div>

                        <div id="bulkSendConfigInfo" class="alert alert-info mt-3 mb-0 small" role="status"></div>

                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" id="sendSurveyEmailsBtn" class="btn btn-primary">Send Survey Emails</button>
                            <button type="button" id="stopScheduledSendBtn" class="btn btn-outline-danger" style="display:none;">Stop Scheduled Send</button>
                        </div>
                    </form>
                </div>
            </div>

            <a asp-page="./Index" class="btn btn-secondary">Back to Records</a>
        </div>
    </div>
</div>

<div class="modal fade" id="bulkSendWarningModal" tabindex="-1" aria-labelledby="bulkSendWarningModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bulkSendWarningModalLabel">Confirm Bulk Email Send</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning mb-0" role="alert">
                    You are about to send survey emails to <strong id="bulkSendWarningTarget">selected clients</strong>. Please confirm to continue.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmBulkSendBtn" class="btn btn-danger">Send Emails</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const selectAllBtn = document.getElementById('selectAllClientsBtn');
            const clearAllBtn = document.getElementById('clearAllClientsBtn');
            const sendToAllToggle = document.getElementById('SendToAllClients');
            const searchInput = document.getElementById('clientSearchInput');
            const surveyEmailSentFilterSelect = document.getElementById('surveyEmailSentFilter');
            const displayedCompanyCount = document.getElementById('displayedCompanyCount');
            const selectedCompanyCount = document.getElementById('selectedCompanyCount');
            const filterButtons = Array.from(document.querySelectorAll('.client-filter-btn'));
            const sortButtons = Array.from(document.querySelectorAll('.sort-header'));
            const selectableCheckboxes = Array.from(document.querySelectorAll('.client-selector:not([disabled])'));
            const tbody = document.querySelector('tbody');
            const clientListContainer = document.getElementById('clientListContainer');
            const bulkSendForm = document.getElementById('bulkSendForm');
            const warningModalElement = document.getElementById('bulkSendWarningModal');
            const warningTarget = document.getElementById('bulkSendWarningTarget');
            const confirmBulkSendBtn = document.getElementById('confirmBulkSendBtn');
            const bulkSendProgressContainer = document.getElementById('bulkSendProgressContainer');
            const bulkSendProgressBar = document.getElementById('bulkSendProgressBar');
            const bulkSendProgressPercent = document.getElementById('bulkSendProgressPercent');
            const bulkSendProgressLabel = document.getElementById('bulkSendProgressLabel');
            const scheduleSettingsToggle = document.getElementById('EnableScheduleSettings');
            const scheduleSettingsPanel = document.getElementById('scheduleSettingsPanel');
            const sendStartTimeInput = document.getElementById('SendStartTime');
            const splitBulkIntoBatchesInput = document.getElementById('SplitBulkIntoBatchesOf');
            const breakBetweenGroupsHoursInput = document.getElementById('BreakBetweenSendingGroupsHours');
            const intervalBetweenEmailsInput = document.getElementById('IntervalBetweenEachEmailSendSeconds');
            const bulkSendConfigInfo = document.getElementById('bulkSendConfigInfo');
            const sendSurveyEmailsBtn = document.getElementById('sendSurveyEmailsBtn');
            const stopScheduledSendBtn = document.getElementById('stopScheduledSendBtn');
            const warningModal = warningModalElement && window.bootstrap && window.bootstrap.Modal
                ? new window.bootstrap.Modal(warningModalElement)
                : null;
            const url = new URL(window.location.href);
            const storageKey = 'tin200_send_survey_selected_clients';
            const preserveSelectionOnNextLoadKey = 'tin200_send_survey_preserve_next_load';
            const clearSavedSelectionsAfterSend = @Model.BulkSendSucceeded.ToString().ToLowerInvariant();
            const hasQueryPreselection = @Model.HasQueryPreselection.ToString().ToLowerInvariant();
            let bulkSendInProgress = false;
            let bulkSendAbortController = null;
            let searchParam = null;
            let filterParam = null;
            let activeFilter = 'all';
            let surveyEmailSentFilterParam = null;
            let activeSurveyEmailSentFilter = 'all';
            let sortKey = 'company';
            let sortDir = 'asc';
            let bulkProgressTimerId = null;
            let bulkProgressStartedAtMs = 0;
            let bulkProgressTotalMs = 0;

            if (!selectAllBtn || !clearAllBtn) {
                return;
            }

            if (clearSavedSelectionsAfterSend) {
                url.searchParams.delete('search');
                url.searchParams.delete('filter');
                window.history.replaceState({}, '', url.toString());
            }

            const preserveSelectionOnNextLoad = sessionStorage.getItem(preserveSelectionOnNextLoadKey) === 'true';

            if (!preserveSelectionOnNextLoad && !hasQueryPreselection) {
                sessionStorage.removeItem(storageKey);
            }

            sessionStorage.removeItem(preserveSelectionOnNextLoadKey);

            searchParam = url.searchParams.get('search');
            filterParam = url.searchParams.get('filter');
            surveyEmailSentFilterParam = url.searchParams.get('surveyEmailSentFilter');

            const sortParam = (url.searchParams.get('sort') || '').toLowerCase();
            const sortDirParam = (url.searchParams.get('dir') || '').toLowerCase();
            if (['id', 'company', 'email'].includes(sortParam)) {
                sortKey = sortParam;
            }
            if (['asc', 'desc'].includes(sortDirParam)) {
                sortDir = sortDirParam;
            }

            const getCheckboxes = () => Array.from(document.querySelectorAll('.client-selector:not([disabled])'));
            const getVisibleRows = () => Array.from(document.querySelectorAll('tbody tr')).filter(row => row.style.display !== 'none');
            const getSearchRows = () => Array.from(document.querySelectorAll('tbody tr[data-search]'));

            const parseNonNegativeInt = (value) => {
                const parsed = parseInt((value || '').trim(), 10);
                return Number.isFinite(parsed) && parsed >= 0 ? parsed : 0;
            };

            const parseNonNegativeNumber = (value) => {
                const parsed = parseFloat((value || '').trim());
                return Number.isFinite(parsed) && parsed >= 0 ? parsed : 0;
            };

            const getRecipientCount = () => {
                const selectedCount = getCheckboxes().filter(cb => cb.checked).length;
                if (sendToAllToggle && sendToAllToggle.checked) {
                    return getCheckboxes().length;
                }

                return selectedCount;
            };

            const formatDuration = (totalSeconds) => {
                const seconds = Math.max(0, Math.floor(totalSeconds));
                const hours = Math.floor(seconds / 3600);
                const minutes = Math.floor((seconds % 3600) / 60);
                const remainingSeconds = seconds % 60;
                const parts = [];

                if (hours > 0) {
                    parts.push(`${hours}h`);
                }
                if (minutes > 0) {
                    parts.push(`${minutes}m`);
                }
                if (remainingSeconds > 0 || parts.length === 0) {
                    parts.push(`${remainingSeconds}s`);
                }

                return parts.join(' ');
            };

            const getCurrentScheduleConfig = () => {
                const scheduleEnabled = !!(scheduleSettingsToggle && scheduleSettingsToggle.checked);
                const startTimeRaw = sendStartTimeInput ? sendStartTimeInput.value : '';
                const startTime = startTimeRaw ? new Date(startTimeRaw) : null;
                const batchSize = Math.max(1, parseNonNegativeInt(splitBulkIntoBatchesInput ? splitBulkIntoBatchesInput.value : '1'));
                const breakHours = parseNonNegativeNumber(breakBetweenGroupsHoursInput ? breakBetweenGroupsHoursInput.value : '0');
                const intervalSeconds = parseNonNegativeInt(intervalBetweenEmailsInput ? intervalBetweenEmailsInput.value : '0');
                const recipientCount = getRecipientCount();

                return {
                    scheduleEnabled,
                    startTime,
                    batchSize,
                    breakHours,
                    intervalSeconds,
                    recipientCount
                };
            };

            const getEstimatedTotalSeconds = (config) => {
                if (!config.scheduleEnabled) {
                    return 0;
                }

                let total = 0;
                if (config.startTime && !Number.isNaN(config.startTime.getTime())) {
                    const now = new Date();
                    const startDelaySeconds = Math.max(0, (config.startTime.getTime() - now.getTime()) / 1000);
                    total += startDelaySeconds;
                }

                const sends = Math.max(0, config.recipientCount);
                const delayPoints = Math.max(0, sends - 1);
                if (delayPoints === 0) {
                    return total;
                }

                const batchBreaks = Math.floor(delayPoints / config.batchSize);
                const intervalDelays = Math.max(0, delayPoints - batchBreaks);
                total += (batchBreaks * config.breakHours * 3600) + (intervalDelays * config.intervalSeconds);

                return total;
            };

            const updateBulkSendConfigInfo = () => {
                if (!bulkSendConfigInfo) {
                    return;
                }

                const config = getCurrentScheduleConfig();
                if (!config.scheduleEnabled) {
                    bulkSendConfigInfo.textContent = `Mode: Immediate send. Target recipients: ${config.recipientCount}.`;
                    return;
                }

                const startText = config.startTime && !Number.isNaN(config.startTime.getTime())
                    ? config.startTime.toLocaleString()
                    : 'Not set';
                const estimated = getEstimatedTotalSeconds(config);
                const estimatedText = estimated > 0 ? formatDuration(estimated) : 'No scheduled delay';

                bulkSendConfigInfo.textContent = `Mode: Scheduled. Start: ${startText}. Batch size: ${config.batchSize}. Break between groups: ${config.breakHours}h. Interval per email: ${config.intervalSeconds}s. Target recipients: ${config.recipientCount}. Estimated duration: ${estimatedText}.`;
            };

            const updateScheduleSettingsVisibility = () => {
                if (!scheduleSettingsToggle || !scheduleSettingsPanel) {
                    return;
                }

                scheduleSettingsPanel.style.display = scheduleSettingsToggle.checked ? '' : 'none';
            };

            const updateCounts = () => {
                if (displayedCompanyCount) {
                    displayedCompanyCount.textContent = String(getVisibleRows().length);
                }

                if (selectedCompanyCount) {
                    selectedCompanyCount.textContent = String(getCheckboxes().filter(cb => cb.checked).length);
                }
            };

            const saveSelections = () => {
                const selectedIds = getCheckboxes()
                    .filter(cb => cb.checked)
                    .map(cb => cb.value);
                sessionStorage.setItem(storageKey, JSON.stringify(selectedIds));
                updateCounts();
            };

            const restoreSelections = () => {
                const raw = sessionStorage.getItem(storageKey);
                if (!raw) {
                    return;
                }

                let selectedIds;
                try {
                    selectedIds = JSON.parse(raw);
                } catch {
                    return;
                }

                if (!Array.isArray(selectedIds)) {
                    return;
                }

                const selectedSet = new Set(selectedIds.map(String));
                getCheckboxes().forEach(function (cb) {
                    cb.checked = selectedSet.has(String(cb.value));
                });
            };

            const revealPreselectedClient = () => {
                if (!hasQueryPreselection) {
                    return;
                }

                const selectedCheckbox = document.querySelector('tbody .client-selector:checked');
                if (!selectedCheckbox) {
                    return;
                }

                const selectedRow = selectedCheckbox.closest('tr');
                if (!selectedRow || selectedRow.style.display === 'none') {
                    return;
                }

                selectedRow.classList.add('table-warning');

                if (clientListContainer) {
                    const rowTop = selectedRow.offsetTop;
                    const rowHeight = selectedRow.offsetHeight;
                    const containerHeight = clientListContainer.clientHeight;
                    const targetTop = Math.max(0, rowTop - (containerHeight / 2) + (rowHeight / 2));
                    clientListContainer.scrollTop = targetTop;
                    return;
                }

                selectedRow.scrollIntoView({ behavior: 'auto', block: 'center' });
            };

            const syncUrlState = () => {
                const term = ((searchInput && searchInput.value) || '').trim();

                if (term) {
                    url.searchParams.set('search', term);
                } else {
                    url.searchParams.delete('search');
                }

                if (activeFilter && activeFilter !== 'all') {
                    url.searchParams.set('filter', activeFilter);
                } else {
                    url.searchParams.delete('filter');
                }

                if (activeSurveyEmailSentFilter && activeSurveyEmailSentFilter !== 'all') {
                    url.searchParams.set('surveyEmailSentFilter', activeSurveyEmailSentFilter);
                } else {
                    url.searchParams.delete('surveyEmailSentFilter');
                }

                if (sortKey !== 'company') {
                    url.searchParams.set('sort', sortKey);
                } else {
                    url.searchParams.delete('sort');
                }

                if (sortDir !== 'asc') {
                    url.searchParams.set('dir', sortDir);
                } else {
                    url.searchParams.delete('dir');
                }

                window.history.replaceState({}, '', url.toString());
            };

            const setSortButtonText = () => {
                sortButtons.forEach(function (btn) {
                    const key = btn.getAttribute('data-sort-key');
                    const baseLabel = (key || '').charAt(0).toUpperCase() + (key || '').slice(1);
                    if (key === sortKey) {
                        btn.textContent = `${baseLabel} ${sortDir === 'asc' ? '↑' : '↓'}`;
                    } else {
                        btn.textContent = baseLabel;
                    }
                });
            };

            const startBulkSendProgress = (estimatedTotalSeconds) => {
                if (!bulkSendProgressContainer || !bulkSendProgressBar || !bulkSendProgressPercent || !bulkSendProgressLabel) {
                    return;
                }

                if (bulkProgressTimerId) {
                    window.clearInterval(bulkProgressTimerId);
                }

                bulkProgressStartedAtMs = Date.now();
                bulkProgressTotalMs = Math.max(0, estimatedTotalSeconds) * 1000;
                bulkSendProgressLabel.textContent = 'Sending survey emails...';
                bulkSendProgressContainer.style.display = '';

                const render = (value) => {
                    bulkSendProgressBar.style.width = `${value}%`;
                    bulkSendProgressPercent.textContent = `${value}%`;
                };

                render(5);

                bulkProgressTimerId = window.setInterval(() => {
                    if (bulkProgressTotalMs <= 0) {
                        const elapsed = Date.now() - bulkProgressStartedAtMs;
                        const value = Math.min(92, 5 + Math.floor(elapsed / 400));
                        render(value);
                        return;
                    }

                    const elapsedMs = Date.now() - bulkProgressStartedAtMs;
                    const ratio = Math.max(0, Math.min(1, elapsedMs / bulkProgressTotalMs));
                    const value = Math.min(95, Math.max(5, Math.round(ratio * 95)));
                    render(value);
                }, 300);
            };

            const stopBulkSendProgress = (label, percent) => {
                if (!bulkSendProgressContainer || !bulkSendProgressBar || !bulkSendProgressPercent || !bulkSendProgressLabel) {
                    return;
                }

                if (bulkProgressTimerId) {
                    window.clearInterval(bulkProgressTimerId);
                    bulkProgressTimerId = null;
                }

                if (typeof percent === 'number') {
                    const boundedPercent = Math.max(0, Math.min(100, Math.round(percent)));
                    bulkSendProgressBar.style.width = `${boundedPercent}%`;
                    bulkSendProgressPercent.textContent = `${boundedPercent}%`;
                }

                if (label) {
                    bulkSendProgressLabel.textContent = label;
                }
            };

            const delayWithAbort = (milliseconds, signal) => {
                const durationMs = Math.max(0, Math.floor(milliseconds));
                if (durationMs === 0) {
                    return Promise.resolve();
                }

                return new Promise((resolve, reject) => {
                    const timerId = window.setTimeout(() => {
                        if (signal) {
                            signal.removeEventListener('abort', onAbort);
                        }
                        resolve();
                    }, durationMs);

                    const onAbort = () => {
                        window.clearTimeout(timerId);
                        reject(new DOMException('Aborted', 'AbortError'));
                    };

                    if (signal) {
                        if (signal.aborted) {
                            onAbort();
                            return;
                        }

                        signal.addEventListener('abort', onAbort, { once: true });
                    }
                });
            };

            const getScheduledDelayBeforeNextRequestMs = (config, processedCount, queueCount) => {
                if (!config.scheduleEnabled || processedCount <= 0 || processedCount >= queueCount) {
                    return 0;
                }

                if (config.batchSize > 0 && processedCount % config.batchSize === 0) {
                    return config.breakHours * 3600 * 1000;
                }

                return config.intervalSeconds * 1000;
            };

            const setBulkSendRunningState = (isRunning) => {
                bulkSendInProgress = isRunning;
                if (sendSurveyEmailsBtn) {
                    sendSurveyEmailsBtn.disabled = isRunning;
                }
                if (confirmBulkSendBtn) {
                    confirmBulkSendBtn.disabled = isRunning;
                }
                if (stopScheduledSendBtn) {
                    stopScheduledSendBtn.style.display = isRunning ? '' : 'none';
                    stopScheduledSendBtn.disabled = !isRunning;
                }
            };

            const submitBulkSendAsync = async () => {
                if (!bulkSendForm || bulkSendInProgress) {
                    return;
                }

                const config = getCurrentScheduleConfig();
                const estimatedTotalSeconds = getEstimatedTotalSeconds(config);
                const ajaxBatchSize = config.scheduleEnabled ? 1 : 10;

                setBulkSendRunningState(true);
                startBulkSendProgress(estimatedTotalSeconds);
                bulkSendAbortController = new AbortController();

                try {
                    if (config.scheduleEnabled && config.startTime && !Number.isNaN(config.startTime.getTime())) {
                        const initialDelayMs = Math.max(0, config.startTime.getTime() - Date.now());
                        if (initialDelayMs > 0) {
                            stopBulkSendProgress(`Waiting to start at ${config.startTime.toLocaleString()}...`, 5);
                            await delayWithAbort(initialDelayMs, bulkSendAbortController.signal);
                        }
                    }

                    let batchStartIndex = 0;
                    let totalSentCount = 0;
                    let totalFailedCount = 0;
                    let totalSkippedCount = 0;
                    let queueCount = 0;

                    while (true) {
                        const formData = new FormData(bulkSendForm);
                        formData.set('BatchStartIndex', `${batchStartIndex}`);
                        formData.set('BatchSize', `${ajaxBatchSize}`);
                        formData.set('AggregateSentCount', `${totalSentCount}`);
                        formData.set('AggregateFailedCount', `${totalFailedCount}`);

                        const response = await fetch(bulkSendForm.action, {
                            method: 'POST',
                            body: formData,
                            signal: bulkSendAbortController.signal,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        if (response.redirected) {
                            window.location.href = response.url;
                            return;
                        }

                        const contentType = response.headers.get('content-type') || '';

                        if (!contentType.toLowerCase().includes('application/json')) {
                            const html = await response.text();
                            document.open();
                            document.write(html);
                            document.close();
                            return;
                        }

                        const result = await response.json();

                        if (!response.ok) {
                            throw new Error((result && result.errorMessage) || 'An unexpected error occurred while sending survey emails.');
                        }

                        totalSentCount = typeof result.totalSentCount === 'number' ? result.totalSentCount : totalSentCount;
                        totalFailedCount = typeof result.totalFailedCount === 'number' ? result.totalFailedCount : totalFailedCount;
                        totalSkippedCount = typeof result.totalSkippedCount === 'number' ? result.totalSkippedCount : totalSkippedCount;
                        queueCount = typeof result.queueCount === 'number' ? result.queueCount : queueCount;

                        const processedCount = typeof result.processedCount === 'number'
                            ? result.processedCount
                            : (result.isComplete ? queueCount : batchStartIndex);
                        const percent = queueCount > 0
                            ? Math.min(99, Math.max(5, Math.round((processedCount / queueCount) * 100)))
                            : 95;

                        stopBulkSendProgress(`Sending survey emails... ${processedCount}/${queueCount || processedCount}`, percent);

                        if (result.isComplete) {
                            stopBulkSendProgress(`Bulk send completed. Sent ${totalSentCount}, skipped ${totalSkippedCount}, failed ${totalFailedCount}.`, 100);

                            if (result.redirectUrl) {
                                window.location.href = result.redirectUrl;
                                return;
                            }

                            window.location.reload();
                            return;
                        }

                        batchStartIndex = typeof result.nextBatchStartIndex === 'number'
                            ? result.nextBatchStartIndex
                            : batchStartIndex + ajaxBatchSize;

                        const delayBeforeNextRequestMs = getScheduledDelayBeforeNextRequestMs(config, processedCount, queueCount);
                        if (delayBeforeNextRequestMs > 0) {
                            stopBulkSendProgress(`Scheduled pause... next send in ${formatDuration(delayBeforeNextRequestMs / 1000)}.`, percent);
                            await delayWithAbort(delayBeforeNextRequestMs, bulkSendAbortController.signal);
                        }
                    }
                } catch (error) {
                    if (error && error.name === 'AbortError') {
                        stopBulkSendProgress('Bulk send cancelled.', 0);
                        return;
                    }

                    stopBulkSendProgress('Bulk send failed.', 0);
                    window.alert((error && error.message) || 'An unexpected error occurred while sending survey emails. Please try again.');
                } finally {
                    bulkSendAbortController = null;
                    setBulkSendRunningState(false);
                }
            };

            const applySort = () => {
                if (!tbody) {
                    return;
                }

                const rows = Array.from(tbody.querySelectorAll('tr[data-search]'));
                rows.sort(function (a, b) {
                    let aVal;
                    let bVal;

                    if (sortKey === 'id') {
                        aVal = parseInt(a.getAttribute('data-id') || '0', 10);
                        bVal = parseInt(b.getAttribute('data-id') || '0', 10);
                    } else if (sortKey === 'email') {
                        aVal = a.getAttribute('data-email') || '';
                        bVal = b.getAttribute('data-email') || '';
                    } else {
                        aVal = a.getAttribute('data-company') || '';
                        bVal = b.getAttribute('data-company') || '';
                    }

                    if (aVal < bVal) {
                        return sortDir === 'asc' ? -1 : 1;
                    }
                    if (aVal > bVal) {
                        return sortDir === 'asc' ? 1 : -1;
                    }
                    return 0;
                });

                rows.forEach(function (row) {
                    tbody.appendChild(row);
                });

                setSortButtonText();
                syncUrlState();
            };

            const setActiveFilterButton = () => {
                filterButtons.forEach(function (btn) {
                    const btnFilter = btn.getAttribute('data-filter') || 'all';
                    btn.classList.toggle('active', btnFilter === activeFilter);
                });
            };

            const applyFilters = () => {
                const term = ((searchInput && searchInput.value) || '').toLowerCase().trim();
                const rows = getSearchRows();

                rows.forEach(function (row) {
                    const haystack = row.getAttribute('data-search') || '';
                    const hasEmail = (row.getAttribute('data-has-email') || 'false') === 'true';
                    const surveyEmailSent = (row.getAttribute('data-survey-email-sent') || 'false') === 'true';

                    const matchesSearch = !term || haystack.includes(term);
                    const matchesEmailFilter =
                        activeFilter === 'all' ||
                        (activeFilter === 'has-email' && hasEmail) ||
                        (activeFilter === 'missing-email' && !hasEmail);
                    const matchesSurveyEmailSentFilter =
                        activeSurveyEmailSentFilter === 'all' ||
                        (activeSurveyEmailSentFilter === 'sent' && surveyEmailSent) ||
                        (activeSurveyEmailSentFilter === 'not-sent' && !surveyEmailSent);

                    row.style.display = matchesSearch && matchesEmailFilter && matchesSurveyEmailSentFilter ? '' : 'none';
                });

                syncUrlState();
                updateCounts();
            };

            if (searchInput && searchParam) {
                searchInput.value = searchParam;
            }

            if (filterParam && ['all', 'has-email', 'missing-email'].includes(filterParam)) {
                activeFilter = filterParam;
            }

            if (surveyEmailSentFilterParam && ['all', 'sent', 'not-sent'].includes(surveyEmailSentFilterParam)) {
                activeSurveyEmailSentFilter = surveyEmailSentFilterParam;
            }

            if (surveyEmailSentFilterSelect) {
                surveyEmailSentFilterSelect.value = activeSurveyEmailSentFilter;
            }

            setActiveFilterButton();

            setSortButtonText();

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    applyFilters();
                });
            }

            filterButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    activeFilter = button.getAttribute('data-filter') || 'all';
                    setActiveFilterButton();
                    applyFilters();
                });
            });

            if (surveyEmailSentFilterSelect) {
                surveyEmailSentFilterSelect.addEventListener('change', function () {
                    activeSurveyEmailSentFilter = surveyEmailSentFilterSelect.value || 'all';
                    applyFilters();
                });
            }

            sortButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    const clickedKey = button.getAttribute('data-sort-key') || 'company';
                    if (sortKey === clickedKey) {
                        sortDir = sortDir === 'asc' ? 'desc' : 'asc';
                    } else {
                        sortKey = clickedKey;
                        sortDir = 'asc';
                    }
                    applySort();
                });
            });

            applySort();

            applyFilters();

            if (hasQueryPreselection) {
                saveSelections();
            } else if (preserveSelectionOnNextLoad) {
                restoreSelections();
            }

            revealPreselectedClient();
            updateCounts();

            selectAllBtn.addEventListener('click', function () {
                getVisibleRows().forEach(function (row) {
                    const checkbox = row.querySelector('.client-selector:not([disabled])');
                    if (checkbox) {
                        checkbox.checked = true;
                    }
                });
                saveSelections();
            });

            clearAllBtn.addEventListener('click', function () {
                getCheckboxes().forEach(cb => cb.checked = false);
                if (sendToAllToggle) {
                    sendToAllToggle.checked = false;
                }
                saveSelections();
            });

            if (sendToAllToggle) {
                const applySendToAllSelection = () => {
                    getCheckboxes().forEach(function (cb) {
                        cb.checked = sendToAllToggle.checked;
                    });
                    saveSelections();
                    updateBulkSendConfigInfo();
                };

                sendToAllToggle.addEventListener('change', applySendToAllSelection);

                if (sendToAllToggle.checked) {
                    applySendToAllSelection();
                }
            }

            if (scheduleSettingsToggle) {
                scheduleSettingsToggle.addEventListener('change', function () {
                    updateScheduleSettingsVisibility();
                    updateBulkSendConfigInfo();
                });
            }

            updateScheduleSettingsVisibility();
            updateBulkSendConfigInfo();

            [sendStartTimeInput, splitBulkIntoBatchesInput, breakBetweenGroupsHoursInput, intervalBetweenEmailsInput]
                .filter(Boolean)
                .forEach(function (input) {
                    input.addEventListener('input', updateBulkSendConfigInfo);
                    input.addEventListener('change', updateBulkSendConfigInfo);
                });

            selectableCheckboxes.forEach(function (checkbox) {
                checkbox.addEventListener('change', function () {
                    saveSelections();
                    updateBulkSendConfigInfo();
                });
            });

            if (bulkSendForm) {
                bulkSendForm.addEventListener('submit', function (event) {
                    if (bulkSendInProgress) {
                        return;
                    }

                    const selectedCount = getCheckboxes().filter(cb => cb.checked).length;
                    const recipientCount = sendToAllToggle && sendToAllToggle.checked
                        ? getCheckboxes().length
                        : selectedCount;
                    const selectedMessage = sendToAllToggle && sendToAllToggle.checked
                        ? 'all clients with an email address'
                        : `${selectedCount} selected client${selectedCount === 1 ? '' : 's'}`;

                    event.preventDefault();

                    if (warningTarget) {
                        warningTarget.textContent = selectedMessage;
                    }

                    if (confirmBulkSendBtn) {
                        confirmBulkSendBtn.textContent = `Send to ${recipientCount} Client${recipientCount === 1 ? '' : 's'}`;
                    }

                    if (warningModal) {
                        warningModal.show();
                        return;
                    }

                    const confirmed = window.confirm(`Warning: You are about to send survey emails to ${selectedMessage}. Do you want to continue?`);
                    if (!confirmed) {
                        return;
                    }

                    sessionStorage.setItem(preserveSelectionOnNextLoadKey, 'true');
                    submitBulkSendAsync();
                });
            }

            if (confirmBulkSendBtn && bulkSendForm) {
                confirmBulkSendBtn.addEventListener('click', function () {
                    if (warningModal) {
                        warningModal.hide();
                    }
                    sessionStorage.setItem(preserveSelectionOnNextLoadKey, 'true');
                    submitBulkSendAsync();
                });
            }

            if (stopScheduledSendBtn) {
                stopScheduledSendBtn.addEventListener('click', function () {
                    if (bulkSendAbortController) {
                        bulkSendAbortController.abort();
                    }
                });
            }
        })();
    </script>
}

