@page
@model TINWeb.Pages.Company.IndexModel
@{
    var isImportMode = string.Equals(Model.ShowImportTool, "import", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isImportMode ? "Companies Import" : "Companies";
}

<div class="container-fluid px-0 mt-3">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-info" role="alert">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.IsAdmin && Model.PreviewSummary != null)
    {
        if (!Model.PreviewSummary.HasCurrentSurvey)
        {
            <div class="alert alert-warning" role="alert">
                No current survey is configured, so no preview is available.
            </div>
        }
        else
        {
            <div class="card mb-3 border-warning">
                <div class="card-header bg-warning-subtle">
                    Update Company Info Preview (Current survey year: @Model.PreviewSummary.CurrentSurveyYear)
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-2">FYE values use current survey first, then roll back by year (e.g., Year-1 can fall back to prior survey Last Financial Year; Year-2 can fall back to prior survey Year-1). CEO fields use latest available non-blank survey answers.</p>
                    <p class="mb-2">
                        Matched companies: <strong>@Model.PreviewSummary.TotalMatchedCompanies</strong>
                        &mdash; with revenue answer data: <strong>@Model.PreviewSummary.CompaniesWithRevenueData</strong>,
                        with CEO answer data: <strong>@Model.PreviewSummary.CompaniesWithCeoData</strong>.<br />
                        Companies that would be updated: <strong>@Model.PreviewSummary.WouldUpdateCompanyCount</strong>.
                        @if (Model.PreviewSummary.WouldUpdateCompanyCount == 0 && Model.PreviewSummary.TotalMatchedCompanies > 0)
                        {
                            <br /><span class="text-muted small">No changes detected &mdash; answer data matches existing company values, or no answer data is available for those fields yet.</span>
                        }
                    </p>
                    @if (Model.PreviewSummary.PreviewRows.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Company</th>
                                        <th>CEO First Name</th>
                                        <th>CEO Last Name</th>
                                        <th>Email</th>
                                        <th>FYE Last Financial Year</th>
                                        <th>FYE Year-1</th>
                                        <th>FYE Year-2</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.PreviewSummary.PreviewRows)
                                    {
                                        <tr>
                                            <td>@row.CompanyName (@row.CompanyId)</td>
                                            <td>@(row.NewCeoFirstName != null && row.CurrentCeoFirstName != row.NewCeoFirstName ? $"{row.CurrentCeoFirstName} -> {row.NewCeoFirstName}" : row.CurrentCeoFirstName ?? "")</td>
                                            <td>@(row.NewCeoLastName != null && row.CurrentCeoLastName != row.NewCeoLastName ? $"{row.CurrentCeoLastName} -> {row.NewCeoLastName}" : row.CurrentCeoLastName ?? "")</td>
                                            <td>@(row.NewEmail != null && row.CurrentEmail != row.NewEmail ? $"{row.CurrentEmail} -> {row.NewEmail}" : row.CurrentEmail ?? "")</td>
                                            <td>@(row.CurrentFye2025.HasValue ? string.Format(System.Globalization.CultureInfo.InvariantCulture, "${0:N0}", row.CurrentFye2025.Value) : "") -> @(row.NewFye2025.HasValue ? string.Format(System.Globalization.CultureInfo.InvariantCulture, "${0:N0}", row.NewFye2025.Value) : "")</td>
                                            <td>@(row.CurrentFye2024.HasValue ? string.Format(System.Globalization.CultureInfo.InvariantCulture, "${0:N0}", row.CurrentFye2024.Value) : "") -> @(row.NewFye2024.HasValue ? string.Format(System.Globalization.CultureInfo.InvariantCulture, "${0:N0}", row.NewFye2024.Value) : "")</td>
                                            <td>@(row.CurrentFye2023.HasValue ? string.Format(System.Globalization.CultureInfo.InvariantCulture, "${0:N0}", row.CurrentFye2023.Value) : "") -> @(row.NewFye2023.HasValue ? string.Format(System.Globalization.CultureInfo.InvariantCulture, "${0:N0}", row.NewFye2023.Value) : "")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <p class="small text-muted mt-2 mb-0">Showing up to @Model.PreviewSummary.PreviewRows.Count company change row(s).</p>
                    }
                </div>
            </div>
        }
    }

    @if (Model.IsAdmin && Model.ContactImportPreview != null)
    {
        <div class="card mb-3 border-info">
            <div class="card-body">
                <h5 class="card-title mb-3">Companies Import Preview</h5>
                <p class="mb-1"><strong>Records to update:</strong> @Model.ContactImportPreview.UpdatedCount</p>
                <p class="mb-1"><strong>New records to add:</strong> @Model.ContactImportPreview.InsertedCount</p>
                <p class="mb-3"><strong>Unchanged records:</strong> @Model.ContactImportPreview.UnchangedCount</p>
                <p class="mb-3 text-muted">Matching used: Excel <strong>Company Name</strong> to Company <strong>CompanyName</strong>. Contact fields read from <strong>Contact Person - First Name</strong>, <strong>Contact Person - Last Name</strong>, and <strong>Contact Email</strong>.</p>

                <p class="mb-1"><strong>Matched columns:</strong></p>
                @if (Model.ContactImportPreview.MatchedHeaders.Any())
                {
                    <div class="small text-success mb-3">@string.Join(", ", Model.ContactImportPreview.MatchedHeaders)</div>
                }
                else
                {
                    <div class="small text-muted mb-3">(none)</div>
                }

                <p class="mb-1"><strong>Unmatched columns:</strong></p>
                @if (Model.ContactImportPreview.UnmatchedHeaders.Any())
                {
                    <div class="small text-muted mb-3">@string.Join(", ", Model.ContactImportPreview.UnmatchedHeaders)</div>
                }
                else
                {
                    <div class="small text-muted mb-3">(none)</div>
                }

                @if (Model.ContactImportPreview.MatchedFields.Any())
                {
                    <p class="mb-1"><strong>Matched company fields:</strong></p>
                    <ul class="small text-muted mb-3">
                        @foreach (var matchedField in Model.ContactImportPreview.MatchedFields)
                        {
                            <li>@matchedField</li>
                        }
                    </ul>
                }

                @if (Model.ContactImportPreview.Errors.Any())
                {
                    <p class="mb-1 text-danger"><strong>Preview warnings:</strong></p>
                    <ul class="small text-danger mb-3">
                        @foreach (var error in Model.ContactImportPreview.Errors.Take(20))
                        {
                            <li>@error</li>
                        }
                    </ul>
                }

                @if (Model.ContactImportPreview.PreviewRows.Any())
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 48px;" class="text-center">
                                        <input type="checkbox" id="contactImportSelectAll" checked title="Select all displayed rows" />
                                    </th>
                                    <th>Row</th>
                                    <th>Action</th>
                                    <th>Company</th>
                                    <th>Contact First Name</th>
                                    <th>Contact Last Name</th>
                                    <th>Contact Email</th>
                                    <th>TIN Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.ContactImportPreview.PreviewRows)
                                {
                                    <tr>
                                        <td class="text-center">
                                            <input type="checkbox" class="contact-import-row-checkbox" value="@row.RowNumber" checked />
                                        </td>
                                        <td>@row.RowNumber</td>
                                        <td>@row.Action</td>
                                        <td>
                                            @if (row.ExistingCompanyId.HasValue)
                                            {
                                                <span>#@row.ExistingCompanyId</span>
                                                <span> | @row.CompanyName</span>
                                            }
                                            else
                                            {
                                                <span>@row.CompanyName</span>
                                            }
                                        </td>
                                        <td>@(row.CurrentContactFirstName != row.ImportedContactFirstName ? $"{row.CurrentContactFirstName} -> {row.ImportedContactFirstName}" : row.CurrentContactFirstName ?? "")</td>
                                        <td>@(row.CurrentContactLastName != row.ImportedContactLastName ? $"{row.CurrentContactLastName} -> {row.ImportedContactLastName}" : row.CurrentContactLastName ?? "")</td>
                                        <td>@(row.CurrentContactEmail != row.ImportedContactEmail ? $"{row.CurrentContactEmail} -> {row.ImportedContactEmail}" : row.CurrentContactEmail ?? "")</td>
                                        <td>@(row.CurrentTinStatus != row.ImportedTinStatus ? $"{TINWeb.Models.TinStatusHelper.ToDisplayLabel(row.CurrentTinStatus)} -> {TINWeb.Models.TinStatusHelper.ToDisplayLabel(row.ImportedTinStatus)}" : TINWeb.Models.TinStatusHelper.ToDisplayLabel(row.CurrentTinStatus))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <form method="post" asp-page-handler="ApplyContactImport" class="d-inline" id="applyContactImportForm">
                    <input type="hidden" name="previewToken" value="@Model.PendingContactImportToken" />
                    <input type="hidden" name="tinStatus" value="@Model.SelectedTinStatus" />
                    <input type="hidden" name="showMissingCompanySurveyOnly" value="@Model.ShowMissingCompanySurveyOnly.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="showImportTool" value="@(string.Equals(Model.ShowImportTool, "import", StringComparison.OrdinalIgnoreCase) ? "import" : "contacts")" />
                    <input type="hidden" name="showImportTab" value="contacts" />
                    <input type="hidden" name="contactImportSurveyYear" value="@Model.ContactImportSurveyYear" />
                    <input type="hidden" name="selectedContactImportRows" id="selectedContactImportRows" value="" />
                    <button type="submit" class="btn btn-info text-white">Apply Companies Import</button>
                </form>
            </div>
        </div>
    }

    @if (Model.IsAdmin && Model.GlobalImportPreview != null)
    {
        <div class="card mb-3 border-dark">
            <div class="card-body">
                <h5 class="card-title mb-3">Global Company Import Summary</h5>
                <p class="mb-1"><strong>Import Year for new companies:</strong> @Model.GlobalImportPreview.ImportYear</p>
                <p class="mb-1"><strong>Existing records to update:</strong> @Model.GlobalImportPreview.UpdatedCount</p>
                <p class="mb-1"><strong>New records to add:</strong> @Model.GlobalImportPreview.InsertedCount</p>
                <p class="mb-1"><strong>Unchanged records:</strong> @Model.GlobalImportPreview.UnchangedCount</p>
                <p class="mb-3"><strong>Estimated CompanySurvey records to add:</strong> @Model.GlobalImportPreview.EstimatedCompanySurveyCreatedCount</p>
                @if (Model.GlobalImportPreview.InsertedCount == 0
                    && Model.GlobalImportPreview.UpdatedCount == 0
                    && Model.GlobalImportPreview.EstimatedCompanySurveyCreatedCount > 0)
                {
                    <div class="alert alert-warning py-2" role="alert">
                        No company rows will be added or updated, but applying this import is still expected to create @Model.GlobalImportPreview.EstimatedCompanySurveyCreatedCount CompanySurvey record(s) for the selected import year.
                    </div>
                }
                <p class="mb-3 text-muted">Matching used: Excel <strong>External ID</strong> to Company <strong>ExternalId</strong>, then fallback Excel <strong>Company Name</strong> to Company <strong>CompanyName</strong> when the External ID does not match an existing company.</p>

                <p class="mb-1"><strong>Matched columns:</strong></p>
                @if (Model.GlobalImportPreview.MatchedHeaders.Any())
                {
                    <div class="small text-success mb-3">@string.Join(", ", Model.GlobalImportPreview.MatchedHeaders)</div>
                }
                else
                {
                    <div class="small text-muted mb-3">(none)</div>
                }

                <p class="mb-1"><strong>Unmatched columns:</strong></p>
                @if (Model.GlobalImportPreview.UnmatchedHeaders.Any())
                {
                    <div class="small text-muted mb-3">@string.Join(", ", Model.GlobalImportPreview.UnmatchedHeaders)</div>
                }
                else
                {
                    <div class="small text-muted mb-3">(none)</div>
                }

                @if (Model.GlobalImportPreview.MatchedFields.Any())
                {
                    <p class="mb-1"><strong>Matched company fields:</strong></p>
                    <ul class="small text-muted mb-3">
                        @foreach (var matchedField in Model.GlobalImportPreview.MatchedFields)
                        {
                            <li>@matchedField</li>
                        }
                    </ul>
                }

                @if (Model.GlobalImportPreview.Errors.Any())
                {
                    <p class="mb-1 text-danger"><strong>Preview warnings:</strong></p>
                    <ul class="small text-danger mb-3">
                        @foreach (var error in Model.GlobalImportPreview.Errors.Take(20))
                        {
                            <li>@error</li>
                        }
                    </ul>
                }

                @if (Model.GlobalImportPreview.PreviewRows.Any())
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Row</th>
                                    <th>Action</th>
                                    <th>Existing Record</th>
                                    <th>Imported External ID</th>
                                    <th>Imported Company Name</th>
                                    <th>Imported Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.GlobalImportPreview.PreviewRows)
                                {
                                    <tr>
                                        <td>@row.RowNumber</td>
                                        <td>@row.Action</td>
                                        <td>
                                            @if (row.ExistingCompanyId.HasValue)
                                            {
                                                <span>#@row.ExistingCompanyId</span>
                                                <span> | @row.ExistingCompanyName</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">New record</span>
                                            }
                                        </td>
                                        <td>@(row.ImportedExternalId ?? "")</td>
                                        <td>@(row.ImportedCompanyName ?? "")</td>
                                        <td>@(row.ImportedCompanyDescription ?? "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <form method="post" asp-page-handler="ApplyGlobalImport" class="d-inline" id="applyGlobalImportForm">
                    <input type="hidden" name="previewToken" value="@Model.PendingGlobalImportToken" />
                    <input type="hidden" name="tinStatus" value="@Model.SelectedTinStatus" />
                    <input type="hidden" name="showTestCompanies" value="@Model.ShowTestCompanies.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="showMissingCompanySurveyOnly" value="@Model.ShowMissingCompanySurveyOnly.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="showImportTool" value="@(string.Equals(Model.ShowImportTool, "import", StringComparison.OrdinalIgnoreCase) ? "import" : "global")" />
                    <input type="hidden" name="showImportTab" value="global" />
                    <button type="submit" class="btn btn-dark">Apply Global Import</button>
                </form>
            </div>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-8">
            <h1>@(isImportMode ? $"Companies Import ({Model.Records.Count})" : $"Companies ({Model.Records.Count})")</h1>
        </div>
        <div class="col-md-4 text-end">
            <div class="d-inline-flex align-items-center gap-2 flex-wrap justify-content-end">
                @if (!isImportMode)
                {
                    @if (Model.IsAdmin)
                    {
                        <form method="post" asp-page-handler="PreviewResetFyeValues" class="d-inline">
                            <input type="hidden" name="lastTin200Year" value="@Model.SelectedLastTin200Year" />
                            <input type="hidden" name="companySearch" value="@Model.CompanySearch" />
                            <input type="hidden" name="showTestCompanies" value="@Model.ShowTestCompanies.ToString().ToLowerInvariant()" />
                            <input type="hidden" name="showMissingCompanySurveyOnly" value="@Model.ShowMissingCompanySurveyOnly.ToString().ToLowerInvariant()" />
                            <button type="submit" class="btn btn-outline-secondary me-2" id="companyResetPreviewButton">Preview Summary</button>
                        </form>
                        <form method="post" asp-page-handler="ResetFyeValues" class="d-inline" onsubmit="return confirm('Update company info (CEO name, email, FYE Last Financial Year / Year-1 / Year-2) from survey answers? This will overwrite existing values.');">
                            <input type="hidden" name="lastTin200Year" value="@Model.SelectedLastTin200Year" />
                            <input type="hidden" name="companySearch" value="@Model.CompanySearch" />
                            <input type="hidden" name="showTestCompanies" value="@Model.ShowTestCompanies.ToString().ToLowerInvariant()" />
                            <input type="hidden" name="showMissingCompanySurveyOnly" value="@Model.ShowMissingCompanySurveyOnly.ToString().ToLowerInvariant()" />
                            <button type="submit" class="btn btn-outline-warning me-2" id="companyResetButton">Update Company Info</button>
                        </form>
                    }
                    <a asp-page="./Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Add New Record
                    </a>
                }
            </div>
        </div>
    </div>

    @{
        var isCombinedImportMode = string.Equals(Model.ShowImportTool, "import", StringComparison.OrdinalIgnoreCase);
        var activeImportTab = string.Equals(Model.ShowImportTab, "global", StringComparison.OrdinalIgnoreCase) ? "global" : "contacts";
    }

    @if (isCombinedImportMode)
    {
        @if (!Model.IsAdmin)
        {
            <div class="alert alert-warning" role="alert">Companies import is available to admin users only.</div>
        }
        else
        {
            <div class="card mb-3 border-secondary">
                <div class="card-body">
                    <h5 class="card-title mb-3">Import Companies</h5>
                    <ul class="nav nav-tabs" id="companyImportTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(activeImportTab == "contacts" ? "active" : null)" id="company-import-contacts-tab" data-bs-toggle="tab" data-bs-target="#company-import-contacts-pane" type="button" role="tab" aria-controls="company-import-contacts-pane" aria-selected="@(activeImportTab == "contacts" ? "true" : "false")">Companies Generic</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(activeImportTab == "global" ? "active" : null)" id="company-import-global-tab" data-bs-toggle="tab" data-bs-target="#company-import-global-pane" type="button" role="tab" aria-controls="company-import-global-pane" aria-selected="@(activeImportTab == "global" ? "true" : "false")">Global</button>
                        </li>
                    </ul>

                    <div class="tab-content border border-top-0 rounded-bottom p-3" id="companyImportTabsContent">
                        <div class="tab-pane fade @(activeImportTab == "contacts" ? "show active" : null)" id="company-import-contacts-pane" role="tabpanel" aria-labelledby="company-import-contacts-tab" tabindex="0">
                            <form method="post" asp-page-handler="LoadContactImportHeaders" enctype="multipart/form-data" class="d-inline-flex align-items-center gap-2 flex-wrap" id="contactImportLoadForm">
                                <input type="hidden" name="lastTin200Year" value="@Model.SelectedLastTin200Year" />
                                <input type="hidden" name="tinStatus" value="@Model.SelectedTinStatus" />
                                <input type="hidden" name="companySearch" value="@Model.CompanySearch" />
                                <input type="hidden" name="showTestCompanies" value="@Model.ShowTestCompanies.ToString().ToLowerInvariant()" />
                                <input type="hidden" name="showMissingCompanySurveyOnly" value="@Model.ShowMissingCompanySurveyOnly.ToString().ToLowerInvariant()" />
                                <input type="hidden" name="showImportTool" value="import" />
                                <input type="hidden" name="showImportTab" value="contacts" />
                                <input type="number" name="contactImportSurveyYear" value="@Model.ContactImportSurveyYear" class="form-control form-control-sm" style="max-width: 140px;" placeholder="Survey Year" min="1900" max="9999" required />
                                <input type="file" name="importFile" accept=".xlsx" class="form-control form-control-sm" style="max-width: 320px;" />
                                <button type="submit" class="btn btn-info text-white btn-sm">Load Headers</button>
                            </form>

                        @if (Model.ContactImportHeaders.Any())
                        {
                            <hr class="my-3" />
                            <p class="small text-muted mb-3">Map your Excel headers to Company contact fields, then preview the import. You can save the mapping as a JSON file and load it later.</p>

                            <form method="post" asp-page-handler="PreviewContactImport" class="row g-2 align-items-end" id="contactImportForm">
                                <input type="hidden" name="lastTin200Year" value="@Model.SelectedLastTin200Year" />
                                <input type="hidden" name="tinStatus" value="@Model.SelectedTinStatus" />
                                <input type="hidden" name="companySearch" value="@Model.CompanySearch" />
                                <input type="hidden" name="showTestCompanies" value="@Model.ShowTestCompanies.ToString().ToLowerInvariant()" />
                                <input type="hidden" name="showMissingCompanySurveyOnly" value="@Model.ShowMissingCompanySurveyOnly.ToString().ToLowerInvariant()" />
                                <input type="hidden" name="showImportTool" value="import" />
                                <input type="hidden" name="showImportTab" value="contacts" />
                                <input type="hidden" asp-for="ContactImportMappingToken" />

                                <div class="col-md-3">
                                    <label asp-for="ContactImportSurveyYear" class="form-label">Survey Year (required)</label>
                                    <input asp-for="ContactImportSurveyYear" class="form-control form-control-sm" type="number" min="1900" max="9999" required />
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="ContactMapCompanyNameHeader" class="form-label">Company Name (required)</label>
                                    <select asp-for="ContactMapCompanyNameHeader" class="form-select form-select-sm">
                                        <option value="">Select header</option>
                                        @foreach (var h in Model.ContactImportHeaders)
                                        {
                                            <option value="@h">@h</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="ContactMapFirstNameHeader" class="form-label">Contact First Name</label>
                                    <select asp-for="ContactMapFirstNameHeader" class="form-select form-select-sm">
                                        <option value="">(not mapped)</option>
                                        @foreach (var h in Model.ContactImportHeaders)
                                        {
                                            <option value="@h">@h</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="ContactMapLastNameHeader" class="form-label">Contact Last Name</label>
                                    <select asp-for="ContactMapLastNameHeader" class="form-select form-select-sm">
                                        <option value="">(not mapped)</option>
                                        @foreach (var h in Model.ContactImportHeaders)
                                        {
                                            <option value="@h">@h</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="ContactMapEmailHeader" class="form-label">Contact Email</label>
                                    <select asp-for="ContactMapEmailHeader" class="form-select form-select-sm">
                                        <option value="">(not mapped)</option>
                                        @foreach (var h in Model.ContactImportHeaders)
                                        {
                                            <option value="@h">@h</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="ContactImportTinStatus" class="form-label">TIN Status</label>
                                    <select asp-for="ContactImportTinStatus" class="form-select form-select-sm">
                                        <option value="">Blank</option>
                                        @foreach (var option in TINWeb.Models.TinStatusHelper.DropdownOptions)
                                        {
                                            <option value="@option.Value">@option.Label</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-12 d-flex gap-2 flex-wrap mt-2">
                                    <button type="submit" class="btn btn-info text-white btn-sm">Preview Companies Import</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" id="saveContactMappingBtn">Save Mapping File</button>
                                    <input type="file" id="contactMappingFile" accept="application/json,.json" class="form-control form-control-sm" style="max-width: 240px;" />
                                    <button type="button" class="btn btn-outline-secondary btn-sm" id="loadContactMappingBtn">Load Mapping File</button>
                                </div>
                            </form>
                        }
                    </div>

                    <div class="tab-pane fade @(activeImportTab == "global" ? "show active" : null)" id="company-import-global-pane" role="tabpanel" aria-labelledby="company-import-global-tab" tabindex="0">
                        <form method="post" asp-page-handler="PreviewGlobalImport" enctype="multipart/form-data" class="d-inline-flex align-items-center gap-2 flex-wrap" id="globalImportForm">
                            <input type="hidden" name="lastTin200Year" value="@Model.SelectedLastTin200Year" />
                            <input type="hidden" name="tinStatus" value="@Model.SelectedTinStatus" />
                            <input type="hidden" name="companySearch" value="@Model.CompanySearch" />
                            <input type="hidden" name="showTestCompanies" value="@Model.ShowTestCompanies.ToString().ToLowerInvariant()" />
                            <input type="hidden" name="showMissingCompanySurveyOnly" value="@Model.ShowMissingCompanySurveyOnly.ToString().ToLowerInvariant()" />
                            <input type="hidden" name="showImportTool" value="import" />
                            <input type="hidden" name="showImportTab" value="global" />
                            <input type="number" name="importYear" value="@Model.SelectedImportYear" class="form-control form-control-sm" style="max-width: 120px;" placeholder="Import Year" min="1900" max="9999" />
                            <input type="file" name="importFile" accept=".xlsx" class="form-control form-control-sm" style="max-width: 320px;" />
                            <button type="submit" class="btn btn-dark btn-sm">Preview Global Import</button>
                        </form>
                    </div>
                    </div>
            </div>
        </div>
        }
    }

    <div class="row mb-3">
        <div class="col-12">
            <form method="get" class="d-flex" id="companyFilterForm">
                @if (isImportMode)
                {
                    <input type="hidden" name="showImportTool" value="import" />
                    <input type="hidden" name="showImportTab" value="@activeImportTab" />
                }
                <label class="me-2 align-self-center">Filter Last TIN200 Year:</label>
                <select name="lastTin200Year" class="form-select me-2" aria-label="Last TIN200 Year">
                    <option value="">All</option>
                    @foreach (var y in Model.AvailableLastTin200Years)
                    {
                        <option value="@y" selected="@(Model.SelectedLastTin200Year == y ? "selected" : null)">@y</option>
                    }
                </select>
                <label class="me-2 align-self-center">TIN Status:</label>
                <select name="tinStatus" class="form-select me-2" aria-label="TIN Status" style="max-width: 220px;">
                    <option value="" selected="@(!Model.SelectedTinStatus.HasValue ? "selected" : null)">Blank</option>
                    @foreach (var option in TINWeb.Models.TinStatusHelper.DropdownOptions)
                    {
                        <option value="@option.Value" selected="@(Model.SelectedTinStatus.HasValue && Model.SelectedTinStatus.Value == option.Value ? "selected" : null)">@option.Label</option>
                    }
                </select>
                <input type="text" name="companySearch" value="@Model.CompanySearch" class="form-control me-2" style="max-width: 340px;" placeholder="Company name or External ID" />
                <div class="form-check form-check-inline me-2 align-self-center" style="white-space: nowrap;">
                    <input class="form-check-input" type="checkbox" id="showMissingCompanySurveyOnly" name="showMissingCompanySurveyOnly" value="true" checked="@(Model.ShowMissingCompanySurveyOnly ? "checked" : null)" />
                    <label class="form-check-label" for="showMissingCompanySurveyOnly">Show only missing</label>
                </div>
                <button class="btn btn-outline-primary" type="submit">Apply</button>
                @if (!isImportMode)
                {
                    <button class="btn btn-success ms-2" id="companyExportButton" type="submit" formaction="@Url.Page("./Export")">Export</button>
                    <button class="btn btn-outline-success ms-2" id="companySmExportButton" type="submit" formaction="@Url.Page("./ExportSurveyMonkey")">SM Export</button>
                    <button class="btn btn-outline-info ms-2" type="submit" formaction="@Url.Page("./ExportMailerlite")">Export - Mailerlite</button>
                }
            </form>
        </div>
    </div>

    <div id="companyExportProgressContainer" class="mb-3" style="display:none;">
        <div class="d-flex justify-content-between small mb-1">
            <span id="companyExportProgressLabel">Exporting companies...</span>
            <span id="companyExportProgressPercent">0%</span>
        </div>
        <div class="progress" role="progressbar" aria-label="Company export progress" aria-valuemin="0" aria-valuemax="100">
            <div id="companyExportProgressBar" class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%"></div>
        </div>
    </div>

    @if (Model.Records.Any())
    {
        @if (Model.LatestSurveyYear.HasValue)
        {
            <div class="alert @(Model.MissingCompanySurveyCount > 0 ? "alert-warning" : "alert-success") py-2" role="alert">
                Latest survey year <strong>@Model.LatestSurveyYear.Value</strong>:
                <strong>@Model.MissingCompanySurveyCount</strong> of <strong>@Model.Records.Count</strong>
                visible compan@(Model.Records.Count == 1 ? "y" : "ies")
                @(Model.MissingCompanySurveyCount == 1 ? "is" : "are") missing a CompanySurvey record.
            </div>
        }
        else
        {
            <div class="alert alert-secondary py-2" role="alert">
                No survey year is configured yet, so CompanySurvey missing status is not available.
            </div>
        }

        <div class="table-responsive">
            <table class="table table-striped table-hover company-table">
                <thead class="table-dark">
                    <tr>
                        <th class="sortable" data-type="number">ID</th>
                        <th class="sortable" data-type="string">Company Name</th>
                        <th class="sortable" data-type="string">Contact Name</th>
                        <th class="sortable" data-type="string">Contact Email</th>
                        <th class="sortable" data-type="string">External ID</th>
                        <th class="sortable" data-type="number">FYE Last Financial Year</th>
                        <th class="sortable" data-type="number">FYE Year-1</th>
                        <th class="sortable" data-type="number">FYE Year-2</th>
                        <th class="sortable" data-type="number">Financial Year</th>
                        <th class="sortable" data-type="number">Last TIN200 Year</th>
                        <th class="sortable" data-type="string">Test</th>
                        <th class="sortable" data-type="string">Latest Survey Record</th>
                        <th class="actions-header">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.Records)
                    {
                        <tr id="company-row-@record.Id">
                            <td>@record.Id</td>
                            <td>@record.CompanyName</td>
                            <td>@($"{record.ContactFirstName} {record.ContactLastName}".Trim())</td>
                            <td>@record.ContactEmail</td>
                            <td>@record.ExternalId</td>
                            <td>@(record.Fye2025.HasValue ? string.Format(System.Globalization.CultureInfo.InvariantCulture, "${0:N0}", record.Fye2025.Value) : "")</td>
                            <td>@(record.Fye2024.HasValue ? string.Format(System.Globalization.CultureInfo.InvariantCulture, "${0:N0}", record.Fye2024.Value) : "")</td>
                            <td>@(record.Fye2023.HasValue ? string.Format(System.Globalization.CultureInfo.InvariantCulture, "${0:N0}", record.Fye2023.Value) : "")</td>
                            <td>@record.FinancialYear</td>
                            <td>@record.LastTIN200Year</td>
                            <td>@(TINWeb.Models.TinStatusHelper.IsTestCompany(record.TinStatus) ? "Yes" : "No")</td>
                            <td>
                                @if (!Model.LatestSurveyYear.HasValue)
                                {
                                    <span class="badge text-bg-secondary">N/A</span>
                                }
                                else if (Model.MissingCompanySurveyCompanyIds.Contains(record.Id))
                                {
                                    <span class="badge text-bg-warning">Missing</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">Exists</span>
                                }
                            </td>
                            <td class="actions-col">
                                <a asp-page="./Details" asp-route-id="@record.Id" class="btn btn-sm btn-info">View</a>
                                <a asp-page="./Edit" asp-route-id="@record.Id" asp-route-lastTin200Year="@Model.SelectedLastTin200Year" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-page="./SurveyHistory" asp-route-id="@record.Id" class="btn btn-sm btn-outline-secondary">Survey History</a>
                                <a asp-page="./SendSurvey" asp-route-id="@record.Id" class="btn btn-sm btn-primary">Survey</a>
                                <a asp-page="./Delete" asp-route-id="@record.Id" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <strong>No records found.</strong> <a asp-page="./Create">Create the first record</a>
        </div>
    }
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }
</style>
<style>
    .sortable { cursor: pointer; }
    .sortable:after { content: '\25B4\25BE'; font-size: 0.6rem; color: #ddd; padding-left: 6px; }
    .sortable.sorted-asc:after { content: '\25B4'; color: #444; }
    .sortable.sorted-desc:after { content: '\25BE'; color: #444; }
</style>

<script>
    (function(){
        function parseValue(val, type){
            if (!val) return null;
            val = val.trim();
            if (type === 'number'){
                var n = parseFloat(val.replace(/,/g,''));
                return isNaN(n) ? null : n;
            }
            return val.toLowerCase();
        }

        function sortTable(table, colIndex, type, asc){
            var tbody = table.tBodies[0];
            var rows = Array.from(tbody.querySelectorAll('tr'));
            rows.sort(function(a,b){
                var aText = a.children[colIndex].innerText || '';
                var bText = b.children[colIndex].innerText || '';
                var aVal = parseValue(aText, type);
                var bVal = parseValue(bText, type);
                if (aVal === null && bVal === null) return 0;
                if (aVal === null) return 1;
                if (bVal === null) return -1;
                if (aVal < bVal) return asc ? -1 : 1;
                if (aVal > bVal) return asc ? 1 : -1;
                return 0;
            });
            rows.forEach(function(r){ tbody.appendChild(r); });
        }

        document.addEventListener('DOMContentLoaded', function(){
            var table = document.querySelector('.company-table');
            if (!table) return;
            var headers = table.querySelectorAll('th.sortable');
            headers.forEach(function(h){
                var colIndex = Array.prototype.indexOf.call(h.parentNode.children, h);
                var type = h.getAttribute('data-type') || 'string';
                var asc = true;
                h.addEventListener('click', function(){
                    headers.forEach(function(h2){ h2.classList.remove('sorted-asc','sorted-desc'); });
                    sortTable(table, colIndex, type, asc);
                    h.classList.add(asc ? 'sorted-asc' : 'sorted-desc');
                    asc = !asc;
                });
            });
        });
    })();
</script>
<script>
    (function () {
        const form = document.getElementById('companyFilterForm');
        const exportButton = document.getElementById('companyExportButton');
        const smExportButton = document.getElementById('companySmExportButton');
        const previewButton = document.getElementById('companyResetPreviewButton');
        const previewForm = previewButton ? previewButton.closest('form') : null;
        const resetButton = document.getElementById('companyResetButton');
        const resetForm = resetButton ? resetButton.closest('form') : null;
        const progressContainer = document.getElementById('companyExportProgressContainer');
        const progressBar = document.getElementById('companyExportProgressBar');
        const progressPercent = document.getElementById('companyExportProgressPercent');
        const progressLabel = document.getElementById('companyExportProgressLabel');

        if (!form || !progressContainer || !progressBar || !progressPercent || !progressLabel) {
            return;
        }

        let timerId = null;

        function startProgress(labelText) {
            if (timerId) {
                window.clearInterval(timerId);
            }

            let value = 8;
            progressLabel.textContent = labelText;
            progressContainer.style.display = '';

            function render() {
                progressBar.style.width = value + '%';
                progressPercent.textContent = value + '%';
            }

            render();

            timerId = window.setInterval(function () {
                if (value < 90) {
                    value += 4;
                    render();
                }
            }, 250);
        }

        form.addEventListener('submit', function (event) {
            if (!event.submitter) {
                return;
            }

            if (exportButton && event.submitter.id === 'companyExportButton') {
                startProgress('Exporting companies...');
            }

            if (smExportButton && event.submitter.id === 'companySmExportButton') {
                startProgress('Exporting SurveyMonkey file...');
            }
        });

        if (resetForm && resetButton) {
            resetForm.addEventListener('submit', function () {
                startProgress('Resetting FYE values...');
            });
        }

        if (previewForm && previewButton) {
            previewForm.addEventListener('submit', function () {
                startProgress('Building reset preview...');
            });
        }

        var globalImportForm = document.getElementById('globalImportForm');
        if (globalImportForm) {
            globalImportForm.addEventListener('submit', function () {
                startProgress('Reading file and building import preview...');
            });
        }

        var contactImportLoadForm = document.getElementById('contactImportLoadForm');
        if (contactImportLoadForm) {
            contactImportLoadForm.addEventListener('submit', function () {
                startProgress('Reading companies import headers...');
            });
        }

        var contactImportForm = document.getElementById('contactImportForm');
        if (contactImportForm) {
            contactImportForm.addEventListener('submit', function () {
                startProgress('Building companies import preview...');
            });
        }

        var applyGlobalImportForm = document.getElementById('applyGlobalImportForm');
        if (applyGlobalImportForm) {
            applyGlobalImportForm.addEventListener('submit', function () {
                startProgress('Applying global company import...');
            });
        }

        var applyContactImportForm = document.getElementById('applyContactImportForm');
        var selectAllContactImportRows = document.getElementById('contactImportSelectAll');
        var selectedContactImportRowsField = document.getElementById('selectedContactImportRows');

        function getContactImportRowCheckboxes() {
            return Array.from(document.querySelectorAll('.contact-import-row-checkbox'));
        }

        function updateSelectedContactImportRowsField() {
            if (!selectedContactImportRowsField) {
                return;
            }

            var rowCheckboxes = getContactImportRowCheckboxes();
            var selectedValues = rowCheckboxes
                .filter(function (checkbox) { return checkbox.checked; })
                .map(function (checkbox) { return checkbox.value; });

            // Empty payload means "apply all rows from the import file" on the server.
            if (rowCheckboxes.length > 0 && selectedValues.length === rowCheckboxes.length) {
                selectedContactImportRowsField.value = '';
                return;
            }

            selectedContactImportRowsField.value = selectedValues.join(',');
        }

        if (selectAllContactImportRows) {
            selectAllContactImportRows.addEventListener('change', function () {
                getContactImportRowCheckboxes().forEach(function (checkbox) {
                    checkbox.checked = !!selectAllContactImportRows.checked;
                });
                updateSelectedContactImportRowsField();
            });
        }

        getContactImportRowCheckboxes().forEach(function (checkbox) {
            checkbox.addEventListener('change', function () {
                var allChecked = getContactImportRowCheckboxes().every(function (rowCheckbox) { return rowCheckbox.checked; });
                if (selectAllContactImportRows) {
                    selectAllContactImportRows.checked = allChecked;
                }
                updateSelectedContactImportRowsField();
            });
        });

        updateSelectedContactImportRowsField();

        if (applyContactImportForm) {
            applyContactImportForm.addEventListener('submit', function () {
                updateSelectedContactImportRowsField();
                startProgress('Applying companies import...');
            });
        }

        var saveContactMappingBtn = document.getElementById('saveContactMappingBtn');
        var loadContactMappingBtn = document.getElementById('loadContactMappingBtn');
        var contactMappingFile = document.getElementById('contactMappingFile');
        var companyField = document.getElementById('ContactMapCompanyNameHeader');
        var firstField = document.getElementById('ContactMapFirstNameHeader');
        var lastField = document.getElementById('ContactMapLastNameHeader');
        var emailField = document.getElementById('ContactMapEmailHeader');
        var tinStatusField = document.getElementById('ContactImportTinStatus');

        if (saveContactMappingBtn && companyField && firstField && lastField && emailField && tinStatusField) {
            saveContactMappingBtn.addEventListener('click', function () {
                var payload = {
                    mappingType: 'company-contact-import',
                    version: 1,
                    companyNameHeader: companyField.value || '',
                    contactFirstNameHeader: firstField.value || '',
                    contactLastNameHeader: lastField.value || '',
                    contactEmailHeader: emailField.value || '',
                    applyTinStatus: true,
                    tinStatus: tinStatusField.value === '' ? null : Number(tinStatusField.value)
                };

                var blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = 'company-contact-import-mapping.json';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            });
        }

        if (loadContactMappingBtn && contactMappingFile && companyField && firstField && lastField && emailField && tinStatusField) {
            loadContactMappingBtn.addEventListener('click', function () {
                var file = contactMappingFile.files && contactMappingFile.files.length ? contactMappingFile.files[0] : null;
                if (!file) {
                    alert('Select a mapping JSON file first.');
                    return;
                }

                var reader = new FileReader();
                reader.onload = function () {
                    try {
                        var data = JSON.parse(reader.result);
                        companyField.value = data.companyNameHeader || '';
                        firstField.value = data.contactFirstNameHeader || '';
                        lastField.value = data.contactLastNameHeader || '';
                        emailField.value = data.contactEmailHeader || '';
                        tinStatusField.value = data.tinStatus === null || data.tinStatus === undefined ? '' : String(data.tinStatus);
                    } catch (error) {
                        alert('Invalid mapping file. Please choose a valid JSON mapping file.');
                    }
                };
                reader.readAsText(file);
            });
        }
    })();
</script>

<!-- Focus on edited company row -->
<script>
    (function() {
        const focusId = @(Model.FocusId != null ? Model.FocusId.Value.ToString() : "null");
        
        if (focusId !== null) {
            const rowElement = document.getElementById('company-row-' + focusId);
            if (rowElement) {
                // Add highlight class
                rowElement.classList.add('focused-row');
                
                // Scroll into view with smooth behavior
                rowElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
                
                // Remove highlight after 3 seconds
                setTimeout(function() {
                    rowElement.classList.remove('focused-row');
                }, 3000);
            }
        }
    })();
</script>

