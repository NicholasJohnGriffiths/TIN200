@page "{id:int}/{token?}"
@model TINWeb.Pages.Company.AnswerSurveyModel
@{
    ViewData["Title"] = "Survey Answers";
    Layout = "_SurveyLayout";
}

<style>
    .survey-table-cell {
        min-width: 150px;
        max-width: 240px;
        padding: 0.4rem;
        font-size: 0.95rem;
        vertical-align: top;
    }

    .survey-table-header-cell {
        min-width: 150px;
        max-width: 240px;
        padding: 0.35rem 0.4rem;
        vertical-align: bottom;
    }

    .survey-table-question {
        font-size: 0.9rem;
        font-weight: 600;
        line-height: 1.2;
        margin-bottom: 0;
    }

    .survey-table-inline-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
    }

    .survey-table-question-wrap {
        flex: 0 0 30%;
        min-width: 72px;
    }

    .survey-table-answer-wrap {
        flex: 1 1 46%;
        min-width: 96px;
    }

    .survey-table-prev-inline {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        flex: 0 0 auto;
        min-width: 82px;
        padding-left: 0.2rem;
        text-align: right;
    }

    .survey-table-cell .form-control,
    .survey-table-cell .form-select {
        font-size: 0.9rem;
        padding: 0.2rem 0.35rem;
        min-height: calc(1.5em + 0.45rem + 2px);
    }

    .survey-table-compact-input {
        max-width: 8rem;
    }

    .survey-table-cell .form-check {
        margin-bottom: 0.15rem;
    }

    .survey-table-cell .form-check-label,
    .survey-table-prev-label,
    .survey-table-prev-value {
        font-size: 0.875rem;
        line-height: 1.2;
    }

    .survey-table-prev-label {
        flex: 0 0 auto;
        font-weight: 500;
    }

    .survey-table-prev-value {
        white-space: nowrap;
    }

    .survey-table-multichoice {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .survey-table-multichoice .form-check {
        display: flex;
        align-items: flex-start;
        gap: 0.3rem;
        min-height: 0;
        padding-left: 0;
        margin: 0;
    }

    .survey-table-multichoice .form-check-input {
        float: none;
        margin: 0.08rem 0 0;
    }

    .survey-table-multichoice .form-check-label {
        word-break: break-word;
    }

    .survey-table-prev {
        margin-top: 0;
        padding-top: 0;
        border-top: 0;
    }

    .survey-table-copy-btn {
        font-size: 0.825rem;
        padding: 0.1rem 0.35rem;
        line-height: 1.2;
        flex: 0 0 auto;
    }

    .survey-table-controls-row {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        row-gap: 0.35rem;
        flex: 0 0 auto;
    }

    .survey-table-cell.survey-table-tall-cell .survey-table-inline-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: auto auto;
        row-gap: 0.5rem;
        align-items: start;
    }

    .survey-table-cell.survey-table-tall-cell .survey-table-answer-wrap {
        grid-row: 1;
        min-width: 0;
        width: 100%;
    }

    .survey-table-cell.survey-table-tall-cell .survey-table-controls-row {
        grid-row: 2;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        column-gap: 0.65rem;
        min-height: 1.9rem;
        width: 100%;
        min-width: 0;
    }

    .survey-table-cell.survey-table-tall-cell .survey-table-prev-inline {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        min-width: 0;
        width: 100%;
        padding-left: 0;
        text-align: left;
        overflow: hidden;
    }

    .survey-table-cell.survey-table-tall-cell .survey-table-prev-value {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .survey-table-cell.survey-table-tall-cell .survey-table-copy-btn {
        margin-left: 0;
        justify-self: end;
        padding: 0.16rem 0.5rem;
    }

    .survey-subgroup-table {
        table-layout: fixed;
    }

    .survey-subgroup-title {
        font-size: 1rem;
        margin-bottom: 0.35rem;
    }

    @@media (max-width: 767.98px) {
        .survey-table-inline-row {
            flex-wrap: wrap;
            align-items: flex-start;
        }

        .survey-table-question-wrap,
        .survey-table-answer-wrap,
        .survey-table-prev-inline {
            flex: 1 1 100%;
            min-width: 0;
            text-align: left;
        }

        .survey-table-stack,
        .survey-table-stack tbody,
        .survey-table-stack tr,
        .survey-table-stack td {
            display: block;
            width: 100%;
        }

        .survey-table-stack tr {
            margin-bottom: 0.75rem;
        }

        .survey-table-stack td {
            max-width: none;
            margin-bottom: -1px;
        }
    }
</style>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="mb-3 text-center">
                @if (!string.IsNullOrWhiteSpace(Model.SurveyHeaderImageUrl))
                {
                    <img src="@Model.SurveyHeaderImageUrl" alt="Survey Header" class="img-fluid" />
                }
            </div>
            <h1>Survey Answers</h1>
            <p class="text-muted">Please complete the survey answers for the current survey year.</p>
            <hr />

            @if (Model.Submitted)
            {
                <div class="alert alert-success" role="alert">
                    Thank you. Your survey has been submitted successfully.
                </div>
            }
            else if (Model.Saved)
            {
                <div class="alert alert-info" role="alert">
                    Your answers have been saved.
                </div>
            }
            @if (Model.IsLocked)
            {
                <div class="alert alert-warning" role="alert">
                    This survey record is locked. Data changes are disabled. Please contact the Technology Investment Network.
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="alert alert-light border d-flex justify-content-between align-items-center py-2 mb-3">
                <div class="fw-semibold" id="currentSectionHeader">Section 1 of 1</div>
                <div class="small text-body-secondary" id="currentSectionSubheader"></div>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label mb-0">Progress</label>
                    <span id="surveyProgressText" class="small text-body-secondary">0 / 0 progressed</span>
                </div>
                <div class="progress" role="progressbar" aria-label="Survey completion progress" aria-valuemin="0" aria-valuemax="100">
                    <div id="surveyProgressBar" class="progress-bar" style="width: 0%">0%</div>
                </div>
            </div>

            <form method="post" asp-route-id="@Model.Company.Id" asp-route-token="@Model.Token">
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="CompanyId" />
                <input type="hidden" asp-for="CurrentGroupIndex" id="CurrentGroupIndex" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Company Name</label>
                        <input class="form-control bg-light" value="@Model.Company.CompanyName" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Financial Year</label>
                        <input class="form-control bg-light" value="@Model.FinancialYear" readonly />
                    </div>
                </div>

                @{
                    var sectionIndexByKey = new Dictionary<string, int>(StringComparer.Ordinal);
                    var sectionTitles = new List<string>();
                    var sectionDescriptions = new List<string>();
                    var sectionGroupIds = new List<int?>();
                    var sectionImageId1 = new List<int?>();
                    var sectionImageId2 = new List<int?>();
                    var sectionImageId3 = new List<int?>();
                    var sectionTableFormat = new List<bool>();
                    var sectionRowIndexes = new List<List<int>>();

                    for (var i = 0; i < Model.Rows.Count; i++)
                    {
                        var row = Model.Rows[i];
                        var sectionKey = row.GroupId.HasValue ? $"group-{row.GroupId.Value}" : "ungrouped";

                        if (!sectionIndexByKey.TryGetValue(sectionKey, out var sectionIndex))
                        {
                            sectionIndex = sectionTitles.Count;
                            sectionIndexByKey[sectionKey] = sectionIndex;

                            sectionTitles.Add(!string.IsNullOrWhiteSpace(row.GroupTitle) ? row.GroupTitle.Trim() : "Ungrouped Questions");
                            sectionDescriptions.Add((row.GroupDescription ?? string.Empty).Trim());
                            sectionGroupIds.Add(row.GroupId);
                            sectionImageId1.Add(row.GroupImageId1);
                            sectionImageId2.Add(row.GroupImageId2);
                            sectionImageId3.Add(row.GroupImageId3);
                            sectionTableFormat.Add(row.GroupTableFormat);
                            sectionRowIndexes.Add(new List<int>());
                        }

                        if (string.IsNullOrWhiteSpace(sectionDescriptions[sectionIndex]))
                        {
                            sectionDescriptions[sectionIndex] = (row.GroupDescription ?? string.Empty).Trim();
                        }

                        sectionImageId1[sectionIndex] ??= row.GroupImageId1;
                        sectionImageId2[sectionIndex] ??= row.GroupImageId2;
                        sectionImageId3[sectionIndex] ??= row.GroupImageId3;
                        sectionRowIndexes[sectionIndex].Add(i);
                    }

                    if (sectionTitles.Count == 0)
                    {
                        sectionTitles.Add("Survey");
                        sectionDescriptions.Add(string.Empty);
                        sectionGroupIds.Add(null);
                        sectionImageId1.Add(null);
                        sectionImageId2.Add(null);
                        sectionImageId3.Add(null);
                        sectionTableFormat.Add(false);
                        sectionRowIndexes.Add(Enumerable.Range(0, Model.Rows.Count).ToList());
                    }
                }

                @for (var groupIndex = 0; groupIndex < sectionTitles.Count; groupIndex++)
                {
                    <div class="survey-group-page" data-group-index="@groupIndex" data-group-title="@sectionTitles[groupIndex]" data-group-description="@sectionDescriptions[groupIndex]" style="display:none;">
                        @{
                            var hasTitle = !string.IsNullOrWhiteSpace(sectionTitles[groupIndex]);
                            var hasDescription = !string.IsNullOrWhiteSpace(sectionDescriptions[groupIndex]);
                            var groupImageIds = new List<int>();
                            var groupId = sectionGroupIds[groupIndex];

                            if (groupId.HasValue)
                            {
                                groupImageIds = new[]
                                {
                                    sectionImageId1[groupIndex],
                                    sectionImageId2[groupIndex],
                                    sectionImageId3[groupIndex]
                                }
                                .Where(x => x.HasValue)
                                .Select(x => x!.Value)
                                .Where(x => Model.AvailableGroupImageIds.Contains(x))
                                .Distinct()
                                .ToList();
                            }

                            var hasImages = groupImageIds.Count > 0;
                            var showSectionCard = hasTitle || hasDescription || hasImages;
                        }

                        @if (showSectionCard)
                        {
                            <div class="card mb-3">
                                @if (hasTitle || hasDescription)
                                {
                                    <div class="card-header py-2">
                                        @if (hasTitle)
                                        {
                                            <div class="fw-semibold">@sectionTitles[groupIndex]</div>
                                        }
                                        @if (hasDescription)
                                        {
                                            <div class="small text-body-secondary mt-1">@Html.Raw(sectionDescriptions[groupIndex])</div>
                                        }
                                    </div>
                                }

                                @if (hasImages && groupId.HasValue)
                                {
                                    <div class="card-body pt-3 pb-2">
                                        <div class="d-flex flex-wrap gap-3 align-items-start">
                                            @foreach (var groupImageId in groupImageIds)
                                            {
                                                var groupImageUrl = Url.Page("./AnswerSurvey", "GroupImage", new { id = Model.Company.Id, token = Model.Token, groupId = groupId.Value, imageId = groupImageId });
                                                <img src="@groupImageUrl" alt="@sectionTitles[groupIndex] image" class="img-thumbnail" style="max-width: 660px; max-height: 480px;" />
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (sectionTableFormat[groupIndex])
                        {
                            var sectionRows = sectionRowIndexes[groupIndex];
                            var subgroupRows = sectionRows.Where(i => Model.Rows[i].SubgroupId.HasValue).ToList();
                            var nonSubgroupRows = sectionRows.Where(i => !Model.Rows[i].SubgroupId.HasValue).ToList();

                            if (subgroupRows.Count > 0)
                            {
                                var subgroupGroups = subgroupRows
                                    .GroupBy(i => Model.Rows[i].SubgroupId!.Value)
                                    .Select(g => new
                                    {
                                        SubgroupId = g.Key,
                                        Title = Model.Rows[g.First()].SubgroupTitle,
                                        UseAsHeader = Model.Rows[g.First()].SubgroupNewHeader == true,
                                        QuestionRows = Math.Max(1, Model.Rows[g.First()].SubgroupQuestionRows ?? 1),
                                        MinSubgroupOrder = g.Min(i => Model.Rows[i].SubgroupOrderNumber ?? int.MaxValue),
                                        Rows = g
                                            .OrderBy(i => Model.Rows[i].SubgroupOrderNumber ?? int.MaxValue)
                                            .ThenBy(i => Model.Rows[i].OrderNumber ?? int.MaxValue)
                                            .ThenBy(i => i)
                                            .ToList()
                                    })
                                    .OrderBy(g => g.MinSubgroupOrder)
                                    .ThenBy(g => g.SubgroupId)
                                    .ToList();

                                var headerIndexes = subgroupGroups
                                    .Select((g, idx) => new { Group = g, Index = idx })
                                    .Where(x => x.Group.UseAsHeader)
                                    .Select(x => x.Index)
                                    .ToList();

                                if (headerIndexes.Count == 0)
                                {
                                    headerIndexes.Add(0);
                                }

                                for (var headerBlockIndex = 0; headerBlockIndex < headerIndexes.Count; headerBlockIndex++)
                                {
                                    var headerIndex = headerIndexes[headerBlockIndex];
                                    var nextHeaderIndex = headerBlockIndex + 1 < headerIndexes.Count
                                        ? headerIndexes[headerBlockIndex + 1]
                                        : subgroupGroups.Count;

                                    var tableSubgroups = subgroupGroups
                                        .Skip(headerIndex)
                                        .Take(nextHeaderIndex - headerIndex)
                                        .ToList();

                                    if (tableSubgroups.Count == 0)
                                    {
                                        continue;
                                    }

                                    var subgroupHeaderRows = tableSubgroups.First().Rows;
                                    var showSubgroupColumn = tableSubgroups.Count > 1;

                                    <div class="table-responsive mb-3">
                                        <table class="table table-bordered table-sm align-middle mb-0 survey-table-stack survey-subgroup-table">
                                            <thead class="table-light">
                                                <tr>
                                                    @if (showSubgroupColumn)
                                                    {
                                                        <th class="survey-table-header-cell" style="width: 12%;">Item</th>
                                                    }
                                                    @foreach (var headerRowIndex in subgroupHeaderRows)
                                                    {
                                                        <th class="survey-table-header-cell">
                                                            <div class="survey-table-question">@Model.Rows[headerRowIndex].QuestionText</div>
                                                        </th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var subgroup in tableSubgroups)
                                                {
                                                    <tr style="height:@($"{subgroup.QuestionRows * 3.25}rem")">
                                                        @if (showSubgroupColumn)
                                                        {
                                                            <td class="survey-table-cell fw-semibold">@(string.IsNullOrWhiteSpace(subgroup.Title) ? $"Subgroup {subgroup.SubgroupId}" : subgroup.Title)</td>
                                                        }
                                                        @foreach (var i in subgroup.Rows)
                                                        {
                                                            var answerType = (Model.Rows[i].AnswerType ?? string.Empty).Trim();
                                                            var hasPreviousYearValue = !string.IsNullOrWhiteSpace(Model.Rows[i].PreviousYearValue);
                                                            var previousYearText = Model.Rows[i].PreviousYearAnswerText ?? string.Empty;
                                                            var previousYearNumber = Model.Rows[i].PreviousYearAnswerNumber?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
                                                            var previousYearCurrency = Model.Rows[i].PreviousYearAnswerCurrency?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
                                                            var isTallCell = subgroup.QuestionRows > 1;
                                                            var tallCellClass = isTallCell ? " survey-table-tall-cell" : string.Empty;
                                                            var inlineRowStyle = isTallCell ? "display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto;row-gap:0.35rem;align-items:start;" : null;
                                                            var controlsRowStyle = isTallCell ? "display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;column-gap:0.5rem;width:100%;min-width:0;" : null;
                                                            var prevInlineStyle = isTallCell ? "min-width:0;width:100%;overflow:hidden;text-align:left;padding-left:0;" : null;
                                                            <td class="survey-answer-row survey-table-cell@tallCellClass" data-row-index="@i">
                                                                <input type="hidden" asp-for="Rows[i].QuestionId" />
                                                                <input type="hidden" asp-for="Rows[i].OrderNumber" />
                                                                <input type="hidden" asp-for="Rows[i].GroupId" />
                                                                <input type="hidden" asp-for="Rows[i].GroupTitle" />
                                                                <input type="hidden" asp-for="Rows[i].GroupDescription" />
                                                                <input type="hidden" asp-for="Rows[i].GroupImageId1" />
                                                                <input type="hidden" asp-for="Rows[i].GroupImageId2" />
                                                                <input type="hidden" asp-for="Rows[i].GroupImageId3" />
                                                                <input type="hidden" asp-for="Rows[i].GroupTableFormat" />
                                                                <input type="hidden" asp-for="Rows[i].SubgroupId" />
                                                                <input type="hidden" asp-for="Rows[i].SubgroupTitle" />
                                                                <input type="hidden" asp-for="Rows[i].SubgroupNewHeader" />
                                                                <input type="hidden" asp-for="Rows[i].SubgroupQuestionRows" />
                                                                <input type="hidden" asp-for="Rows[i].SubgroupOrderNumber" />
                                                                <input type="hidden" asp-for="Rows[i].QuestionText" />
                                                                <input type="hidden" asp-for="Rows[i].AnswerType" />
                                                                <div class="survey-table-inline-row" style="@inlineRowStyle">
                                                                    <div class="survey-table-answer-wrap">
                                                                        @if (answerType.Equals("Number", StringComparison.OrdinalIgnoreCase))
                                                                        {
                                                                            <input asp-for="Rows[i].AnswerNumber" class="form-control form-control-sm survey-table-compact-input" placeholder="Enter number" />
                                                                            <input type="hidden" asp-for="Rows[i].AnswerText" />
                                                                            <input type="hidden" asp-for="Rows[i].AnswerCurrency" />
                                                                        }
                                                                        else if (answerType.Equals("Currency", StringComparison.OrdinalIgnoreCase))
                                                                        {
                                                                            <input asp-for="Rows[i].AnswerCurrency" class="form-control form-control-sm survey-table-compact-input" placeholder="Enter currency" />
                                                                            <input type="hidden" asp-for="Rows[i].AnswerText" />
                                                                            <input type="hidden" asp-for="Rows[i].AnswerNumber" />
                                                                        }
                                                                        else if (answerType.Equals("SingleChoice", StringComparison.OrdinalIgnoreCase))
                                                                        {
                                                                            <select asp-for="Rows[i].AnswerText" class="form-select form-select-sm">
                                                                                <option value="">Select an option</option>
                                                                                @foreach (var option in Model.Rows[i].ChoiceOptions)
                                                                                {
                                                                                    <option value="@option">@option</option>
                                                                                }
                                                                            </select>
                                                                            <input type="hidden" asp-for="Rows[i].AnswerNumber" />
                                                                            <input type="hidden" asp-for="Rows[i].AnswerCurrency" />
                                                                        }
                                                                        else if (answerType.Equals("Multichoice", StringComparison.OrdinalIgnoreCase) || answerType.Equals("MultiChoice", StringComparison.OrdinalIgnoreCase))
                                                                        {
                                                                            if (Model.Rows[i].ChoiceOptions.Count == 0)
                                                                            {
                                                                                <div class="text-muted small">No options available.</div>
                                                                            }
                                                                            else
                                                                            {
                                                                                <div class="survey-table-multichoice">
                                                                                    @for (var optionIndex = 0; optionIndex < Model.Rows[i].ChoiceOptions.Count; optionIndex++)
                                                                                    {
                                                                                        var option = Model.Rows[i].ChoiceOptions[optionIndex];
                                                                                        var optionId = $"row_{i}_opt_{optionIndex}";
                                                                                        var isChecked = Model.Rows[i].SelectedChoices.Contains(option, StringComparer.Ordinal);
                                                                                        <div class="form-check">
                                                                                            <input
                                                                                                class="form-check-input"
                                                                                                type="checkbox"
                                                                                                name="Rows[@i].SelectedChoices"
                                                                                                value="@option"
                                                                                                id="@optionId"
                                                                                                @(isChecked ? "checked" : null) />
                                                                                            <label class="form-check-label small" for="@optionId">@option</label>
                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                            }
                                                                            <input type="hidden" asp-for="Rows[i].AnswerText" />
                                                                            <input type="hidden" asp-for="Rows[i].AnswerNumber" />
                                                                            <input type="hidden" asp-for="Rows[i].AnswerCurrency" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <input asp-for="Rows[i].AnswerText" class="form-control form-control-sm" placeholder="Enter answer" />
                                                                            <input type="hidden" asp-for="Rows[i].AnswerNumber" />
                                                                            <input type="hidden" asp-for="Rows[i].AnswerCurrency" />
                                                                        }
                                                                    </div>
                                                                    <div class="survey-table-controls-row" style="@controlsRowStyle">
                                                                        <div class="survey-table-prev survey-table-prev-inline text-body-secondary" style="@prevInlineStyle">
                                                                            <div class="survey-table-prev-label">Prev</div>
                                                                            <div class="survey-table-prev-value text-truncate">@(Model.Rows[i].PreviousYearValue ?? "—")</div>
                                                                        </div>
                                                                        @if (hasPreviousYearValue)
                                                                        {
                                                                            <button
                                                                                type="button"
                                                                                class="btn btn-sm btn-outline-secondary copy-prev-year-btn survey-table-copy-btn"
                                                                                data-row-index="@i"
                                                                                data-answer-type="@answerType"
                                                                                data-prev-text="@previousYearText"
                                                                                data-prev-number="@previousYearNumber"
                                                                                data-prev-currency="@previousYearCurrency">
                                                                                Copy
                                                                            </button>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            }

                            if (nonSubgroupRows.Count > 0)
                            {
                                var textFieldRows = nonSubgroupRows.Where(i => !(Model.Rows[i].AnswerType ?? string.Empty).Trim().Equals("Number", StringComparison.OrdinalIgnoreCase) && !(Model.Rows[i].AnswerType ?? string.Empty).Trim().Equals("Currency", StringComparison.OrdinalIgnoreCase) && !(Model.Rows[i].AnswerType ?? string.Empty).Trim().Equals("SingleChoice", StringComparison.OrdinalIgnoreCase) && !(Model.Rows[i].AnswerType ?? string.Empty).Trim().Equals("Multichoice", StringComparison.OrdinalIgnoreCase) && !(Model.Rows[i].AnswerType ?? string.Empty).Trim().Equals("MultiChoice", StringComparison.OrdinalIgnoreCase)).ToList();
                                var compactRows = nonSubgroupRows.Except(textFieldRows).ToList();

                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm align-middle mb-3 survey-table-stack">
                                        <tbody>
                                            @foreach (var i in compactRows)
                                            {
                                                var answerType = (Model.Rows[i].AnswerType ?? string.Empty).Trim();
                                                var hasPreviousYearValue = !string.IsNullOrWhiteSpace(Model.Rows[i].PreviousYearValue);
                                                var previousYearText = Model.Rows[i].PreviousYearAnswerText ?? string.Empty;
                                                var previousYearNumber = Model.Rows[i].PreviousYearAnswerNumber?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
                                                var previousYearCurrency = Model.Rows[i].PreviousYearAnswerCurrency?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;

                                                <tr class="survey-answer-row" data-row-index="@i">
                                                    <td class="survey-table-cell">
                                                        <div class="survey-table-question">@Model.Rows[i].QuestionText</div>
                                                    </td>
                                                    <td class="survey-table-cell">
                                                        <input type="hidden" asp-for="Rows[i].QuestionId" />
                                                        <input type="hidden" asp-for="Rows[i].OrderNumber" />
                                                        <input type="hidden" asp-for="Rows[i].GroupId" />
                                                        <input type="hidden" asp-for="Rows[i].GroupTitle" />
                                                        <input type="hidden" asp-for="Rows[i].GroupDescription" />
                                                        <input type="hidden" asp-for="Rows[i].GroupImageId1" />
