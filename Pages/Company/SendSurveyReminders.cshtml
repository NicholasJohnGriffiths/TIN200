@page
@model TINWeb.Pages.Company.SendSurveyRemindersModel
@{
    ViewData["Title"] = "Send Survey Reminders";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <h1>Send Survey Reminders</h1>
            <p class="text-muted mb-1">Send a reminder survey email to companies that have already been sent a survey.</p>
            <p class="small text-muted">Only companies with a previously sent survey email are shown.</p>
            <p class="small text-muted mb-1">By default, companies with saved or submitted surveys are excluded.</p>
            <hr />

            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <div class="alert alert-success" role="alert">
                    @Model.StatusMessage
                </div>
            }

            @if (Model.BulkSentCount.HasValue || Model.BulkSkippedCount.HasValue || Model.BulkFailedCount.HasValue)
            {
                <div class="card mb-3">
                    <div class="card-header">Last Bulk Send Summary</div>
                    <div class="card-body py-2">
                        @if (!string.IsNullOrWhiteSpace(Model.BulkLastRunAt))
                        {
                            <div><strong>Last run:</strong> @Model.BulkLastRunAt</div>
                        }
                        <div><strong>Sent:</strong> @(Model.BulkSentCount ?? 0)</div>
                        <div><strong>Skipped:</strong> @(Model.BulkSkippedCount ?? 0)</div>
                        <div><strong>Failed:</strong> @(Model.BulkFailedCount ?? 0)</div>
                    </div>
                </div>
            }

            <div id="bulkSendProgressContainer" class="mb-3" style="display:none;">
                <div class="d-flex justify-content-between small mb-1">
                    <span id="bulkSendProgressLabel">Sending reminder emails...</span>
                    <span id="bulkSendProgressPercent">0%</span>
                </div>
                <div class="progress" role="progressbar" aria-label="Bulk send progress" aria-valuemin="0" aria-valuemax="100">
                    <div id="bulkSendProgressBar" class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%"></div>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="card mb-3">
                <div class="card-header">Bulk Send Reminders</div>
                <div class="card-body">
                    <form method="get" class="mb-3 d-flex align-items-end gap-3 flex-wrap">
                        <div>
                            <label asp-for="SelectedTinStatus" class="form-label mb-1">TIN Status</label>
                            <select asp-for="SelectedTinStatus" class="form-select" style="min-width: 220px;" onchange="this.form.submit()">
                                @foreach (var option in TINWeb.Models.TinStatusHelper.DropdownOptions)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label asp-for="SelectedSentYear" class="form-label mb-1">Year Survey Sent</label>
                            <select asp-for="SelectedSentYear" class="form-select" style="min-width: 160px;" aria-label="Year Survey Sent">
                                <option value="">All Years</option>
                                @foreach (var y in Model.AvailableSentYears)
                                {
                                    <option value="@y">@y</option>
                                }
                            </select>
                        </div>

                        <div class="form-check mb-2">
                            <input asp-for="IncludeSavedSubmitted" class="form-check-input" onchange="this.form.submit()" />
                            <label asp-for="IncludeSavedSubmitted" class="form-check-label">Include saved/submitted</label>
                        </div>

                        <div class="mb-2">
                            <button type="submit" class="btn btn-outline-primary btn-sm">Apply Filters</button>
                        </div>
                    </form>

                    <form id="bulkSendForm" method="post" asp-page-handler="Bulk">
                        <input type="hidden" asp-for="SelectedTinStatus" />
                        <input type="hidden" asp-for="SelectedSentYear" />
                        <input type="hidden" asp-for="IncludeSavedSubmitted" />

                        <div class="mb-2">
                            <button type="button" id="selectAllClientsBtn" class="btn btn-outline-secondary btn-sm">Select All Listed</button>
                            <button type="button" id="clearAllClientsBtn" class="btn btn-outline-secondary btn-sm">Clear Selection</button>
                        </div>

                        <div class="form-group mb-3">
                            <label for="clientSearchInput" class="form-label">Search clients</label>
                            <input id="clientSearchInput" class="form-control" type="text" placeholder="Search by ID, company, or contact email" />
                        </div>

                        <div class="mb-3 d-flex align-items-center" role="group" aria-label="Reminder sent filter">
                            <label for="reminderSentFilter" class="form-label me-2 mb-0">Reminder Sent</label>
                            <select id="reminderSentFilter" class="form-select form-select-sm" style="max-width: 180px;">
                                <option value="all" selected>All</option>
                                <option value="sent">Sent</option>
                                <option value="not-sent">Not sent</option>
                            </select>
                        </div>

                        <div class="mb-2 small text-muted">
                            <strong>Displayed companies:</strong> <span id="displayedCompanyCount">@Model.AvailableClients.Count</span>
                            <span class="mx-2">|</span>
                            <strong>Selected:</strong> <span id="selectedCompanyCount">@(Model.SelectedClientIds.Count)</span>
                        </div>

                        <div id="clientListContainer" class="table-responsive" style="max-height: 420px; overflow-y: auto;">
                            <table class="table table-striped align-middle company-table">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 80px;">Select</th>
                                        <th style="width: 80px;">
                                            <button type="button" class="btn btn-link p-0 sort-header" data-sort-key="id">ID</button>
                                        </th>
                                        <th>
                                            <button type="button" class="btn btn-link p-0 sort-header" data-sort-key="company">Company</button>
                                        </th>
                                        <th>
                                            <button type="button" class="btn btn-link p-0 sort-header" data-sort-key="email">Contact Email</button>
                                        </th>
                                        <th style="min-width: 260px;">Survey Link</th>
                                        <th style="min-width: 170px;">Link Expiry</th>
                                        <th style="width: 120px;">Survey Locked</th>
                                        <th style="width: 120px;">Unsubscribed</th>
                                        <th style="width: 160px;">Survey Email Sent</th>
                                        <th style="width: 180px;">Reminder Sent</th>
                                        <th style="width: 180px;">Reminder Sent Last Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var clientRow in Model.AvailableClients)
                                    {
                                        var hasEmail = !string.IsNullOrWhiteSpace(clientRow.Email);
                                        var canSend = hasEmail && !clientRow.IsLocked && !clientRow.Unsubscribed;
                                        var disableReason = clientRow.Unsubscribed
                                            ? "This company has unsubscribed from surveys."
                                            : clientRow.IsLocked
                                                ? "Survey record is locked. Contact the Technology Investment Network."
                                                : "Cannot send reminder because no contact email address is available.";
                                        var searchText = $"{clientRow.Id} {clientRow.CompanyName} {clientRow.Email}".ToLowerInvariant();
                                        var companySort = (clientRow.CompanyName ?? string.Empty).ToLowerInvariant();
                                        var emailSort = (clientRow.Email ?? string.Empty).ToLowerInvariant();
                                        <tr data-search="@searchText" data-has-email="@(hasEmail ? "true" : "false")" data-id="@clientRow.Id" data-company="@companySort" data-email="@emailSort" data-reminder-sent="@(clientRow.SurveyReminderEmailSent ? "true" : "false")">
                                            <td>
                                                @if (canSend)
                                                {
                                                    <input class="form-check-input client-selector" type="checkbox" name="SelectedClientIds" value="@clientRow.Id" />
                                                }
                                                else
                                                {
                                                    <span title="@disableReason">
                                                        <input class="form-check-input client-selector" type="checkbox" name="SelectedClientIds" value="@clientRow.Id" disabled />
                                                    </span>
                                                    <span class="small text-muted ms-1" title="@disableReason">N/A</span>
                                                }
                                            </td>
                                            <td>@clientRow.Id</td>
                                            <td>@clientRow.CompanyName</td>
                                            <td>
                                                @if (hasEmail)
                                                {
                                                    @clientRow.Email
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No contact email</span>
                                                }
                                            </td>
                                            <td style="min-width: 260px; max-width: 360px;">
                                                @if (!string.IsNullOrWhiteSpace(clientRow.SurveyLink))
                                                {
                                                    <a href="@clientRow.SurveyLink" target="_blank" rel="noopener noreferrer" class="small d-inline-block text-break" title="@clientRow.SurveyLink">@clientRow.SurveyLink</a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not created</span>
                                                }
                                            </td>
                                            <td>
                                                @if (clientRow.SurveyLinkExpiryUtc.HasValue)
                                                {
                                                    <span class="badge @(clientRow.IsSurveyLinkExpired ? "bg-danger" : "bg-success")">@(clientRow.IsSurveyLinkExpired ? "Expired" : "Valid")</span>
                                                    <div class="small text-muted mt-1">@clientRow.SurveyLinkExpiryUtc.Value.ToString("dd/MM/yyyy HH:mm 'UTC'")</div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td>
                                                @if (clientRow.IsLocked)
                                                {
                                                    <span class="badge bg-warning text-dark">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No</span>
                                                }
                                            </td>
                                            <td>
                                                @if (clientRow.Unsubscribed)
                                                {
                                                    <span class="badge bg-danger">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No</span>
                                                }
                                            </td>
                                            <td>@(clientRow.SurveyEmailSentLastDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                            <td>
                                                @if (clientRow.SurveyReminderEmailSent)
                                                {
                                                    <span class="badge bg-success">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No</span>
                                                }
                                            </td>
                                            <td>@(clientRow.SurveyReminderEmailSentLastDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="form-check mt-3">
                            <input asp-for="EnableScheduleSettings" class="form-check-input" />
                            <label asp-for="EnableScheduleSettings" class="form-check-label">Schedule Settings</label>
                        </div>

                        <div id="scheduleSettingsPanel" class="border rounded p-3 mt-2" style="display:none;">
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label asp-for="SendStartTime" class="form-label">Send Start Time</label>
                                    <input asp-for="SendStartTime" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                                    <span asp-validation-for="SendStartTime" class="text-danger"></span>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label asp-for="SplitBulkIntoBatchesOf" class="form-label">Split bulk into batches of</label>
                                    <input asp-for="SplitBulkIntoBatchesOf" type="number" min="1" class="form-control" />
                                    <span asp-validation-for="SplitBulkIntoBatchesOf" class="text-danger"></span>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label asp-for="BreakBetweenSendingGroupsHours" class="form-label">Break Between Sending Groups (hrs)</label>
                                    <input asp-for="BreakBetweenSendingGroupsHours" type="number" min="0" step="0.1" class="form-control" />
                                    <span asp-validation-for="BreakBetweenSendingGroupsHours" class="text-danger"></span>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label asp-for="IntervalBetweenEachEmailSendSeconds" class="form-label">Interval Between Each Email Send (seconds)</label>
                                    <input asp-for="IntervalBetweenEachEmailSendSeconds" type="number" min="0" step="1" class="form-control" />
                                    <span asp-validation-for="IntervalBetweenEachEmailSendSeconds" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-text mt-2">Times are interpreted in local server time.</div>
                        </div>

                        <div id="bulkSendConfigInfo" class="alert alert-info mt-3 mb-0 small" role="status"></div>

                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" id="sendSurveyEmailsBtn" class="btn btn-primary">Send Reminder Emails</button>
                            <button type="button" id="stopScheduledSendBtn" class="btn btn-outline-danger" style="display:none;">Stop Scheduled Send</button>
                        </div>
                    </form>
                </div>
            </div>

            <a asp-page="./Index" class="btn btn-secondary">Back to Records</a>
        </div>
    </div>
</div>

<div class="modal fade" id="bulkSendWarningModal" tabindex="-1" aria-labelledby="bulkSendWarningModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bulkSendWarningModalLabel">Confirm Bulk Reminder Send</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning mb-0" role="alert">
                    You are about to send survey reminder emails to <strong id="bulkSendWarningTarget">selected clients</strong>. Please confirm to continue.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmBulkSendBtn" class="btn btn-danger">Send Reminder Emails</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const selectAllBtn = document.getElementById('selectAllClientsBtn');
            const clearAllBtn = document.getElementById('clearAllClientsBtn');
            const sendToAllToggle = document.getElementById('SendToAllClients');
            const searchInput = document.getElementById('clientSearchInput');
            const reminderSentFilterSelect = document.getElementById('reminderSentFilter');
            const displayedCompanyCount = document.getElementById('displayedCompanyCount');
            const selectedCompanyCount = document.getElementById('selectedCompanyCount');
            const filterButtons = Array.from(document.querySelectorAll('.client-filter-btn'));
            const sortButtons = Array.from(document.querySelectorAll('.sort-header'));
            const selectableCheckboxes = Array.from(document.querySelectorAll('.client-selector:not([disabled])'));
            const tbody = document.querySelector('tbody');
            const clientListContainer = document.getElementById('clientListContainer');
            const bulkSendForm = document.getElementById('bulkSendForm');
            const warningModalElement = document.getElementById('bulkSendWarningModal');
            const warningTarget = document.getElementById('bulkSendWarningTarget');
            const confirmBulkSendBtn = document.getElementById('confirmBulkSendBtn');
            const bulkSendProgressContainer = document.getElementById('bulkSendProgressContainer');
            const bulkSendProgressBar = document.getElementById('bulkSendProgressBar');
            const bulkSendProgressPercent = document.getElementById('bulkSendProgressPercent');
            const bulkSendProgressLabel = document.getElementById('bulkSendProgressLabel');
            const scheduleSettingsToggle = document.getElementById('EnableScheduleSettings');
            const scheduleSettingsPanel = document.getElementById('scheduleSettingsPanel');
            const sendStartTimeInput = document.getElementById('SendStartTime');
            const splitBulkIntoBatchesInput = document.getElementById('SplitBulkIntoBatchesOf');
            const breakBetweenGroupsHoursInput = document.getElementById('BreakBetweenSendingGroupsHours');
            const intervalBetweenEmailsInput = document.getElementById('IntervalBetweenEachEmailSendSeconds');
            const bulkSendConfigInfo = document.getElementById('bulkSendConfigInfo');
            const sendSurveyEmailsBtn = document.getElementById('sendSurveyEmailsBtn');
            const stopScheduledSendBtn = document.getElementById('stopScheduledSendBtn');
            const warningModal = warningModalElement && window.bootstrap && window.bootstrap.Modal
                ? new window.bootstrap.Modal(warningModalElement)
                : null;
            const url = new URL(window.location.href);
            const storageKey = 'tin200_send_survey_reminders_selected_clients';
            const clearSavedSelectionsAfterSend = @Model.BulkSendSucceeded.ToString().ToLowerInvariant();
            let bulkSendInProgress = false;
            let bulkSendAbortController = null;
            let searchParam = null;
            let filterParam = null;
            let activeFilter = 'all';
            let reminderSentFilterParam = null;
            let activeReminderSentFilter = 'all';
            let sortKey = 'company';
            let sortDir = 'asc';
            let bulkProgressTimerId = null;
            let bulkProgressStartedAtMs = 0;
            let bulkProgressTotalMs = 0;

            if (!selectAllBtn || !clearAllBtn) {
                return;
            }

            if (clearSavedSelectionsAfterSend) {
                localStorage.removeItem(storageKey);
                url.searchParams.delete('search');
                url.searchParams.delete('filter');
                window.history.replaceState({}, '', url.toString());
            }

            searchParam = url.searchParams.get('search');
            filterParam = url.searchParams.get('filter');
            reminderSentFilterParam = url.searchParams.get('reminderSentFilter');

            const sortParam = (url.searchParams.get('sort') || '').toLowerCase();
            const sortDirParam = (url.searchParams.get('dir') || '').toLowerCase();
            if (['id', 'company', 'email'].includes(sortParam)) {
                sortKey = sortParam;
            }
            if (['asc', 'desc'].includes(sortDirParam)) {
                sortDir = sortDirParam;
            }

            const getCheckboxes = () => Array.from(document.querySelectorAll('.client-selector:not([disabled])'));
            const getVisibleRows = () => Array.from(document.querySelectorAll('tbody tr')).filter(row => row.style.display !== 'none');
            const getSearchRows = () => Array.from(document.querySelectorAll('tbody tr[data-search]'));

            const parseNonNegativeInt = (value) => {
                const parsed = parseInt((value || '').trim(), 10);
                return Number.isFinite(parsed) && parsed >= 0 ? parsed : 0;
            };

            const parseNonNegativeNumber = (value) => {
                const parsed = parseFloat((value || '').trim());
                return Number.isFinite(parsed) && parsed >= 0 ? parsed : 0;
            };

            const getRecipientCount = () => {
                if (sendToAllToggle && sendToAllToggle.checked) {
                    return getCheckboxes().length;
                }
                return getCheckboxes().filter(cb => cb.checked).length;
            };

            const formatDuration = (totalSeconds) => {
                const seconds = Math.max(0, Math.floor(totalSeconds));
                const hours = Math.floor(seconds / 3600);
                const minutes = Math.floor((seconds % 3600) / 60);
                const remainingSeconds = seconds % 60;
                const parts = [];
                if (hours > 0) parts.push(`${hours}h`);
                if (minutes > 0) parts.push(`${minutes}m`);
                if (remainingSeconds > 0 || parts.length === 0) parts.push(`${remainingSeconds}s`);
                return parts.join(' ');
            };

            const getCurrentScheduleConfig = () => {
                const scheduleEnabled = !!(scheduleSettingsToggle && scheduleSettingsToggle.checked);
                const startTimeRaw = sendStartTimeInput ? sendStartTimeInput.value : '';
                const startTime = startTimeRaw ? new Date(startTimeRaw) : null;
                const batchSize = Math.max(1, parseNonNegativeInt(splitBulkIntoBatchesInput ? splitBulkIntoBatchesInput.value : '1'));
                const breakHours = parseNonNegativeNumber(breakBetweenGroupsHoursInput ? breakBetweenGroupsHoursInput.value : '0');
                const intervalSeconds = parseNonNegativeInt(intervalBetweenEmailsInput ? intervalBetweenEmailsInput.value : '0');
                const recipientCount = getRecipientCount();
                return { scheduleEnabled, startTime, batchSize, breakHours, intervalSeconds, recipientCount };
            };

            const getEstimatedTotalSeconds = (config) => {
                if (!config.scheduleEnabled) return 0;
                let total = 0;
                if (config.startTime && !Number.isNaN(config.startTime.getTime())) {
                    const now = new Date();
                    total += Math.max(0, (config.startTime.getTime() - now.getTime()) / 1000);
                }
                const sends = Math.max(0, config.recipientCount);
                const delayPoints = Math.max(0, sends - 1);
                if (delayPoints === 0) return total;
                const batchBreaks = Math.floor(delayPoints / config.batchSize);
                const intervalDelays = Math.max(0, delayPoints - batchBreaks);
                total += (batchBreaks * config.breakHours * 3600) + (intervalDelays * config.intervalSeconds);
                return total;
            };

            const updateBulkSendConfigInfo = () => {
                if (!bulkSendConfigInfo) return;
                const config = getCurrentScheduleConfig();
                if (!config.scheduleEnabled) {
                    bulkSendConfigInfo.textContent = `Mode: Immediate send. Target recipients: ${config.recipientCount}.`;
                    return;
                }
                const startText = config.startTime && !Number.isNaN(config.startTime.getTime())
                    ? config.startTime.toLocaleString()
                    : 'Not set';
                const estimated = getEstimatedTotalSeconds(config);
                const estimatedText = estimated > 0 ? formatDuration(estimated) : 'No scheduled delay';
                bulkSendConfigInfo.textContent = `Mode: Scheduled. Start: ${startText}. Batch size: ${config.batchSize}. Break between groups: ${config.breakHours}h. Interval per email: ${config.intervalSeconds}s. Target recipients: ${config.recipientCount}. Estimated duration: ${estimatedText}.`;
            };

            const updateScheduleSettingsVisibility = () => {
                if (!scheduleSettingsToggle || !scheduleSettingsPanel) return;
                scheduleSettingsPanel.style.display = scheduleSettingsToggle.checked ? '' : 'none';
            };

            const updateCounts = () => {
                if (displayedCompanyCount) displayedCompanyCount.textContent = String(getVisibleRows().length);
                if (selectedCompanyCount) selectedCompanyCount.textContent = String(getCheckboxes().filter(cb => cb.checked).length);
            };

            const saveSelections = () => {
                const selectedIds = getCheckboxes().filter(cb => cb.checked).map(cb => cb.value);
                localStorage.setItem(storageKey, JSON.stringify(selectedIds));
                updateCounts();
            };

            const restoreSelections = () => {
                const raw = localStorage.getItem(storageKey);
                if (!raw) return;
                let selectedIds;
                try { selectedIds = JSON.parse(raw); } catch { return; }
                if (!Array.isArray(selectedIds)) return;
                const selectedSet = new Set(selectedIds.map(String));
                getCheckboxes().forEach(cb => { cb.checked = selectedSet.has(String(cb.value)); });
            };

            const syncUrlState = () => {
                const term = ((searchInput && searchInput.value) || '').trim();
                if (term) { url.searchParams.set('search', term); } else { url.searchParams.delete('search'); }
                if (activeFilter && activeFilter !== 'all') { url.searchParams.set('filter', activeFilter); } else { url.searchParams.delete('filter'); }
                if (activeReminderSentFilter && activeReminderSentFilter !== 'all') { url.searchParams.set('reminderSentFilter', activeReminderSentFilter); } else { url.searchParams.delete('reminderSentFilter'); }
                if (sortKey !== 'company') { url.searchParams.set('sort', sortKey); } else { url.searchParams.delete('sort'); }
                if (sortDir !== 'asc') { url.searchParams.set('dir', sortDir); } else { url.searchParams.delete('dir'); }
                window.history.replaceState({}, '', url.toString());
            };

            const setSortButtonText = () => {
                sortButtons.forEach(btn => {
                    const key = btn.getAttribute('data-sort-key');
                    const baseLabel = (key || '').charAt(0).toUpperCase() + (key || '').slice(1);
                    btn.textContent = key === sortKey ? `${baseLabel} ${sortDir === 'asc' ? '↑' : '↓'}` : baseLabel;
                });
            };

            const startBulkSendProgress = (estimatedTotalSeconds) => {
                if (!bulkSendProgressContainer || !bulkSendProgressBar || !bulkSendProgressPercent || !bulkSendProgressLabel) return;
                if (bulkProgressTimerId) window.clearInterval(bulkProgressTimerId);
                bulkProgressStartedAtMs = Date.now();
                bulkProgressTotalMs = Math.max(0, estimatedTotalSeconds) * 1000;
                bulkSendProgressLabel.textContent = 'Sending reminder emails...';
                bulkSendProgressContainer.style.display = '';
                const render = (value) => {
                    bulkSendProgressBar.style.width = `${value}%`;
                    bulkSendProgressPercent.textContent = `${value}%`;
                };
                render(5);
                bulkProgressTimerId = window.setInterval(() => {
                    if (bulkProgressTotalMs <= 0) {
                        render(Math.min(92, 5 + Math.floor((Date.now() - bulkProgressStartedAtMs) / 400)));
                        return;
                    }
                    const ratio = Math.max(0, Math.min(1, (Date.now() - bulkProgressStartedAtMs) / bulkProgressTotalMs));
                    render(Math.min(95, Math.max(5, Math.round(ratio * 95))));
                }, 300);
            };

            const stopBulkSendProgress = (label, percent) => {
                if (!bulkSendProgressContainer || !bulkSendProgressBar || !bulkSendProgressPercent || !bulkSendProgressLabel) return;
                if (bulkProgressTimerId) { window.clearInterval(bulkProgressTimerId); bulkProgressTimerId = null; }
                if (typeof percent === 'number') {
                    const bounded = Math.max(0, Math.min(100, Math.round(percent)));
                    bulkSendProgressBar.style.width = `${bounded}%`;
                    bulkSendProgressPercent.textContent = `${bounded}%`;
                }
                if (label) bulkSendProgressLabel.textContent = label;
            };

            const setBulkSendRunningState = (isRunning) => {
                bulkSendInProgress = isRunning;
                if (sendSurveyEmailsBtn) sendSurveyEmailsBtn.disabled = isRunning;
                if (confirmBulkSendBtn) confirmBulkSendBtn.disabled = isRunning;
                if (stopScheduledSendBtn) {
                    stopScheduledSendBtn.style.display = isRunning ? '' : 'none';
                    stopScheduledSendBtn.disabled = !isRunning;
                }
            };

            const submitBulkSendAsync = async () => {
                if (!bulkSendForm || bulkSendInProgress) return;
                const config = getCurrentScheduleConfig();
                const estimatedTotalSeconds = getEstimatedTotalSeconds(config);
                setBulkSendRunningState(true);
                startBulkSendProgress(estimatedTotalSeconds);
                const formData = new FormData(bulkSendForm);
                bulkSendAbortController = new AbortController();
                try {
                    const response = await fetch(bulkSendForm.action, {
                        method: 'POST',
                        body: formData,
                        signal: bulkSendAbortController.signal,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    stopBulkSendProgress('Bulk send completed.', 100);
                    if (response.redirected) { window.location.href = response.url; return; }
                    const html = await response.text();
                    document.open();
                    document.write(html);
                    document.close();
                } catch (error) {
                    if (error && error.name === 'AbortError') {
                        stopBulkSendProgress('Bulk send cancelled.', 0);
                        return;
                    }
                    stopBulkSendProgress('Bulk send failed.', 0);
                    window.alert('An unexpected error occurred while sending reminder emails. Please try again.');
                } finally {
                    bulkSendAbortController = null;
                    setBulkSendRunningState(false);
                }
            };

            const applySort = () => {
                if (!tbody) return;
                const rows = Array.from(tbody.querySelectorAll('tr[data-search]'));
                rows.sort((a, b) => {
                    let aVal, bVal;
                    if (sortKey === 'id') {
                        aVal = parseInt(a.getAttribute('data-id') || '0', 10);
                        bVal = parseInt(b.getAttribute('data-id') || '0', 10);
                    } else if (sortKey === 'email') {
                        aVal = a.getAttribute('data-email') || '';
                        bVal = b.getAttribute('data-email') || '';
                    } else {
                        aVal = a.getAttribute('data-company') || '';
                        bVal = b.getAttribute('data-company') || '';
                    }
                    if (aVal < bVal) return sortDir === 'asc' ? -1 : 1;
                    if (aVal > bVal) return sortDir === 'asc' ? 1 : -1;
                    return 0;
                });
                rows.forEach(row => tbody.appendChild(row));
                setSortButtonText();
                syncUrlState();
            };

            const setActiveFilterButton = () => {
                filterButtons.forEach(btn => {
                    btn.classList.toggle('active', (btn.getAttribute('data-filter') || 'all') === activeFilter);
                });
            };

            const applyFilters = () => {
                const term = ((searchInput && searchInput.value) || '').toLowerCase().trim();
                getSearchRows().forEach(row => {
                    const haystack = row.getAttribute('data-search') || '';
                    const hasEmail = (row.getAttribute('data-has-email') || 'false') === 'true';
                    const reminderSent = (row.getAttribute('data-reminder-sent') || 'false') === 'true';

                    const matchesSearch = !term || haystack.includes(term);
                    const matchesEmailFilter =
                        activeFilter === 'all' ||
                        (activeFilter === 'has-email' && hasEmail) ||
                        (activeFilter === 'missing-email' && !hasEmail);
                    const matchesReminderSentFilter =
                        activeReminderSentFilter === 'all' ||
                        (activeReminderSentFilter === 'sent' && reminderSent) ||
                        (activeReminderSentFilter === 'not-sent' && !reminderSent);

                    row.style.display = matchesSearch && matchesEmailFilter && matchesReminderSentFilter ? '' : 'none';
                });
                syncUrlState();
                updateCounts();
            };

            if (searchInput && searchParam) searchInput.value = searchParam;
            if (filterParam && ['all', 'has-email', 'missing-email'].includes(filterParam)) activeFilter = filterParam;
            if (reminderSentFilterParam && ['all', 'sent', 'not-sent'].includes(reminderSentFilterParam)) activeReminderSentFilter = reminderSentFilterParam;
            if (reminderSentFilterSelect) reminderSentFilterSelect.value = activeReminderSentFilter;

            setActiveFilterButton();
            setSortButtonText();

            if (searchInput) searchInput.addEventListener('input', applyFilters);

            filterButtons.forEach(button => {
                button.addEventListener('click', () => {
                    activeFilter = button.getAttribute('data-filter') || 'all';
                    setActiveFilterButton();
                    applyFilters();
                });
            });

            if (reminderSentFilterSelect) {
                reminderSentFilterSelect.addEventListener('change', () => {
                    activeReminderSentFilter = reminderSentFilterSelect.value || 'all';
                    applyFilters();
                });
            }

            sortButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const clickedKey = button.getAttribute('data-sort-key') || 'company';
                    if (sortKey === clickedKey) {
                        sortDir = sortDir === 'asc' ? 'desc' : 'asc';
                    } else {
                        sortKey = clickedKey;
                        sortDir = 'asc';
                    }
                    applySort();
                });
            });

            applySort();
            applyFilters();
            restoreSelections();
            updateCounts();

            selectAllBtn.addEventListener('click', () => {
                getVisibleRows().forEach(row => {
                    const checkbox = row.querySelector('.client-selector:not([disabled])');
                    if (checkbox) checkbox.checked = true;
                });
                saveSelections();
            });

            clearAllBtn.addEventListener('click', () => {
                getCheckboxes().forEach(cb => cb.checked = false);
                if (sendToAllToggle) sendToAllToggle.checked = false;
                saveSelections();
            });

            if (sendToAllToggle) {
                const applySendToAllSelection = () => {
                    getCheckboxes().forEach(cb => { cb.checked = sendToAllToggle.checked; });
                    saveSelections();
                    updateBulkSendConfigInfo();
                };
                sendToAllToggle.addEventListener('change', applySendToAllSelection);
                if (sendToAllToggle.checked) applySendToAllSelection();
            }

            if (scheduleSettingsToggle) {
                scheduleSettingsToggle.addEventListener('change', () => {
                    updateScheduleSettingsVisibility();
                    updateBulkSendConfigInfo();
                });
            }

            updateScheduleSettingsVisibility();
            updateBulkSendConfigInfo();

            [sendStartTimeInput, splitBulkIntoBatchesInput, breakBetweenGroupsHoursInput, intervalBetweenEmailsInput]
                .filter(Boolean)
                .forEach(input => {
                    input.addEventListener('input', updateBulkSendConfigInfo);
                    input.addEventListener('change', updateBulkSendConfigInfo);
                });

            selectableCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', () => {
                    saveSelections();
                    updateBulkSendConfigInfo();
                });
            });

            if (bulkSendForm) {
                bulkSendForm.addEventListener('submit', (event) => {
                    if (bulkSendInProgress) return;
                    const selectedCount = getCheckboxes().filter(cb => cb.checked).length;
                    const recipientCount = sendToAllToggle && sendToAllToggle.checked ? getCheckboxes().length : selectedCount;
                    const selectedMessage = sendToAllToggle && sendToAllToggle.checked
                        ? 'all listed clients with an email address'
                        : `${selectedCount} selected client${selectedCount === 1 ? '' : 's'}`;
                    event.preventDefault();
                    if (warningTarget) warningTarget.textContent = selectedMessage;
                    if (confirmBulkSendBtn) confirmBulkSendBtn.textContent = `Send to ${recipientCount} Client${recipientCount === 1 ? '' : 's'}`;
                    if (warningModal) { warningModal.show(); return; }
                    if (window.confirm(`Warning: You are about to send reminder emails to ${selectedMessage}. Do you want to continue?`)) {
                        submitBulkSendAsync();
                    }
                });
            }

            if (confirmBulkSendBtn && bulkSendForm) {
                confirmBulkSendBtn.addEventListener('click', () => {
                    if (warningModal) warningModal.hide();
                    submitBulkSendAsync();
                });
            }

            if (stopScheduledSendBtn) {
                stopScheduledSendBtn.addEventListener('click', () => {
                    if (bulkSendAbortController) bulkSendAbortController.abort();
                });
            }
        })();
    </script>
}
