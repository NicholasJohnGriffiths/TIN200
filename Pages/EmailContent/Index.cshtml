@page
@model TINWeb.Pages.EmailContent.IndexModel
@{
    ViewData["Title"] = "Email Content";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h1>Email Content</h1>
            <p class="text-muted mb-0">Create and manage reusable email content used for survey send and resend pages.</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-page="./Edit" class="btn btn-primary">Add Email Content</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
    }

    @if (Model.Records.Any())
    {
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Subject</th>
                    <th style="width: 120px;">Active</th>
                    <th style="width: 180px;">Created By</th>
                    <th style="width: 180px;">Updated By</th>
                    <th style="width: 180px;">Updated (UTC)</th>
                    <th style="width: 300px;">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var record in Model.Records)
            {
                <tr>
                    <td>@record.Name</td>
                    <td>@(string.IsNullOrWhiteSpace(record.Subject) ? "(default subject)" : record.Subject)</td>
                    <td>@(record.Active ? "Yes" : "No")</td>
                    <td>@(string.IsNullOrWhiteSpace(record.CreatedBy) ? "-" : record.CreatedBy)</td>
                    <td>@(string.IsNullOrWhiteSpace(record.UpdatedBy) ? "-" : record.UpdatedBy)</td>
                    <td>@record.UpdatedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="d-flex gap-2">
                        <a asp-page="./Edit" asp-route-id="@record.Id" class="btn btn-sm btn-warning">Edit</a>
                        <form method="post" asp-page-handler="Duplicate" asp-route-id="@record.Id">
                            <button type="submit" class="btn btn-sm btn-secondary">Duplicate</button>
                        </form>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@record.Id" onsubmit="return confirm('Delete this email content?');">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info" role="alert">No email content records found.</div>
    }
</div>
