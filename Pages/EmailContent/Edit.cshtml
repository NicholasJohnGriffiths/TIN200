@page "{id:int?}"
@model TINWeb.Pages.EmailContent.EditModel
@{
    ViewData["Title"] = Model.IsCreate ? "Create Email Content" : "Edit Email Content";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    <form method="post" class="mt-3">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Record.Id" />

        <div class="mb-3">
            <label asp-for="Record.Name" class="form-label">Name</label>
            <input asp-for="Record.Name" class="form-control" maxlength="255" />
            <span asp-validation-for="Record.Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Record.Subject" class="form-label">Subject</label>
            <input asp-for="Record.Subject" class="form-control" maxlength="255" />
            <div class="form-text">Leave blank to use the default subject for the send/reminder page.</div>
        </div>

        <div class="mb-3">
            <label asp-for="Record.Template" class="form-label">Email Template</label>
            <textarea asp-for="Record.Template" id="emailContentTemplateEditor" class="form-control" rows="14"></textarea>
            <div class="form-text">Rich text/HTML is supported. Use [CompanyName] or (CompanyName) for company name. Other [Field] or (Field) values map by exact Question Title. [Web Address]/(Web address), [Company Phone]/(Company phone), and [Physical Address]/(Physical address) map from Company.Website, Company.Phone, and Company address fields. Legacy tokens (Company Name), (Name), and (Survey link) are still supported.</div>
        </div>

        <div class="form-check mb-3">
            <input asp-for="Record.Active" class="form-check-input" />
            <label asp-for="Record.Active" class="form-check-label">Active</label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/tinymce/tinymce.min.js" asp-append-version="true"></script>
    <script>
        (function () {
            tinymce.init({
                selector: '#emailContentTemplateEditor',
                license_key: 'gpl',
                plugins: 'link lists table code help wordcount',
                toolbar: 'undo redo | blocks | bold italic underline | alignleft aligncenter alignright | bullist numlist | link table | code help',
                menubar: 'file edit view insert format table help',
                height: 380,
                setup: function (editor) {
                    editor.on('change input undo redo', function () {
                        tinymce.triggerSave();
                    });
                }
            });

            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function () {
                    tinymce.triggerSave();
                });
            }
        })();
    </script>
}
