@using TINWeb.Services
@{
    var isReadOnlyUser = UserTypes.IsReadOnly(User);
    var isSurveyEstimationsUser = UserTypes.IsSurveyEstimations(User);
    var selectedCompanyTinStatus = Context.Request.Query["tinStatus"].FirstOrDefault();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TINWeb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TINWeb.styles.css" asp-append-version="true" />
</head>
<body data-read-only-user="@(isReadOnlyUser ? "true" : "false")" data-survey-estimations-user="@(isSurveyEstimationsUser ? "true" : "false")">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid wider-container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">TINWeb</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="companiesMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Companies</a>
                            <ul class="dropdown-menu" aria-labelledby="companiesMenu">
                                <li><a class="dropdown-item" asp-area="" asp-page="/Company/Index">Companies</a></li>
                                @if (!string.IsNullOrWhiteSpace(selectedCompanyTinStatus))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Company/Index" asp-route-showImportTool="import" asp-route-tinStatus="@selectedCompanyTinStatus">Import Companies</a></li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Company/Index" asp-route-showImportTool="import">Import Companies</a></li>
                                }
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="surveysMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Surveys</a>
                            <ul class="dropdown-menu" aria-labelledby="surveysMenu">
                                <li><a class="dropdown-item" asp-area="" asp-page="/Survey/Index">Year Survey</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/CompanySurvey/Index">Companies Survey Summary</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/CompanySurvey/Progress">Survey Progress</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/CompanySurvey/Locking">Survey Locking</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Company/SendSurvey">Send Survey</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Company/SendSurveyReminders">Send Survey Reminders</a></li>
                                <li class="dropdown-submenu dropend">
                                    <a class="dropdown-item dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">Survey Answers</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Answers/Index">Answers</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Answers/Index" asp-route-showImportTool="qualtrics">Import Qualtrics File</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Answers/Index" asp-route-showImportTool="global">Import Global File</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Answers/ExportGlobal">Export Excel - Global</a></li>
                                    </ul>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="questionsMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Questions</a>
                            <ul class="dropdown-menu" aria-labelledby="questionsMenu">
                                <li><a class="dropdown-item" asp-area="" asp-page="/QuestionGroups/Index">Question Groups</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Questions/Index">Questions</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Tasks/Index">Tasks</a>
                        </li>
                            @if (User.HasClaim("TransactionsVisible", "true"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="transactionsMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Transactions</a>
                                    <ul class="dropdown-menu" aria-labelledby="transactionsMenu">
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Transactions/Events">Stripe Transactions</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Transactions/GravityForms">Website Orders</a></li>
                                    </ul>
                                </li>
                            }
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="azureMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Azure</a>
                                    <ul class="dropdown-menu" aria-labelledby="azureMenu">
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Survey/EmailEvents">Email Events</a></li>
                                    </ul>
                                </li>
                        @if (User.IsInRole("1"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="adminMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Admin</a>
                                <ul class="dropdown-menu" aria-labelledby="adminMenu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/AppUsers/Index">App Users</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Config/Edit" asp-route-id="1">Config</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/EmailContent/Index">Email Content</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Config/NotificationStatus">Notification Status</a></li>
                                </ul>
                            </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="testingMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Testing</a>
                            <ul class="dropdown-menu" aria-labelledby="testingMenu">
                                <li><a class="dropdown-item" asp-area="" asp-page="/Testing/TestCompanies/Index">Test Companies</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Testing/SurveyDataCheck/Index">Survey Data Check</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown help-menu-root">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="helpMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Help</a>
                            <ul class="dropdown-menu" aria-labelledby="helpMenu">
                                <li><a class="dropdown-item fw-semibold" asp-area="" asp-page="/Help/Index">Help Home</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Help/TinWebsiteUserManual">TIN Website User Manual</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li class="dropdown-submenu dropend">
                                    <a class="dropdown-item dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">Companies</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Help/CompaniesImportGlobalFile">Import Global File</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Help/CompaniesExport">Export</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Help/CompaniesSmExport">SM Export</a></li>
                                    </ul>
                                </li>
                                <li class="dropdown-submenu dropend">
                                    <a class="dropdown-item dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">Surveys</a>
                                    <ul class="dropdown-menu">
                                        <li class="dropdown-submenu dropend">
                                            <a class="dropdown-item dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">Survey Answers</a>
                                            <ul class="dropdown-menu">
                                                <li><a class="dropdown-item" asp-area="" asp-page="/Help/SurveyAnswersImportQualtricsFile">Import Qualtrics File</a></li>
                                                <li><a class="dropdown-item" asp-area="" asp-page="/Help/SurveyAnswersImportGlobalFile">Import Global File</a></li>
                                                <li><a class="dropdown-item" asp-area="" asp-page="/Help/SurveyAnswersExport">Export</a></li>
                                            </ul>
                                        </li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Help/SurveysExportExcelGlobal">Export Excel - Global</a></li>
                                    </ul>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Help/EstimationLogic">Estimation Logic</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true && isSurveyEstimationsUser)
                        {
                            <li class="nav-item d-flex align-items-center me-2">
                                <span class="badge text-bg-warning">Survey/Estimations</span>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <form method="post" asp-page="/Logout" class="m-0">
                                    <button type="submit" class="btn btn-link nav-link text-dark border-0 bg-transparent">Logout</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid wider-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container-fluid wider-container">
            &copy; 2026 - TINWeb - <a asp-area="" asp-page="/Privacy">Privacy</a> - Deploy marker: 2026-03-03
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (isReadOnlyUser)
    {
        <script>
            (function () {
                function isEditOrDeletePath(urlValue) {
                    if (!urlValue) {
                        return false;
                    }

                    try {
                        var parsed = new URL(urlValue, window.location.origin);
                        var segments = parsed.pathname
                            .split("/")
                            .filter(function (segment) { return segment.length > 0; })
                            .map(function (segment) { return segment.toLowerCase(); });

                        return segments.indexOf("edit") >= 0 || segments.indexOf("delete") >= 0;
                    } catch (_) {
                        return false;
                    }
                }

                function isEditOrDeleteLabel(label) {
                    if (!label) {
                        return false;
                    }

                    return /\b(edit|delete)\b/i.test(label.trim());
                }

                function disableAnchor(anchor) {
                    anchor.classList.add("disabled", "readonly-action-disabled");
                    anchor.setAttribute("aria-disabled", "true");
                    anchor.setAttribute("tabindex", "-1");
                    anchor.setAttribute("data-readonly-disabled", "true");
                }

                function disableButton(control) {
                    control.disabled = true;
                    control.classList.add("readonly-action-disabled");
                    control.setAttribute("aria-disabled", "true");
                }

                function shouldDisableElement(element) {
                    var label = (element.textContent || element.value || element.getAttribute("aria-label") || element.getAttribute("title") || "").trim();
                    if (isEditOrDeleteLabel(label)) {
                        var hrefForSpecialCase = element.getAttribute && element.getAttribute("href");
                        if (document.body.getAttribute("data-survey-estimations-user") === "true"
                            && hrefForSpecialCase
                            && hrefForSpecialCase.toLowerCase().indexOf("/companysurvey/edit") >= 0) {
                            return false;
                        }

                        return true;
                    }

                    var href = element.getAttribute && element.getAttribute("href");
                    if (isEditOrDeletePath(href)) {
                        return true;
                    }

                    var form = element.closest && element.closest("form");
                    var action = form ? form.getAttribute("action") : null;
                    if (isEditOrDeletePath(action)) {
                        return true;
                    }

                    return false;
                }

                var interactiveSelector = "a, button, input[type='submit'], input[type='button']";
                document.querySelectorAll(interactiveSelector).forEach(function (element) {
                    if (!shouldDisableElement(element)) {
                        return;
                    }

                    if (element.tagName.toLowerCase() === "a") {
                        disableAnchor(element);
                        return;
                    }

                    disableButton(element);
                });

                document.addEventListener("click", function (event) {
                    var disabledAnchor = event.target.closest("a[data-readonly-disabled='true']");
                    if (!disabledAnchor) {
                        return;
                    }

                    event.preventDefault();
                    event.stopPropagation();
                }, true);
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
