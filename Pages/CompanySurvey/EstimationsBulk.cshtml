@page "/CompanySurvey/EstimationsBulk"
@model TINWeb.Pages.CompanySurvey.EstimationsBulkModel
@{
    ViewData["Title"] = "Bulk Estimations";
}

<h1>Bulk Estimations</h1>
<p class="text-muted">
    Review company survey estimates for cost structures (Wages and Salaries, Research and Development,
    Sales and Marketing) and EBITDA. Only rows with a valid current year Revenue and Employment answer can be edited.
    <strong>All financial figures are in thousands ($000s), rounded to whole numbers.</strong>
</p>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info">@Model.StatusMessage</div>
}

<form method="get" class="row row-cols-auto g-2 align-items-end mb-3">
    <div class="col">
        <label asp-for="SelectedFinancialYear" class="form-label mb-1">Financial Year</label>
        <select asp-for="SelectedFinancialYear" class="form-select">
            @foreach (var year in Model.FinancialYears)
            {
                <option value="@year">@year</option>
            }
        </select>
    </div>
    <div class="col">
        <label asp-for="SelectedTinStatus" class="form-label mb-1">TIN Status</label>
        <select asp-for="SelectedTinStatus" class="form-select" style="min-width: 200px;">
            @foreach (var option in Model.TinStatusOptions)
            {
                <option value="@option.Value">@option.Label</option>
            }
        </select>
    </div>
    <div class="col">
        <button class="btn btn-outline-primary" type="submit">Apply Filter</button>
    </div>
</form>

@* Hidden form purely so the FormTagHelper renders an antiforgery token we can read from JS for AJAX posts. *@
<form id="antiforgeryForm" method="post" style="display:none;"></form>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <button type="button" id="showEstimatesBtn" class="btn btn-outline-primary">Show Estimate Numbers</button>
    <button type="button" id="previewApplyBtn" class="btn btn-warning">Preview / Apply Selected</button>
    <div class="progress flex-grow-1" id="estimatesProgressWrap" style="display:none; max-width: 320px; height: 1.25rem;">
        <div id="estimatesProgressBar" class="progress-bar" role="progressbar" style="width: 0%;">0%</div>
    </div>
</div>

<style>
    .estimations-table > tbody > tr.row-even { background-color: #ffffff; }
    .estimations-table > tbody > tr.row-odd { background-color: #f0f0f0; }
</style>
<table class="table estimations-table table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th><input type="checkbox" id="selectAllRows" class="form-check-input" /></th>
            <th>Company Name</th>
            <th>Current Revenue ($000s)</th>
            <th>Current Employees</th>
            <th>Wages &amp; Salaries ($000s)</th>
            <th>Research &amp; Development ($000s)</th>
            <th>Sales &amp; Marketing ($000s)</th>
            <th>EBITDA ($000s)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @for (var rowIndex = 0; rowIndex < Model.Rows.Count; rowIndex++)
        {
            var row = Model.Rows[rowIndex];
            var rowShadeClass = rowIndex % 2 == 0 ? "row-even" : "row-odd";
            <tr data-row-id="@row.CompanySurveyId" class="@rowShadeClass">
                <td>
                    @if (row.IsEditable)
                    {
                        <input type="checkbox" class="form-check-input row-checkbox" data-row-id="@row.CompanySurveyId" />
                    }
                </td>
                <td>@row.CompanyName</td>
                <td>@(row.CurrentRevenue.HasValue ? Math.Round(row.CurrentRevenue.Value, 0).ToString("N0") : "-")</td>
                <td>@(row.CurrentEmployment.HasValue ? Math.Round(row.CurrentEmployment.Value, 0).ToString("N0") : "-")</td>
                @if (row.IsEditable)
                {
                    <td data-metric-cell="Wages">
                        <div class="metric-status small @(row.WagesActual.HasValue ? "" : "text-muted")">@(row.WagesActual.HasValue ? $"Actual: {Math.Round(row.WagesActual.Value, 0):N0}" : "-")</div>
                        <input type="number" step="1" min="0" class="form-control form-control-sm mt-1"
                               name="wagesValue" value="@(row.WagesActual.HasValue ? Math.Round(row.WagesActual.Value, 0).ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" />
                    </td>
                    <td data-metric-cell="ResearchDevelopment">
                        <div class="metric-status small @(row.ResearchDevelopmentActual.HasValue ? "" : "text-muted")">@(row.ResearchDevelopmentActual.HasValue ? $"Actual: {Math.Round(row.ResearchDevelopmentActual.Value, 0):N0}" : "-")</div>
                        <input type="number" step="1" min="0" class="form-control form-control-sm mt-1"
                               name="researchDevelopmentValue" value="@(row.ResearchDevelopmentActual.HasValue ? Math.Round(row.ResearchDevelopmentActual.Value, 0).ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" />
                    </td>
                    <td data-metric-cell="SalesMarketing">
                        <div class="metric-status small @(row.SalesMarketingActual.HasValue ? "" : "text-muted")">@(row.SalesMarketingActual.HasValue ? $"Actual: {Math.Round(row.SalesMarketingActual.Value, 0):N0}" : "-")</div>
                        <input type="number" step="1" min="0" class="form-control form-control-sm mt-1"
                               name="salesMarketingValue" value="@(row.SalesMarketingActual.HasValue ? Math.Round(row.SalesMarketingActual.Value, 0).ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" />
                    </td>
                    <td data-metric-cell="Ebitda">
                        <div class="metric-status small @(row.EbitdaActual.HasValue ? "" : "text-muted")">@(row.EbitdaActual.HasValue ? $"Actual: {Math.Round(row.EbitdaActual.Value, 0):N0}" : "-")</div>
                        <input type="number" step="1" min="0" class="form-control form-control-sm mt-1"
                               name="ebitdaValue" value="@(row.EbitdaActual.HasValue ? Math.Round(row.EbitdaActual.Value, 0).ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" />
                    </td>
                    <td class="text-nowrap">
                        <button type="button" class="btn btn-sm btn-outline-secondary detail-row-btn" data-row-id="@row.CompanySurveyId" disabled title="Run Show Estimate Numbers first">Detail</button>
                    </td>
                }
                else
                {
                    <td colspan="4" class="text-muted">
                        @if (!row.EstimateEnabled)
                        {
                            <span>Estimate not enabled for this company survey.</span>
                        }
                        else if (row.IsLocked)
                        {
                            <span>Company survey is locked.</span>
                        }
                        else
                        {
                            <span>Missing valid current year Revenue or Employment answer.</span>
                        }
                    </td>
                    <td></td>
                }
            </tr>
            @if (row.IsEditable)
            {
                <tr id="row-details-@row.CompanySurveyId" class="row-methodology-details @rowShadeClass" style="display:none;">
                    <td colspan="9" class="bg-light"></td>
                </tr>
            }
        }
        @if (Model.Rows.Count == 0)
        {
            <tr>
                <td colspan="9" class="text-center text-muted">No company survey records found for the selected filters.</td>
            </tr>
        }
    </tbody>
</table>

<div class="modal" id="previewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Preview Estimate Changes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <strong>Warning:</strong> Applying will overwrite any existing saved values for the selected companies
                    and cannot be undone. Review the changes below carefully before applying.
                </div>
                <div id="previewContent"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmApplyBtn" class="btn btn-danger">Apply Changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const metricKeys = ['Wages', 'ResearchDevelopment', 'SalesMarketing', 'Ebitda'];
            const metricInputName = {
                Wages: 'wagesValue',
                ResearchDevelopment: 'researchDevelopmentValue',
                SalesMarketing: 'salesMarketingValue',
                Ebitda: 'ebitdaValue'
            };
            const previewModal = new bootstrap.Modal(document.getElementById('previewModal'));

            function antiforgeryToken() {
                return $('#antiforgeryForm input[name="__RequestVerificationToken"]').val();
            }

            function formatWholeNumber(value) {
                if (value === null || value === undefined) {
                    return null;
                }
                return Math.round(value).toLocaleString();
            }

            function escapeHtml(text) {
                return $('<div>').text(text || '').html();
            }

            function selectedRows() {
                return $('.row-checkbox:checked').map(function () {
                    return $(this).data('row-id');
                }).get();
            }

            // "Show Estimate Numbers": per-methodology summary for only the checked rows, with a progress bar.
            $('#showEstimatesBtn').on('click', function () {
                const button = $(this);
                const rowIds = selectedRows();
                const total = rowIds.length;
                if (total === 0) {
                    alert('Select at least one row to calculate estimate numbers.');
                    return;
                }

                button.prop('disabled', true);
                $('#estimatesProgressWrap').show();
                $('#estimatesProgressBar').css('width', '0%').text('0%');

                let completed = 0;

                function next(index) {
                    if (index >= total) {
                        button.prop('disabled', false);
                        return;
                    }

                    const rowId = rowIds[index];
                    $.getJSON('@Url.Page("EstimationsBulk", "RowEstimates")', { companySurveyId: rowId })
                        .done(function (result) {
                            applyShortEstimates(rowId, result);
                        })
                        .always(function () {
                            completed++;
                            const percent = Math.round((completed / total) * 100);
                            $('#estimatesProgressBar').css('width', percent + '%').text(percent + '%');
                            next(index + 1);
                        });
                }

                next(0);
            });

            function applyShortEstimates(rowId, result) {
                const $row = $('tr[data-row-id="' + rowId + '"]');
                $row.data('estimates', result);
                $row.find('.detail-row-btn').prop('disabled', false);

                (result.metrics || []).forEach(function (metric) {
                    const $cell = $row.find('td[data-metric-cell="' + metric.key + '"]');
                    const $status = $cell.find('.metric-status');
                    const $input = $cell.find('input[name="' + metricInputName[metric.key] + '"]');

                    if (metric.usedValue !== null && metric.usedValue !== undefined) {
                        $input.val(Math.round(metric.usedValue));
                    }

                    const summaryHtml = (metric.candidates || []).map(function (candidate) {
                        const displayValue = candidate.value === null || candidate.value === undefined
                            ? 'n/a'
                            : formatWholeNumber(candidate.value);
                        const label = escapeHtml(candidate.step) + ': ' + displayValue;
                        return candidate.isUsed ? '<strong>' + label + '</strong>' : label;
                    }).join(' &middot; ');

                    $status.removeClass('text-muted').html(summaryHtml || '<span class="text-muted">n/a</span>');
                });
            }

            function buildMetricCard(metric) {
                let rows = '';
                (metric.candidates || []).forEach(function (candidate) {
                    const displayValue = candidate.value === null || candidate.value === undefined
                        ? 'n/a'
                        : formatWholeNumber(candidate.value);
                    const statusBadge = candidate.isUsed
                        ? '<span class="badge bg-success ms-2">Used</span>'
                        : '<span class="badge bg-info text-dark ms-2">Info</span>';

                    let reasonsHtml = '';
                    if (candidate.failureReasons && candidate.failureReasons.length) {
                        reasonsHtml = '<ul class="mb-0 mt-1 small">' +
                            candidate.failureReasons.map(function (reason) { return '<li>' + escapeHtml(reason) + '</li>'; }).join('') +
                            '</ul>';
                    }

                    rows += '<tr class="' + (candidate.isUsed ? 'table-success' : '') + '">' +
                        '<td>' + escapeHtml(candidate.step) + statusBadge + '</td>' +
                        '<td>' + displayValue + '</td>' +
                        '<td><div>' + escapeHtml(candidate.details) + '</div>' + reasonsHtml + '</td>' +
                        '</tr>';
                });

                return '<div class="card mb-2">' +
                    '<div class="card-header py-1 px-2 small"><strong>' + escapeHtml(metric.label) + '</strong> <span class="text-muted">Actual -&gt; Own Ratio -&gt; Trend -&gt; Fallback</span></div>' +
                    '<div class="table-responsive">' +
                        '<table class="table table-sm mb-0">' +
                            '<thead><tr><th style="width:180px;">Calculation Step</th><th style="width:140px;">Candidate Value</th><th>Details</th></tr></thead>' +
                            '<tbody>' + rows + '</tbody>' +
                        '</table>' +
                    '</div>' +
                '</div>';
            }

            // "Detail": toggles the full methodology breakdown for a single row (Actual/Own Ratio/Trend/Fallback per metric).
            $('.detail-row-btn').on('click', function () {
                const button = $(this);
                const rowId = button.data('row-id');
                const $detailsRow = $('#row-details-' + rowId);
                const $detailsCell = $detailsRow.find('td');

                if ($detailsRow.is(':visible')) {
                    $detailsRow.hide();
                    button.text('Detail');
                    return;
                }

                if ($detailsRow.data('loaded')) {
                    $detailsRow.show();
                    button.text('Hide Detail');
                    return;
                }

                const cached = $('tr[data-row-id="' + rowId + '"]').data('estimates');
                if (!cached) {
                    return;
                }

                let detailsHtml = '';
                (cached.metrics || []).forEach(function (metric) {
                    detailsHtml += buildMetricCard(metric);
                });

                $detailsCell.html(detailsHtml);
                $detailsRow.data('loaded', true).show();
                button.text('Hide Detail');
            });

            $('#selectAllRows').on('change', function () {
                $('.row-checkbox').prop('checked', $(this).is(':checked'));
            });

            function collectSelectedRowData() {
                return $('.row-checkbox:checked').map(function () {
                    const rowId = $(this).data('row-id');
                    const $row = $('tr[data-row-id="' + rowId + '"]');
                    const data = { CompanySurveyId: rowId };
                    metricKeys.forEach(function (key) {
                        const raw = $row.find('input[name="' + metricInputName[key] + '"]').val();
                        data[key + 'Value'] = raw === '' ? null : Number(raw);
                    });
                    return data;
                }).get();
            }

            function buildFormBody(rowsData) {
                const formData = new URLSearchParams();
                formData.append('__RequestVerificationToken', antiforgeryToken());
                rowsData.forEach(function (row, index) {
                    formData.append('rows[' + index + '].CompanySurveyId', row.CompanySurveyId);
                    formData.append('rows[' + index + '].WagesValue', row.WagesValue === null ? '' : row.WagesValue);
                    formData.append('rows[' + index + '].ResearchDevelopmentValue', row.ResearchDevelopmentValue === null ? '' : row.ResearchDevelopmentValue);
                    formData.append('rows[' + index + '].SalesMarketingValue', row.SalesMarketingValue === null ? '' : row.SalesMarketingValue);
                    formData.append('rows[' + index + '].EbitdaValue', row.EbitdaValue === null ? '' : row.EbitdaValue);
                });
                return formData.toString();
            }

            $('#previewApplyBtn').on('click', function () {
                const selectedIds = $('.row-checkbox:checked').length;
                if (selectedIds === 0) {
                    alert('Select at least one row to preview and apply.');
                    return;
                }

                const rowsData = collectSelectedRowData();

                $.ajax({
                    url: '@Url.Page("EstimationsBulk", "PreviewSelected")',
                    method: 'POST',
                    data: buildFormBody(rowsData),
                    contentType: 'application/x-www-form-urlencoded'
                }).done(function (result) {
                    let html = '<table class="table table-sm"><thead><tr><th>Company</th><th>Metric</th><th>Current Value</th><th>New Value</th></tr></thead><tbody>';
                    (result.rows || []).forEach(function (row) {
                        if (row.blockedReason) {
                            html += '<tr class="table-secondary"><td>' + escapeHtml(row.companyName || ('#' + row.companySurveyId)) + '</td><td colspan="3" class="text-danger">' + escapeHtml(row.blockedReason) + '</td></tr>';
                            return;
                        }
                        if (!row.changes || row.changes.length === 0) {
                            html += '<tr><td>' + escapeHtml(row.companyName) + '</td><td colspan="3" class="text-muted">No values entered.</td></tr>';
                            return;
                        }
                        row.changes.forEach(function (change, i) {
                            html += '<tr>' +
                                '<td>' + (i === 0 ? escapeHtml(row.companyName) : '') + '</td>' +
                                '<td>' + escapeHtml(change.label) + '</td>' +
                                '<td>' + (change.currentValue === null || change.currentValue === undefined ? 'n/a' : formatWholeNumber(change.currentValue)) + '</td>' +
                                '<td><strong>' + formatWholeNumber(change.newValue) + '</strong></td>' +
                                '</tr>';
                        });
                    });
                    html += '</tbody></table>';

                    $('#previewContent').html(html);
                    $('#confirmApplyBtn').data('rows', rowsData);
                    previewModal.show();
                }).fail(function () {
                    alert('Failed to build preview. Please try again.');
                });
            });

            $('#confirmApplyBtn').on('click', function () {
                const rowsData = $(this).data('rows') || [];
                const button = $(this);
                button.prop('disabled', true).text('Applying...');

                $.ajax({
                    url: '@Url.Page("EstimationsBulk", "ApplySelected")',
                    method: 'POST',
                    data: buildFormBody(rowsData),
                    contentType: 'application/x-www-form-urlencoded'
                }).done(function () {
                    previewModal.hide();
                    window.location.reload();
                }).fail(function () {
                    alert('Failed to apply changes. Please try again.');
                }).always(function () {
                    button.prop('disabled', false).text('Apply Changes');
                });
            });
        });
    </script>
}

