@page
@model TINWeb.Pages.CompanySurvey.IndexModel
@{
    ViewData["Title"] = "Companies Survey Summary";
}

@functions {
    string SortHref(string column) => Url.Page(
        "/CompanySurvey/Index",
        null,
        new
        {
            financialYear = Model.SelectedFinancialYear,
            companySearch = Model.CompanySearch,
            surveyEmailSentFilter = Model.SurveyEmailSentFilter,
            tinStatus = Model.SelectedTinStatus,
            selectedLinkExpiryDateUtc = Model.SelectedLinkExpiryDateUtc?.ToString("yyyy-MM-dd"),
            sortBy = column,
            sortDir = Model.GetNextSortDirection(column)
        },
        null) ?? "#";

    DateTimeOffset? GetSurveyLinkExpiryUtc(string? surveyLink)
    {
        if (string.IsNullOrWhiteSpace(surveyLink) || !Uri.TryCreate(surveyLink.Trim(), UriKind.Absolute, out var linkUri))
        {
            return null;
        }

        var token = linkUri.Segments.LastOrDefault()?.Trim('/');
        if (string.IsNullOrWhiteSpace(token))
        {
            return null;
        }

        try
        {
            var base64 = token.Replace('-', '+').Replace('_', '/');
            switch (base64.Length % 4)
            {
                case 2:
                    base64 += "==";
                    break;
                case 3:
                    base64 += "=";
                    break;
            }

            var decoded = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(base64));
            var parts = decoded.Split(':');
            if (parts.Length != 3 || !long.TryParse(parts[1], out var expiresUnix))
            {
                return null;
            }

            return DateTimeOffset.FromUnixTimeSeconds(expiresUnix);
        }
        catch
        {
            return null;
        }
    }

    bool IsSurveyLinkExpired(string? surveyLink)
    {
        var expiryUtc = GetSurveyLinkExpiryUtc(surveyLink);
        return expiryUtc.HasValue && expiryUtc.Value <= DateTimeOffset.UtcNow;
    }
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col">
            <h1>Companies Survey Summary</h1>
            <p class="text-muted mb-0">Companies with answers: <strong>@Model.TotalCompaniesWithAnswers</strong> of <strong>@Model.Records.Count</strong></p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-3">
        <div class="col-12">
            <form id="populateSurveyLinksForm" method="post" asp-page-handler="PopulateSurveyLinks" class="d-flex flex-wrap align-items-end gap-2">
                <input type="hidden" name="financialYear" value="@Model.SelectedFinancialYear" />
                <input type="hidden" name="companySearch" value="@Model.CompanySearch" />
                <input type="hidden" name="surveyEmailSentFilter" value="@Model.SurveyEmailSentFilter" />
                <input type="hidden" name="tinStatus" value="@Model.SelectedTinStatus" />
                <div>
                    <label for="SelectedLinkExpiryDateUtc" class="form-label mb-1">Survey Link Expiry Date</label>
                    <input asp-for="SelectedLinkExpiryDateUtc" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" style="min-width: 180px;" />
                    <small class="text-muted">Choose the date here for when generated survey links should expire.</small>
                </div>
                <div class="form-check align-self-center">
                    <input class="form-check-input" type="checkbox" name="overwriteExisting" id="overwriteExisting" value="true" />
                    <input type="hidden" name="overwriteExisting" value="false" />
                    <label class="form-check-label" for="overwriteExisting">Overwrite Existing Survey Links</label>
                </div>
                <div class="selected-record-inputs"></div>
                <button class="btn btn-warning" type="button" id="previewBtn">Preview Populate Survey Links</button>
            </form>

            <div id="populatePreviewPanel" class="card mt-3 d-none" style="max-width: 980px;">
                <div class="card-body">
                    <h6 class="card-title mb-2">Populate Survey Links Preview</h6>
                    <div id="previewWarningInline"></div>
                    <div class="alert alert-info mb-2" role="alert">
                        <span id="previewSummaryInline"></span>
                    </div>
                    <div>
                        <label class="form-label mb-1"><strong>Preview</strong> <small class="text-muted" id="previewCountInline"></small></label>
                        <div style="max-height: 240px; overflow-y: auto;">
                            <table class="table table-sm table-hover mb-2">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 30px;"></th>
                                        <th>Company Name</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody id="previewTableBodyInline"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-warning" id="confirmPopulateBtn">Confirm & Populate</button>
                        <button type="button" class="btn btn-outline-secondary" id="cancelPopulateBtn">Cancel</button>
                    </div>
                </div>
            </div>

            <div id="populateProgress" class="mt-2 d-none" style="max-width: 520px;">
                <div class="progress" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                    <div id="populateProgressBar" class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%">0%</div>
                </div>
                <small id="populateProgressText" class="text-muted">Preparing to populate survey links...</small>
            </div>

            <form id="populatePriorYearDataForm" method="post" asp-page-handler="PopulatePriorYearData" class="d-flex flex-wrap align-items-end gap-2 mt-3">
                <input type="hidden" name="financialYear" value="@Model.SelectedFinancialYear" />
                <input type="hidden" name="companySearch" value="@Model.CompanySearch" />
                <input type="hidden" name="surveyEmailSentFilter" value="@Model.SurveyEmailSentFilter" />
                <input type="hidden" name="tinStatus" value="@Model.SelectedTinStatus" />
                <div>
                    <label class="form-label mb-1">Historical Year Data</label>
                    <div class="d-flex flex-column">
                        <button class="btn btn-success" type="button" id="previewPopulatePriorYearDataBtn" disabled="@(!Model.IsAdmin)" title="@(!Model.IsAdmin ? "Admin only" : null)">@Model.PopulatePriorYearDataButtonLabel</button>
                        <small class="text-muted">Preview and fill blank <strong>Year-1</strong> / <strong>Year-2</strong> answers only. Existing values stay unchanged.</small>
                    </div>
                </div>
                <div class="selected-record-inputs"></div>
            </form>

            <form id="copyContactDetailsForm" method="post" asp-page-handler="CopyContactDetailsFromCompanies" class="d-flex flex-wrap align-items-end gap-2 mt-3">
                <input type="hidden" name="financialYear" value="@Model.SelectedFinancialYear" />
                <input type="hidden" name="companySearch" value="@Model.CompanySearch" />
                <input type="hidden" name="surveyEmailSentFilter" value="@Model.SurveyEmailSentFilter" />
                <input type="hidden" name="tinStatus" value="@Model.SelectedTinStatus" />
                <div>
                    <label class="form-label mb-1">Survey Contact Answers</label>
                    <div class="d-flex flex-column">
                        <button class="btn btn-outline-info" type="submit" id="copyContactDetailsBtn">Copy Contact Details From Companies</button>
                        <small class="text-muted">Updates the selected surveys' Survey Contact First Name, Last Name, and Email answers from the Company contact fields.</small>
                    </div>
                </div>
                <div class="selected-record-inputs"></div>
            </form>

            <div id="populatePriorYearPreviewPanel" class="card mt-3 d-none" style="max-width: 980px;">
                <div class="card-body">
                    <h6 class="card-title mb-2">Populate Historical Year Data Preview</h6>
                    <div class="alert alert-info mb-2" role="alert">
                        <span id="populatePriorYearSummaryInline"></span>
                    </div>
                    <div>
                        <label class="form-label mb-1"><strong>Preview</strong> <small class="text-muted" id="populatePriorYearCountInline"></small></label>
                        <div style="max-height: 240px; overflow-y: auto;">
                            <table class="table table-sm table-hover mb-2">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 30px;"></th>
                                        <th>Company Name</th>
                                        <th>Status</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody id="populatePriorYearTableBodyInline"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-success" id="confirmPopulatePriorYearDataBtn">Confirm & Populate</button>
                        <button type="button" class="btn btn-outline-secondary" id="cancelPopulatePriorYearDataBtn">Cancel</button>
                    </div>
                </div>
            </div>

            <div id="populatePriorYearProgress" class="mt-2 d-none" style="max-width: 520px;">
                <div class="progress" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                    <div id="populatePriorYearProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success" style="width: 0%">0%</div>
                </div>
                <small id="populatePriorYearProgressText" class="text-muted">Preparing to populate historical year data...</small>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            <form method="get" class="d-flex flex-wrap align-items-end gap-2">
                <div>
                    <label class="form-label mb-1">Survey Financial Year</label>
                    <select name="financialYear" class="form-select" aria-label="Survey Financial Year" style="min-width: 180px;">
                        @foreach (var year in Model.FinancialYears)
                        {
                            <option value="@year" selected="@(Model.SelectedFinancialYear == year ? "selected" : null)">@year</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label mb-1">Company</label>
                    <input type="text" name="companySearch" value="@Model.CompanySearch" class="form-control" style="min-width: 280px; max-width: 340px;" placeholder="Company name or External ID" />
                </div>
                <div>
                    <label class="form-label mb-1">Survey Email</label>
                    <select name="surveyEmailSentFilter" class="form-select" aria-label="Survey email sent filter" style="min-width: 160px;">
                        <option value="all" selected="@(Model.SurveyEmailSentFilter == "all" ? "selected" : null)">All</option>
                        <option value="sent" selected="@(Model.SurveyEmailSentFilter == "sent" ? "selected" : null)">Sent</option>
                        <option value="not-sent" selected="@(Model.SurveyEmailSentFilter == "not-sent" ? "selected" : null)">Not sent</option>
                    </select>
                </div>
                <div>
                    <label class="form-label mb-1">TIN Status</label>
                    <select name="tinStatus" class="form-select" aria-label="TIN status filter" style="min-width: 180px;">
                        @foreach (var option in TINWeb.Models.TinStatusHelper.DropdownOptions)
                        {
                            <option value="@option.Value" selected="@(Model.SelectedTinStatus == option.Value ? "selected" : null)">@option.Label</option>
                        }
                    </select>
                </div>
                <button class="btn btn-outline-primary mb-2" type="submit">Apply</button>
                @if (Model.IsAdmin)
                {
                    <a class="btn btn-link mb-2" asp-page="./Index" asp-route-financialYear="@Model.SelectedFinancialYear">Clear</a>
                }
            </form>
        </div>
    </div>

    @if (Model.Records.Any())
    {
        <div class="card border-0 bg-light mb-3">
            <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center gap-2">
                <span class="fw-semibold">Select surveys:</span>
                <button type="button" class="btn btn-sm btn-outline-primary survey-selection-btn" data-selection="all">All</button>
                <button type="button" class="btn btn-sm btn-outline-secondary survey-selection-btn" data-selection="none">None</button>
                <button type="button" class="btn btn-sm btn-outline-secondary survey-selection-btn" data-selection="without-link">No Link</button>
                <button type="button" class="btn btn-sm btn-outline-secondary survey-selection-btn" data-selection="with-link">With Link</button>
                <button type="button" class="btn btn-sm btn-outline-secondary survey-selection-btn" data-selection="with-answers">With Answers</button>
                <span class="text-muted ms-md-auto">Selected: <strong id="selectedSurveyCount">@Model.Records.Count</strong> of <strong>@Model.Records.Count</strong></span>
            </div>
        </div>

        <table class="table table-striped table-hover company-table">
            <thead class="table-dark">
                <tr>
                    <th style="width: 42px;">
                        <input type="checkbox" class="form-check-input" id="toggleAllSurveyRows" checked title="Select or clear all visible surveys" />
                    </th>
                    <th><a class="link-light text-decoration-none" href="@SortHref("CompanyName")"><span>Company Name</span><span>@Model.GetSortIndicator("CompanyName")</span></a></th>
                    <th>Survey Link</th>
                    <th><a class="link-light text-decoration-none" href="@SortHref("Saved")"><span>Saved</span><span>@Model.GetSortIndicator("Saved")</span></a></th>
                    <th><a class="link-light text-decoration-none" href="@SortHref("SavedDate")"><span>Saved Date</span><span>@Model.GetSortIndicator("SavedDate")</span></a></th>
                    <th><a class="link-light text-decoration-none" href="@SortHref("Submitted")"><span>Submitted</span><span>@Model.GetSortIndicator("Submitted")</span></a></th>
                    <th><a class="link-light text-decoration-none" href="@SortHref("SubmittedDate")"><span>Submitted Date</span><span>@Model.GetSortIndicator("SubmittedDate")</span></a></th>
                    <th><a class="link-light text-decoration-none" href="@SortHref("Requested")"><span>Requested</span><span>@Model.GetSortIndicator("Requested")</span></a></th>
                    <th><a class="link-light text-decoration-none" href="@SortHref("RequestedDate")"><span>Requested Date</span><span>@Model.GetSortIndicator("RequestedDate")</span></a></th>
                    <th><a class="link-light text-decoration-none" href="@SortHref("Locked")"><span>Locked</span><span>@Model.GetSortIndicator("Locked")</span></a></th>
                    <th><a class="link-light text-decoration-none" href="@SortHref("Estimate")"><span>Estimate</span><span>@Model.GetSortIndicator("Estimate")</span></a></th>
                    <th>Survey Email Sent</th>
                    <th>Survey Email Sent Last Date</th>
                    <th>Unsubscribed</th>
                    <th><a class="link-light text-decoration-none" href="@SortHref("AnswerCount")"><span>Answers</span><span>@Model.GetSortIndicator("AnswerCount")</span></a></th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model.Records)
                {
                    <tr id="record-@record.Id">
                        <td class="text-center align-middle">
                            <input type="checkbox"
                                   class="form-check-input survey-record-checkbox"
                                   value="@record.Id"
                                   checked
                                   data-has-link="@(!string.IsNullOrWhiteSpace(record.SurveyLink) ? "true" : "false")"
                                   data-has-answers="@(record.AnswerCount > 0 ? "true" : "false")" />
                        </td>
                        <td style="min-width: 250px;">
                            @record.CompanyName
                            @if (record.IsTestCompany)
                            {
                                <span class="badge bg-secondary ms-1">Test</span>
                            }
                        </td>
                        <td style="min-width: 300px; max-width: 360px;">
                            @if (!string.IsNullOrWhiteSpace(record.SurveyLink))
                            {
                                var linkExpiryUtc = GetSurveyLinkExpiryUtc(record.SurveyLink);
                                var isExpired = IsSurveyLinkExpired(record.SurveyLink);

                                <a href="@record.SurveyLink" target="_blank" class="survey-link-two-line d-inline-block" title="@record.SurveyLink">@record.SurveyLink</a>

                                @if (linkExpiryUtc.HasValue)
                                {
                                    <div class="small mt-1">
                                        <span class="badge @(isExpired ? "bg-danger" : "bg-success")">@(isExpired ? "Expired" : "Valid")</span>
                                        <span class="ms-2 text-muted">Expires: @linkExpiryUtc.Value.ToString("dd/MM/yyyy HH:mm 'UTC'")</span>
                                    </div>
                                }
                            }
                        </td>
                        <td>@(record.Saved ? "Yes" : "No")</td>
                        <td>@(record.SavedDate?.ToString("dd/MM/yyyy") ?? string.Empty)</td>
                        <td>@(record.Submitted ? "Yes" : "No")</td>
                        <td>@(record.SubmittedDate?.ToString("dd/MM/yyyy") ?? string.Empty)</td>
                        <td>@(record.Requested ? "Yes" : "No")</td>
                        <td>@(record.RequestedDate?.ToString("dd/MM/yyyy") ?? string.Empty)</td>
                        <td>@(record.Locked ? "Yes" : "No")</td>
                        <td>@(record.Estimate ? "Yes" : "No")</td>
                        <td>@(record.SurveyEmailSent ? "Yes" : "No")</td>
                        <td>@(record.SurveyEmailSentLastDate?.ToString("dd/MM/yyyy") ?? string.Empty)</td>
                        <td>
                            @if (record.Unsubscribed.HasValue && record.Unsubscribed.Value)
                            {
                                <span class="badge bg-danger">Yes</span>
                                @if (record.UnsubscribedDate.HasValue)
                                {
                                    <span class="small text-muted ms-1">@record.UnsubscribedDate.Value.ToString("M/d/yyyy")</span>
                                }
                            }
                            else if (record.Unsubscribed.HasValue)
                            {
                                <span class="badge bg-success">No</span>
                            }
                        </td>
                        <td>@record.AnswerCount</td>
                        <td class="actions-col text-nowrap">
                            @if (!string.IsNullOrWhiteSpace(record.SurveyLink))
                            {
                                <a href="@record.SurveyLink" target="_blank" rel="noopener" class="btn btn-sm btn-outline-info">Survey</a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-info" disabled title="Survey link is not available">Survey</button>
                            }
                            <a asp-page="/CompanySurvey/Edit" asp-route-id="@record.Id" asp-route-financialYear="@Model.SelectedFinancialYear" class="btn btn-sm btn-secondary">Edit</a>
                            <a asp-page="/CompanySurvey/Estimation" asp-route-companySurveyId="@record.Id" asp-route-financialYear="@Model.SelectedFinancialYear" class="btn btn-sm btn-outline-success">Estimatation</a>
                            <a asp-page="/CompanySurvey/Notes" asp-route-companySurveyId="@record.Id" asp-route-financialYear="@Model.SelectedFinancialYear" class="btn btn-sm btn-outline-dark">Notes</a>
                            <a asp-page="/Answers/Index" asp-route-companySurveyId="@record.Id" asp-route-financialYear="@Model.SelectedFinancialYear" asp-route-companySearch="@Model.CompanySearch" class="btn btn-sm btn-primary">Open Answers</a>
                            <a asp-page="/Company/SendSurvey"
                               asp-route-id="@record.CompanyId"
                               class="btn btn-sm btn-outline-primary send-survey-email-btn"
                               data-company-name="@record.CompanyName"
                               data-financial-year="@record.FinancialYear">Send Survey Link Email</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">No company survey records found.</div>
    }
</div>

<script>
    (function () {
        const buttons = document.querySelectorAll('.send-survey-email-btn');
        if (!buttons.length) {
            return;
        }

        buttons.forEach(function (button) {
            button.addEventListener('click', function (event) {
                const companyName = button.getAttribute('data-company-name') || '';
                const financialYear = button.getAttribute('data-financial-year') || '';
                const message = `Do you want to continue?\n\nFinancial Year: ${financialYear}\nCompany: ${companyName}`;

                if (!window.confirm(message)) {
                    event.preventDefault();
                }
            });
        });
    })();

    (function () {
        const recordCheckboxes = Array.from(document.querySelectorAll('.survey-record-checkbox'));
        const toggleAllCheckbox = document.getElementById('toggleAllSurveyRows');
        const selectionButtons = Array.from(document.querySelectorAll('.survey-selection-btn'));
        const selectedCount = document.getElementById('selectedSurveyCount');
        const targetForms = [
            document.getElementById('populateSurveyLinksForm'),
            document.getElementById('populatePriorYearDataForm'),
            document.getElementById('copyContactDetailsForm')
        ].filter(Boolean);

        if (!recordCheckboxes.length) {
            return;
        }

        function syncSelectedRecordInputs() {
            const selectedIds = recordCheckboxes.filter(x => x.checked).map(x => x.value);

            targetForms.forEach(function (form) {
                const container = form.querySelector('.selected-record-inputs');
                if (!container) {
                    return;
                }

                container.innerHTML = '';
                selectedIds.forEach(function (id) {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'selectedRecordIds';
                    input.value = id;
                    container.appendChild(input);
                });
            });

            if (selectedCount) {
                selectedCount.textContent = selectedIds.length.toString();
            }

            if (toggleAllCheckbox) {
                toggleAllCheckbox.checked = selectedIds.length === recordCheckboxes.length;
                toggleAllCheckbox.indeterminate = selectedIds.length > 0 && selectedIds.length < recordCheckboxes.length;
            }

            return selectedIds.length;
        }

        function applySelection(mode) {
            recordCheckboxes.forEach(function (checkbox) {
                switch (mode) {
                    case 'all':
                        checkbox.checked = true;
                        break;
                    case 'none':
                        checkbox.checked = false;
                        break;
                    case 'without-link':
                        checkbox.checked = checkbox.getAttribute('data-has-link') !== 'true';
                        break;
                    case 'with-link':
                        checkbox.checked = checkbox.getAttribute('data-has-link') === 'true';
                        break;
                    case 'with-answers':
                        checkbox.checked = checkbox.getAttribute('data-has-answers') === 'true';
                        break;
                }
            });

            syncSelectedRecordInputs();
        }

        recordCheckboxes.forEach(function (checkbox) {
            checkbox.addEventListener('change', syncSelectedRecordInputs);
        });

        if (toggleAllCheckbox) {
            toggleAllCheckbox.addEventListener('change', function () {
                recordCheckboxes.forEach(function (checkbox) {
                    checkbox.checked = toggleAllCheckbox.checked;
                });
                syncSelectedRecordInputs();
            });
        }

        selectionButtons.forEach(function (button) {
            button.addEventListener('click', function () {
                applySelection(button.getAttribute('data-selection'));
            });
        });

        window.getSelectedSurveyCount = syncSelectedRecordInputs;
        syncSelectedRecordInputs();
    })();

    (function () {
        const copyForm = document.getElementById('copyContactDetailsForm');
        const copyButton = document.getElementById('copyContactDetailsBtn');

        if (!copyForm || !copyButton) {
            return;
        }

        copyForm.addEventListener('submit', function (event) {
            if (typeof window.getSelectedSurveyCount === 'function' && window.getSelectedSurveyCount() === 0) {
                event.preventDefault();
                alert('Select at least one survey record first.');
                return;
            }

            const confirmed = window.confirm('Copy Company contact details into the selected survey contact answers?');
            if (!confirmed) {
                event.preventDefault();
                return;
            }

            copyButton.disabled = true;
            copyButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Copying...';
        });
    })();

    function startEstimatedProgress(progressContainer, progressBar, progressText, actionLabel) {
        if (!progressContainer || !progressBar || !progressText) {
            return;
        }

        const selectedCount = typeof window.getSelectedSurveyCount === 'function'
            ? window.getSelectedSurveyCount()
            : 0;

        let percent = 0;
        const maxPercentBeforeComplete = 95;
        const estimatedDurationMs = Math.min(45000, Math.max(6000, (selectedCount || 1) * 140));
        const startedAt = Date.now();

        progressContainer.classList.remove('d-none');

        function renderProgress(currentPercent) {
            progressBar.style.width = currentPercent + '%';
            progressBar.textContent = currentPercent + '%';
            progressBar.setAttribute('aria-valuenow', currentPercent.toString());
            progressText.textContent = selectedCount > 0
                ? `${actionLabel} ${selectedCount} selected survey${selectedCount === 1 ? '' : 's'}... ${currentPercent}%`
                : `${actionLabel}... ${currentPercent}%`;
        }

        renderProgress(percent);

        const timer = window.setInterval(function () {
            const elapsed = Date.now() - startedAt;
            const nextPercent = Math.min(maxPercentBeforeComplete, Math.max(percent, Math.round((elapsed / estimatedDurationMs) * maxPercentBeforeComplete)));

            if (nextPercent !== percent) {
                percent = nextPercent;
                renderProgress(percent);
            }
        }, 250);

        window.addEventListener('beforeunload', function () {
            progressBar.style.width = '100%';
            progressBar.textContent = '100%';
            progressBar.setAttribute('aria-valuenow', '100');
        }, { once: true });

        return timer;
    }

    // Populate Survey Links Handler (inline preview + warning)
    (function () {
        const previewBtn = document.getElementById('previewBtn');
        const confirmBtn = document.getElementById('confirmPopulateBtn');
        const cancelBtn = document.getElementById('cancelPopulateBtn');
        const previewPanel = document.getElementById('populatePreviewPanel');
        const overwriteCheckbox = document.getElementById('overwriteExisting');
        const populateForm = document.getElementById('populateSurveyLinksForm');
        const progress = document.getElementById('populateProgress');
        const progressBar = document.getElementById('populateProgressBar');
        const progressText = document.getElementById('populateProgressText');
        const previewSummary = document.getElementById('previewSummaryInline');
        const previewWarning = document.getElementById('previewWarningInline');
        const previewCount = document.getElementById('previewCountInline');
        const previewTableBody = document.getElementById('previewTableBodyInline');

        if (!previewBtn || !populateForm || !confirmBtn || !cancelBtn || !previewPanel) return;

        previewBtn.addEventListener('click', async function (e) {
            e.preventDefault();
            const overwriteExisting = overwriteCheckbox && overwriteCheckbox.checked;

            if (typeof window.getSelectedSurveyCount === 'function' && window.getSelectedSurveyCount() === 0) {
                alert('Select at least one survey record first.');
                return;
            }

            previewBtn.disabled = true;
            previewBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Loading preview...';

            try {
                const formData = new FormData(populateForm);
                const response = await fetch(window.location.pathname + '?handler=PreviewPopulateSurveyLinks', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const data = await response.json();
                if (!data.success) {
                    alert('Error: ' + data.message);
                    return;
                }

                let summaryHtml = `<strong>${data.selectedRecords}</strong> selected survey records`;
                summaryHtml += `<br/>Will update: <strong class="text-success">${data.willUpdate}</strong> records`;
                if (data.willSkip > 0) {
                    summaryHtml += `<br/>Will skip: <strong class="text-muted">${data.willSkip}</strong> records (already have links)`;
                }
                if (data.expiryDisplay) {
                    summaryHtml += `<br/>Selected expiry: <strong>${data.expiryDisplay}</strong>`;
                }
                previewSummary.innerHTML = summaryHtml;

                if (overwriteExisting && data.existingCount > 0) {
                    previewWarning.innerHTML = `<div class="alert alert-warning mb-2" role="alert"><strong>Warning:</strong> Overwrite is enabled and <strong>${data.existingCount}</strong> existing links will be replaced.</div>`;
                } else {
                    previewWarning.innerHTML = '';
                }

                previewCount.textContent = `Showing ${data.totalPreviewShown} of ${data.totalRecords} records`;
                const previewRows = data.previewRows || [];
                const moreRows = data.moreRows || 0;

                previewTableBody.innerHTML = previewRows.map(row => `
                    <tr>
                        <td>${row.icon}</td>
                        <td>${escapeHtml(row.companyName)}</td>
                        <td><span class="${row.statusClass}">${row.status}</span></td>
                    </tr>
                `).join('');

                if (moreRows > 0) {
                    previewTableBody.innerHTML += `<tr><td colspan="3" class="text-muted text-center">... and ${moreRows} more</td></tr>`;
                }

                previewPanel.classList.remove('d-none');
                previewPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                setTimeout(() => confirmBtn.focus(), 200);
            } catch (error) {
                console.error('Error:', error);
                alert('Error loading preview: ' + error.message);
            } finally {
                previewBtn.disabled = false;
                previewBtn.innerHTML = 'Preview Populate Survey Links';
            }
        });

        confirmBtn.addEventListener('click', function () {
            if (typeof window.getSelectedSurveyCount === 'function' && window.getSelectedSurveyCount() === 0) {
                alert('Select at least one survey record first.');
                return;
            }

            confirmBtn.disabled = true;
            previewBtn.disabled = true;
            startEstimatedProgress(progress, progressBar, progressText, 'Populating survey links for');
            populateForm.submit();
        });

        cancelBtn.addEventListener('click', function () {
            previewPanel.classList.add('d-none');
            previewWarning.innerHTML = '';
            previewSummary.innerHTML = '';
            previewCount.textContent = '';
            previewTableBody.innerHTML = '';
        });
    })();

    // Historical Year Data preview handler
    (function () {
        const previewBtn = document.getElementById('previewPopulatePriorYearDataBtn');
        const confirmBtn = document.getElementById('confirmPopulatePriorYearDataBtn');
        const cancelBtn = document.getElementById('cancelPopulatePriorYearDataBtn');
        const previewPanel = document.getElementById('populatePriorYearPreviewPanel');
        const populateForm = document.getElementById('populatePriorYearDataForm');
        const progress = document.getElementById('populatePriorYearProgress');
        const progressBar = document.getElementById('populatePriorYearProgressBar');
        const progressText = document.getElementById('populatePriorYearProgressText');
        const previewSummary = document.getElementById('populatePriorYearSummaryInline');
        const previewCount = document.getElementById('populatePriorYearCountInline');
        const previewTableBody = document.getElementById('populatePriorYearTableBodyInline');

        if (!previewBtn || !confirmBtn || !cancelBtn || !previewPanel || !populateForm) return;

        previewBtn.addEventListener('click', async function (e) {
            e.preventDefault();

            if (typeof window.getSelectedSurveyCount === 'function' && window.getSelectedSurveyCount() === 0) {
                alert('Select at least one survey record first.');
                return;
            }

            previewBtn.disabled = true;
            previewBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Loading preview...';

            try {
                const formData = new FormData(populateForm);
                const response = await fetch(window.location.pathname + '?handler=PreviewPopulatePriorYearData', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const data = await response.json();
                if (!data.success) {
                    alert('Error: ' + data.message);
                    return;
                }

                let summaryHtml = `<strong>${data.selectedRecords}</strong> selected survey records`;
                summaryHtml += `<br/>Will fill blank answers: <strong class="text-success">${data.willUpdateFields}</strong>`;
                summaryHtml += `<br/>Companies affected: <strong>${data.affectedCompanies}</strong>`;
                summaryHtml += `<br/>Targets: <strong>${data.yearMinusTwo}</strong> (Year-2) and <strong>${data.yearMinusOne}</strong> (Year-1)`;
                if (data.existingValueCount > 0) {
                    summaryHtml += `<br/>Already populated: <strong class="text-muted">${data.existingValueCount}</strong>`;
                }
                if (data.missingSourceCount > 0) {
                    summaryHtml += `<br/>No source found: <strong class="text-warning">${data.missingSourceCount}</strong>`;
                }
                previewSummary.innerHTML = summaryHtml;

                const previewRows = data.previewRows || [];
                previewCount.textContent = `Showing ${data.totalPreviewShown} of ${data.totalRecords} records`;
                previewTableBody.innerHTML = previewRows.map(row => `
                    <tr>
                        <td>${row.icon}</td>
                        <td>${escapeHtml(row.companyName)}</td>
                        <td><span class="${row.statusClass}">${escapeHtml(row.status)}</span></td>
                        <td class="small text-muted">${escapeHtml(row.details || '')}</td>
                    </tr>
                `).join('');

                if (!previewRows.length) {
                    previewTableBody.innerHTML = '<tr><td colspan="4" class="text-muted text-center">No updates are required for the current filter.</td></tr>';
                } else if (data.moreRows > 0) {
                    previewTableBody.innerHTML += `<tr><td colspan="4" class="text-muted text-center">... and ${data.moreRows} more</td></tr>`;
                }

                previewPanel.classList.remove('d-none');
                previewPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                setTimeout(() => confirmBtn.focus(), 200);
            } catch (error) {
                console.error('Error:', error);
                alert('Error loading preview: ' + error.message);
            } finally {
                previewBtn.disabled = false;
                previewBtn.innerHTML = '@Model.PopulatePriorYearDataButtonLabel';
            }
        });

        confirmBtn.addEventListener('click', function () {
            if (typeof window.getSelectedSurveyCount === 'function' && window.getSelectedSurveyCount() === 0) {
                alert('Select at least one survey record first.');
                return;
            }

            confirmBtn.disabled = true;
            previewBtn.disabled = true;
            startEstimatedProgress(progress, progressBar, progressText, 'Populating historical year data for');
            populateForm.submit();
        });

        cancelBtn.addEventListener('click', function () {
            previewPanel.classList.add('d-none');
            previewSummary.innerHTML = '';
            previewCount.textContent = '';
            previewTableBody.innerHTML = '';
        });
    })();

    function escapeHtml(text) {
        if (!text) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return text.replace(/[&<>"']/g, m => map[m]);
    }
</script>

