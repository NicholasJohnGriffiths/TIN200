@page "{id:int}"
@model TINWeb.Pages.CompanySurvey.EditModel
@{
    ViewData["Title"] = "Edit Company Survey";
    var isSurveyEstimationsUser = TINWeb.Services.UserTypes.IsSurveyEstimations(User);
}

<div class="container mt-4">
    <h1>Edit Company Survey</h1>
    <hr />

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
    }

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Record.Id" />
        <input type="hidden" asp-for="FinancialYear" />

        <div class="form-group mb-3">
            <label class="form-label">Company Name</label>
            <input type="text" class="form-control" value="@Model.CompanyName" readonly />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Record.CompanyId" class="form-label"></label>
            <input asp-for="Record.CompanyId" class="form-control" readonly="@(isSurveyEstimationsUser ? "readonly" : null)" />
            <span asp-validation-for="Record.CompanyId" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Record.SurveyId" class="form-label"></label>
            <input asp-for="Record.SurveyId" class="form-control" readonly="@(isSurveyEstimationsUser ? "readonly" : null)" />
            <span asp-validation-for="Record.SurveyId" class="text-danger"></span>
        </div>

        <div class="form-check mb-2">
            <input asp-for="Record.Saved" class="form-check-input" disabled="@(isSurveyEstimationsUser ? "disabled" : null)" />
            <label asp-for="Record.Saved" class="form-check-label"></label>
        </div>

        <div class="form-check mb-2">
            <input asp-for="Record.Submitted" class="form-check-input" disabled="@(isSurveyEstimationsUser ? "disabled" : null)" />
            <label asp-for="Record.Submitted" class="form-check-label"></label>
        </div>

        <div class="form-check mb-3">
            <input asp-for="Record.Requested" class="form-check-input" disabled="@(isSurveyEstimationsUser ? "disabled" : null)" />
            <label asp-for="Record.Requested" class="form-check-label"></label>
        </div>

        <div class="form-check mb-3">
            <input type="checkbox"
                   class="form-check-input"
                   id="Record_Locked"
                   name="Record.Locked"
                   value="true"
                   checked="@(Model.Record.Locked == true ? "checked" : null)"
                   disabled="@(isSurveyEstimationsUser ? "disabled" : null)" />
            @if (!isSurveyEstimationsUser)
            {
                <input type="hidden" name="Record.Locked" value="false" />
            }
            <label class="form-check-label" for="Record_Locked">Locked</label>
        </div>

        <div class="form-check mb-3">
            <input type="checkbox"
                   class="form-check-input"
                   id="Record_Estimate"
                   name="Record.Estimate"
                   value="true"
                     checked="@(Model.Record.Estimate == true ? "checked" : null)" />
            <input type="hidden" name="Record.Estimate" value="false" />
            <label class="form-check-label" for="Record_Estimate">Estimate</label>
        </div>

        <div class="form-check mb-3">
            <input type="checkbox"
                   class="form-check-input"
                   id="Record_TIN200"
                   name="Record.TIN200"
                   value="true"
                   checked="@(Model.Record.TIN200 == true ? "checked" : null)"
                   disabled="@(isSurveyEstimationsUser ? "disabled" : null)" />
            @if (!isSurveyEstimationsUser)
            {
                <input type="hidden" name="Record.TIN200" value="false" />
            }
            <label class="form-check-label" for="Record_TIN200">TIN200</label>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Record.SurveyLink" class="form-label"></label>
            <input asp-for="Record.SurveyLink" class="form-control" readonly />
            @if (!isSurveyEstimationsUser)
            {
                <div class="row g-2 mt-2 align-items-end">
                    <div class="col-sm-6 col-md-4">
                        <label for="SelectedLinkExpiryDateUtc" class="form-label">Survey Link Expiry Date</label>
                        <input asp-for="SelectedLinkExpiryDateUtc" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                        <span asp-validation-for="SelectedLinkExpiryDateUtc" class="text-danger"></span>
                        <small class="text-muted">Choose the date above for when this survey link should expire.</small>
                    </div>
                </div>
            }
            <div class="d-flex flex-wrap gap-2 mt-2">
                @if (!isSurveyEstimationsUser)
                {
                    <button type="submit" asp-page-handler="RegenerateLink" formnovalidate class="btn btn-outline-primary">Regenerate Survey Link</button>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Record.SurveyLink))
                {
                    <a href="@Model.Record.SurveyLink" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary">Open Link</a>
                }
            </div>
            @if (Model.SurveyLinkExpiryUtc.HasValue)
            {
                <div class="small mt-2">
                    <span class="badge @(Model.IsSurveyLinkExpired ? "bg-danger" : "bg-success")">@(Model.IsSurveyLinkExpired ? "Expired" : "Valid")</span>
                    <span class="ms-2 text-muted">Expires: @Model.SurveyLinkExpiryUtc.Value.ToString("dd/MM/yyyy HH:mm 'UTC'")</span>
                </div>
            }
            @if (!isSurveyEstimationsUser)
            {
                <small class="text-muted d-block mt-1">The expiry is based on the date you select above. By default, we suggest a date using the current @Model.LinkExpiryDays day(s) (@Model.LinkExpiryHours hours) setting. If a newer link shows as invalid, the token signing secret may have changed.</small>
            }
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-page="./Index" asp-route-financialYear="@Model.FinancialYear" asp-fragment="record-@Model.Record.Id" class="btn btn-secondary">Back to List</a>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
