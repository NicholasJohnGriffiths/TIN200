@page "{id:int}"
@model TINWeb.Pages.AppUsers.DeleteModel
@{
    ViewData["Title"] = "Delete App User";
}

<div class="container mt-4">
    <h1>Delete App User</h1>
    <div class="alert alert-warning mt-3">Are you sure you want to delete this user?</div>

    <dl class="row mt-3">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Record.Name</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Record.Email</dd>

        <dt class="col-sm-3">Username</dt>
        <dd class="col-sm-9">@Model.Record.UserName</dd>

        <dt class="col-sm-3">User Type</dt>
        <dd class="col-sm-9">@(Model.Record.UserType == 1 ? "Admin" : $"UserType {Model.Record.UserType}")</dd>
    </dl>

    <form method="post" class="d-flex gap-2">
        <input type="hidden" asp-for="Record.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
