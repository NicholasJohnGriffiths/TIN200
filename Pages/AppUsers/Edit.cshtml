@page "{id:int}"
@model TINWeb.Pages.AppUsers.EditModel
@{
    ViewData["Title"] = "Edit App User";
}

<div class="container mt-4">
    <h1>Edit App User</h1>

    <form method="post" class="mt-3">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Record.Id" />

        <div class="mb-3">
            <label asp-for="Record.Name" class="form-label"></label>
            <input asp-for="Record.Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Record.Email" class="form-label"></label>
            <input asp-for="Record.Email" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Record.UserName" class="form-label">Username</label>
            <input asp-for="Record.UserName" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Record.Password" class="form-label"></label>
            <input asp-for="Record.Password" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Record.UserType" class="form-label">User Type</label>
            <select asp-for="Record.UserType" class="form-select">
                <option value="0">Standard User</option>
                <option value="1">Admin</option>
            </select>
        </div>

        <div class="mb-3 form-check">
            <input
                class="form-check-input"
                type="checkbox"
                id="Record_TransactionsVisible"
                name="Record.TransactionsVisible"
                value="true"
                @(Model.Record.TransactionsVisible == true ? "checked" : null) />
            <input type="hidden" name="Record.TransactionsVisible" value="false" />
            <label class="form-check-label" for="Record_TransactionsVisible">Transactions Visible</label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
