{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build TINWeb for debugging",
			"type": "process",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}\\TINWeb.csproj",
				"--configuration",
				"Debug"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Build and zip publish output",
			"type": "shell",
			"command": "dotnet publish .\\TINWeb.csproj -c Release -o ./publish; Compress-Archive -Path ./publish/* -DestinationPath ./publish.zip -Force"
		}
	]
}